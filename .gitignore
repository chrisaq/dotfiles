# ignore all by default to avoid tracking the entire homedir.
# requires -f when adding files
*

# Alternative, tracks entire $HOME, but hides it, does not require -f:
# dotfiles config --local status.showUntrackedFiles no
# dotlocal config --local status.showUntrackedFiles no

# Generated native password host wrapper; portable setup recipe is tracked.
/.config/gopass/gopass_wrapper.sh
