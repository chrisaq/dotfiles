## Global Configuration Options
max-history=100
sort=-time
layer=overlay
anchor=top-right


# Behavior & Timeouts
default-timeout=5000
ignore-timeout=0

# Pointer & Touch Bindings
on-button-left=dismiss
on-button-right=invoke-default-action
on-button-middle=none

# Style and Geometry
font=JetBrains Mono 10
border-size=2
border-radius=8
width=350
height=210
margin=20
padding=15

# Icons
icons=1
max-icon-size=64

## Catppuccin Macchiato Mako Palette
background-color=#24273a
text-color=#cad3f5
border-color=#b7bdf8
progress-color=over #363a4f

## Catppuccin Macchiato Mako Palette
[urgency=low]
background-color=#24273a
text-color=#cad3f5
border-color=#b7bdf8
default-timeout=10000

## Catppuccin Macchiato Mako Palette
