class PassTUI(App):
    TITLE = APP_NAME

    CSS = """
    Screen { background: $surface; }

    #top {
        dock: top; height: 1; padding: 0 1;
        background: $primary; color: $text;
    }
    #top .muted { color: $text; opacity: 0.75; }

    #filter-bar { height: 3; padding: 0 1; }
    #filter { width: 100%; }

    #main { height: 1fr; }

    #left {
        width: 38%; min-width: 28; max-width: 56;
        border: round $panel; margin: 0 1 0 0;
    }
    #right {
        width: 1fr;
        border: round $panel; padding: 0 1; overflow-y: auto;
    }

    #status {
        dock: bottom; height: 1; padding: 0 1;
        background: $panel; color: $text;
    }
    #status .ok { color: $success; }
    #status .warn { color: $warning; }
    #status .err { color: $error; }
    #status .muted { color: $text-muted; }

    #empty {
        width: 1fr; height: 1fr; content-align: center middle;
        color: $text-muted; text-style: italic;
    }

    Tree { height: 1fr; }
    """

    BINDINGS = [
        Binding("q", "quit", "Quit", priority=True),
        Binding("question_mark", "help", "Help", priority=True),
        Binding("slash", "focus_filter", "Filter", priority=True),
        Binding("ctrl_r", "rescan", "Rescan", priority=True),
        Binding("v", "toggle_reveal", "Reveal"),
        Binding("y", "copy_password", "Copy pass"),
        Binding("Y", "copy_username", "Copy user"),
        Binding("u", "copy_url", "Copy URL"),
        Binding("o", "open_url", "Open URL"),
        Binding("t", "totp", "TOTP"),
        Binding("n", "new_secret", "New"),
        Binding("d", "new_folder", "New dir"),
        Binding("e", "edit_secret", "Edit"),
        Binding("P", "generate", "Generate"),
        Binding("r", "rename_move", "Rename"),
        Binding("D", "delete_secret", "Delete"),
        Binding("enter", "open_entry", "Open"),
        # vi-style navigation (arrows are built into Tree already). These delegate
        # explicitly: an App-level binding cannot resolve Tree's own actions.
        Binding("j", "vi_down", show=False),
        Binding("k", "vi_up", show=False),
        Binding("h", "vi_left", show=False),
        Binding("l", "vi_right", show=False),
        # Tree only binds shift+left / shift+right; plain arrows are unbound.
        Binding("left", "vi_left", show=False),
        Binding("right", "vi_right", show=False),
    ]

    def __init__(
        self,
        store: Path,
        settings: Settings,
        templates: list[Template],
        initial_entry: Optional[str] = None,
    ) -> None:
        super().__init__()
        self.store = store
        self.settings = settings
        self.templates = templates
        self.initial_entry = initial_entry
        self.reveal = settings.reveal_by_default
        self.entries: list[str] = []
        self._tree_nodes: dict[str, TreeNode] = {}
        self._preview_target: Optional[str] = None
        self._preview_timer = None
        self._pending_g: float = 0.0
        self._clip_task: Optional[asyncio.Task] = None
        self._current: Optional[Secret] = None

    # -- layout ---------------------------------------------------------

    def compose(self) -> ComposeResult:
        yield Header(show_clock=False)
        with Vertical(id="top"):
            yield Label("", id="top-label")
        with Vertical(id="filter-bar"):
            yield Input(placeholder="Filter vault…  (Esc clears)", id="filter")
        with Horizontal(id="main"):
            with Vertical(id="left"):
                yield Tree("Vault", id="tree")
            with Vertical(id="right"):
                yield Static("", id="detail")
        with Vertical(id="status"):
            yield Label("", id="status-label")
        yield Footer()

    async def on_mount(self) -> None:
        self._paint_chrome()
        tree = self.query_one("#tree", Tree)
        tree.show_root = False
        tree.guide_depth = 2
        await self.rescan(select=self.initial_entry)
        self.query_one("#detail", Static).update(
            Text("Select an entry on the left.\n\nPress ? for keys.", style="dim italic")
        )
        # Action keys (y/e/n/D…) must land on the tree, not the filter Input.
        self.query_one("#tree", Tree).focus()

    # -- chrome ---------------------------------------------------------

    def _paint_chrome(self) -> None:
        reveal_txt = (
            Text("REVEALED", style="bold bright_white on dark_red")
            if self.reveal
            else Text("masked", style="dim")
        )
        self.query_one("#top-label", Label).update(
            Text.assemble(
                (f" {APP_NAME} ", "bold"),
                ("  store: ", "dim"),
                (str(self.store), "white"),
                ("   ", "dim"),
                reveal_txt,
            )
        )

    # Semantic status levels -> rich style strings (CSS class names are not rich styles).
    _STATUS_STYLE = {
        "ok": "bright_green",
        "warn": "bright_yellow",
        "err": "bright_red",
        "muted": "dim",
    }

    def _status(self, msg: str, cls: str = "muted") -> None:
        style = self._STATUS_STYLE.get(cls, "dim")
        self.query_one("#status-label", Label).update(
            Text.assemble((f" {msg}", style), ("   ? keys", "dim"))
        )

    # -- tree -----------------------------------------------------------

    def _build_tree(
        self,
        paths: Iterable[str],
        *,
        expand_matches: bool = False,
        folder_paths: Iterable[str] = (),
    ) -> None:
        tree = self.query_one("#tree", Tree)
        tree.clear()
        root = tree.root
        root.remove_children()
        nodes: dict[str, TreeNode] = {}

        for path in sorted(paths):
            parts = path.split("/")
            parent = root
            acc = ""
            for part in parts[:-1]:
                acc = f"{acc}/{part}" if acc else part
                node = nodes.get(acc)
                if node is None:
                    node = parent.add(part, data=None)
                    nodes[acc] = node
                parent = node
            parent.add_leaf(parts[-1], data=path)

        self._tree_nodes = nodes

        # Folder hits are shown collapsed with their real contents loaded but
        # hidden, so the user browses into them deliberately.
        folder_only_keys = set(folder_paths)
        for fp in sorted(folder_only_keys):
            if fp in nodes:
                continue
            parent = root
            acc = ""
            parts = fp.split("/")
            for j, part in enumerate(parts):
                acc = f"{acc}/{part}" if acc else part
                node = nodes.get(acc)
                if node is None:
                    # Only the matched folder itself gets the trailing '/' marker.
                    label = f"{part}/" if j == len(parts) - 1 else part
                    node = parent.add(label, data=None)
                    nodes[acc] = node
                parent = node

        if expand_matches:
            # Open every ancestor of a match so matched entries are actually
            # visible — but leave folder-only hits (and their subtrees) collapsed
            # so the user browses into them deliberately.
            for key, node in nodes.items():
                if key in folder_only_keys or any(
                    key.startswith(f + "/") for f in folder_only_keys
                ):
                    node.collapse()
                else:
                    node.expand()
        else:
            # Unfiltered view: everything collapsed for a calm starting point.
            for child in root.children:
                child.collapse()

    def _match(self, q: str) -> tuple[list[str], list[str]]:
        """Return (leaf_paths, folder_paths) for a filter query.

        Leaf hits match on the entry's own name. Folder hits match an ancestor
        folder's name and are returned collapsed so a folder query does not drag
        every sibling entry into the results.
        """
        if not q:
            return list(self.entries), []

        leaf_hits: list[tuple[float, str]] = []
        path_hits: list[tuple[float, str]] = []
        folder_hits: list[str] = []

        for p in self.entries:
            leaf = p.rsplit("/", 1)[-1] if "/" in p else p
            s_leaf = fuzzy_score(q, leaf)
            if s_leaf is not None:
                leaf_hits.append((s_leaf, p))
                continue
            if "/" in q:
                s_path = fuzzy_score(q, p)
                if s_path is not None:
                    path_hits.append((s_path - 0.1, p))
                    continue
            parts = p.split("/")[:-1]
            for i, part in enumerate(parts):
                if fuzzy_score(q, part) is not None:
                    folder_hits.append("/".join(parts[: i + 1]))
                    break

        merged = sorted(leaf_hits + path_hits, key=lambda x: -x[0])
        leaf_paths = [p for _, p in merged[:400]]

        # Skip folder hits whose contents are already shown via a leaf hit.
        folder_only = [
            f
            for f in sorted(set(folder_hits))
            if not any(lp.startswith(f + "/") for lp in leaf_paths)
        ]
        return leaf_paths, folder_only

    def filter_query(self) -> str:
        try:
            return self.query_one("#filter", Input).value.strip()
        except Exception:
            return ""

    async def rescan(self, select: Optional[str] = None) -> None:
        try:
            self.entries = await asyncio.to_thread(list_entries)
        except CqPassError as exc:
            self._status(f"rescan failed: {exc}", "err")
            return
        self._apply_filter()
        self._status(f"{len(self.entries)} entries", "ok")
        if select:
            self._select_path(select)

    def _apply_filter(self) -> None:
        q = self.filter_query()
        if not q:
            self._build_tree(self.entries)
            return

        leaf_paths, folder_paths = self._match(q)

        # A matched folder must still be browsable, so pull its real contents into
        # the tree too. They stay collapsed under the folder-only node until the
        # user expands it — otherwise searching "google" would hide the entry
        # named after the address behind it.
        contents = [
            e
            for e in self.entries
            if any(e.startswith(f + "/") for f in folder_paths)
            and not any(lp == e for lp in leaf_paths)
        ]
        paths = list(dict.fromkeys(leaf_paths + contents))

        self._build_tree(paths, expand_matches=True, folder_paths=folder_paths)

        if paths:
            extra = f" + {len(folder_paths)} folder(s)" if folder_paths else ""
            self._status(f"{len(leaf_paths)} match{extra}", "ok")
        else:
            self._status(f"no entries match {q!r}", "warn")

    def on_input_changed(self, event: Input.Changed) -> None:
        if event.input.id == "filter":
            self._apply_filter()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        if event.input.id == "filter":
            self.query_one("#tree", Tree).focus()

    # -- selection ------------------------------------------------------

    @on(Tree.NodeHighlighted, "#tree")
    def on_node_highlighted(self, event: Tree.NodeHighlighted) -> None:
        """Live-preview the entry under the cursor.

        Debounced so holding down j/k does not fire a gopass call per keystroke.
        """
        path = event.node.data
        if not path:
            return
        self._preview_target = path
        if self._preview_timer is not None:
            self._preview_timer.stop()
        self._preview_timer = self.set_timer(0.1, self._flush_preview)

    async def _flush_preview(self) -> None:
        self._preview_timer = None
        path = self._preview_target
        if not path or (self._current and self._current.path == path):
            return
        await self.load_detail(path)

    @on(Tree.NodeSelected, "#tree")
    async def on_node_selected(self, event: Tree.NodeSelected) -> None:
        path = event.node.data
        if not path:
            return
        await self.load_detail(path)

    def _select_path(self, path: str) -> None:
        tree = self.query_one("#tree", Tree)
        parts = path.split("/")
        parent = tree.root
        for part in parts[:-1]:
            found = None
            for child in parent.children:
                if str(child.label) == part:
                    found = child
                    break
            if found is None:
                return
            found.expand()
            parent = found
        for leaf in parent.children:
            if leaf.data == path:
                tree.select_node(leaf)
                tree.focus()
                asyncio.create_task(self.load_detail(path))
                return

    async def load_detail(self, path: str) -> None:
        detail = self.query_one("#detail", Static)
        detail.update(Text("loading…", style="dim"))
        try:
            secret = await asyncio.to_thread(read_secret, path)
        except CqPassError as exc:
            self._current = None
            detail.update(Text(f"Could not read {path}\n\n{exc}", style="red"))
            self._status("read failed", "err")
            return
        self._current = secret
        detail.update(secret_renderable(secret, self.reveal))
        self._status(path, "ok")

    def _require_entry(self) -> Optional[str]:
        if self._current is None:
            self._status("no entry selected", "warn")
            return None
        return self._current.path

    # -- clipboard ------------------------------------------------------

    async def _copy(self, text: str, label: str) -> None:
        if not text:
            self._status(f"no {label} on this entry", "warn")
            return
        try:
            await asyncio.to_thread(copy_text, text)
        except CqPassError as exc:
            self._status(str(exc), "err")
            return
        timeout = self.settings.clip_timeout
        if self._clip_task and not self._clip_task.done():
            self._clip_task.cancel()
        if timeout and timeout > 0:
            self._clip_task = asyncio.create_task(self._clear_clip(timeout))
            self._status(f"copied {label} — clears in {timeout}s", "ok")
        else:
            self._status(f"copied {label}", "ok")

    async def _clear_clip(self, seconds: int) -> None:
        try:
            await asyncio.sleep(seconds)
            await asyncio.to_thread(clear_clipboard)
            self._status("clipboard cleared", "muted")
        except asyncio.CancelledError:
            pass

    # -- actions --------------------------------------------------------

    def action_toggle_reveal(self) -> None:
        self.reveal = not self.reveal
        self._paint_chrome()
        if self._current:
            self.query_one("#detail", Static).update(secret_renderable(self._current, self.reveal))
        self._status(f"secrets {'revealed' if self.reveal else 'masked'}", "warn" if self.reveal else "ok")

    def action_copy_password(self) -> None:
        path = self._require_entry()
        if not path:
            return
        asyncio.create_task(self._copy(self._current.password, "password"))

    def action_copy_username(self) -> None:
        path = self._require_entry()
        if not path:
            return
        asyncio.create_task(self._copy(self._current.username or "", "username"))

    def action_copy_url(self) -> None:
        path = self._require_entry()
        if not path:
            return
        asyncio.create_task(self._copy(self._current.url or "", "url"))

    def action_open_url(self) -> None:
        path = self._require_entry()
        if not path:
            return
        url = self._current.url
        if not url:
            self._status("no URL on this entry", "warn")
            return
        if not url.startswith(("http://", "https://")):
            url = "https://" + url
        browser = self.settings.browser or os.environ.get("BROWSER")
        cmd = [browser, url] if browser else (["xdg-open", url] if shutil.which("xdg-open") else None)
        if cmd is None:
            self._status("no browser found (xdg-open / $BROWSER)", "warn")
            return
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self._status(f"opened {url}", "ok")

    @work(thread=False, exclusive=True)
    async def action_totp(self) -> None:
        path = self._require_entry()
        if not path:
            return

        async def run() -> None:
            try:
                out = await asyncio.to_thread(gopass, "otp", "--code", path)
            except CqPassError as exc:
                self._status(f"TOTP failed: {exc}", "err")
                return
            code = ""
            for line in out.splitlines():
                s = line.strip()
                if re.fullmatch(r"[0-9]{6,8}", s):
                    code = s
                    break
            if not code:
                self._status("no TOTP secret on this entry", "warn")
                return
            await self._copy(code, "TOTP code")
            if not self.reveal:
                self.reveal = True
                self._paint_chrome()
                if self._current:
                    self.query_one("#detail", Static).update(
                        secret_renderable(self._current, self.reveal)
                    )
            self.notify(f"TOTP {code}", title="One-time code", timeout=15)

        await run()

    # -- vi navigation ------------------------------------------------

    def _tree(self) -> Tree:
        return self.query_one("#tree", Tree)

    def action_vi_down(self) -> None:
        t = self._tree()
        t.focus()
        t.action_cursor_down()

    def action_vi_up(self) -> None:
        t = self._tree()
        t.focus()
        t.action_cursor_up()

    def action_vi_left(self) -> None:
        t = self._tree()
        t.focus()
        node = t.cursor_node
        if node is None:
            return
        if node.is_expanded:
            node.collapse()
        else:
            t.action_cursor_parent()

    def action_vi_right(self) -> None:
        t = self._tree()
        t.focus()
        node = t.cursor_node
        if node is not None and node.allow_expand:
            node.expand()

    def action_focus_filter(self) -> None:
        self.query_one("#filter", Input).focus()

    def action_help(self) -> None:
        self.push_screen(HelpScreen())

    def action_rescan(self) -> None:
        asyncio.create_task(self.rescan())

    # -- modify flows ---------------------------------------------------

    def _editor_command(self) -> Optional[list[str]]:
        editor = self.settings.editor or os.environ.get("EDITOR")
        if not editor:
            return None
        parts = editor.split()
        if not shutil.which(parts[0]):
            return None
        return parts

    async def _edit_content(self, path: str, initial: str, *, creating: bool) -> Optional[str]:
        """Open $EDITOR (or built-in) with `initial`; return new content or None."""
        with tempfile.NamedTemporaryFile(
            "w", suffix=".yaml", prefix="cq_pass_", delete=False
        ) as fh:
            fh.write(initial)
            tmp = Path(fh.name)
        try:
            cmd = self._editor_command()
            if cmd:
                with self.suspend():
                    subprocess.run([*cmd, str(tmp)], check=False)
                new = tmp.read_text()
            else:
                result = await self.push_screen_wait(EditorScreen(tmp.read_text(), title=path))
                new = result
        finally:
            try:
                tmp.unlink()
            except OSError:
                pass

        if new is None:
            return None
        if new == initial and not creating:
            return None
        return new

    @work(thread=False, exclusive=True)
    async def action_new_folder(self) -> None:
        """Create a folder in the vault.

        gopass has no `mkdir` — a directory only exists once something lives
        inside it, so we write a recognisable placeholder leaf to materialise it.
        Delete the placeholder to remove an empty folder again.
        """
        current = self._current.path if self._current else ""
        base = current.rsplit("/", 1)[0] + "/" if "/" in current else ""

        folder = await self.push_screen_wait(
            PromptScreen(
                "New folder",
                default=f"{base}new-folder",
                placeholder="Accounts/new-folder",
                help=f"under {base or '/'} · Enter to create · Esc to cancel",
            )
        )
        if folder is None:
            self._status("cancelled", "muted")
            return

        folder = folder.strip().strip("/")
        if not folder or "/" not in folder:
            self._status("folder needs at least one name", "err")
            return

        marker = f"{folder}/{FOLDER_MARKER}"
        content = (
            "placeholder\n"
            "---\n"
            f"folder: {folder}/\n"
            "comment: placeholder created by cq_pass-tui (delete to remove the folder)\n"
        )
        try:
            await asyncio.to_thread(write_secret, marker, content, self.settings.commit_message)
        except CqPassError as exc:
            self._status(f"could not create folder: {exc}", "err")
            return

        await self.rescan()
        self._select_path(marker)
        self._status(f"created {folder}/", "ok")

    @work(thread=False, exclusive=True)
    async def action_edit_secret(self) -> None:
        path = self._require_entry()
        if not path:
            return

        async def run() -> None:
            try:
                current = await asyncio.to_thread(read_secret, path)
            except CqPassError as exc:
                self._status(f"could not read: {exc}", "err")
                return
            new = await self._edit_content(path, current.raw, creating=False)
            if new is None:
                self._status("edit cancelled", "muted")
                return
            try:
                await asyncio.to_thread(write_secret, path, new, self.settings.commit_message)
            except CqPassError as exc:
                self._status(f"save failed: {exc}", "err")
                return
            self._status(f"saved {path}", "ok")
            self.notify(f"Saved {path}", timeout=5)
            await self.load_detail(path)

        await run()

    @work(thread=False, exclusive=True)
    async def action_new_secret(self) -> None:
        async def run() -> None:
            tpl = await self.push_screen_wait(TemplatePickerScreen(self.templates))
            if tpl is None:
                self._status("cancelled", "muted")
                return
            if "invalid" in tpl.name:
                self._status("that template failed to parse", "err")
                return

            values: dict[str, str] = {}
            for f in tpl.fields:
                val = await self.push_screen_wait(
                    PromptScreen(f.label, default=f.default, placeholder=f.name)
                )
                if val is None:
                    if f.required:
                        self._status("missing required field — cancelled", "warn")
                        return
                    val = f.default
                values[f.name] = val

            suggested = suggest_path(tpl, values)
            path = await self.push_screen_wait(
                PromptScreen(
                    "Vault path",
                    default=suggested,
                    placeholder="Accounts/example.com/user",
                    help="Enter to create · Esc to cancel",
                )
            )
            if not path:
                self._status("no path — cancelled", "warn")
                return
            path = path.strip().strip("/")
            if not path:
                self._status("invalid path", "warn")
                return

            # Ask for the secret itself: generated or typed.
            choice = await self.push_screen_wait(
                PromptScreen(
                    "Password",
                    default="generate:24",
                    placeholder="generate:<length>  or  literal:<password>",
                    help="'literal:foo' sets it directly; anything else is generated",
                )
            )
            if choice is None:
                self._status("cancelled", "muted")
                return

            try:
                password = self._parse_password_choice(choice, 24)
            except CqPassError as exc:
                self._status(f"password: {exc}", "err")
                return
            if not password:
                self._status("could not obtain a password", "err")
                return

            content = render_template(tpl, values, password)
            final = await self._edit_content(path, content, creating=True)
            if final is None:
                self._status("creation cancelled", "muted")
                return
            try:
                await asyncio.to_thread(write_secret, path, final, self.settings.commit_message)
            except CqPassError as exc:
                self._status(f"create failed: {exc}", "err")
                return
            self.notify(f"Created {path}", timeout=5)
            self._status(f"created {path}", "ok")
            await self.rescan(select=path)

        await run()

    @staticmethod
    def _parse_password_choice(choice: str, default_len: int) -> str:
        c = choice.strip()
        if c.lower().startswith("literal:"):
            literal = c[len("literal:") :]
            if not literal:
                raise CqPassError("empty password refused")
            return literal
        m = re.match(r"(?i)^generate:\s*(\d{4,128})$", c)
        length = int(m.group(1)) if m else default_len
        try:
            out = gopass("generate", "--print", "--force", f"__cq_pass_tui_tmp__/{length}", str(length))
        except CqPassError:
            out = ""
        # Fallback: local generation so the flow never dead-ends.
        if not out.strip():
            import secrets

            alpha = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789"
            out = "".join(secrets.choice(alpha) for _ in range(length))
        pw = out.strip().splitlines()[0]
        # Guard: never store a truncated/empty generator result. A silently short
        # password is worse than a failed operation.
        if len(pw) < 8:
            raise CqPassError(f"generated password looks invalid ({len(pw)} chars) — aborted")
        return pw

    @work(thread=False, exclusive=True)
    async def action_generate(self) -> None:
        path = self._require_entry()
        if not path:
            return

        async def run() -> None:
            choice = await self.push_screen_wait(
                PromptScreen(
                    "Generate new password",
                    default="24",
                    placeholder="<length>  or  symbols:<length>",
                    help="Enter to generate and replace the first line",
                )
            )
            if choice is None:
                return
            symbols = choice.strip().lower().startswith("symbols:")
            digits = re.sub(r"(?i)^symbols:\s*", "", choice.strip())
            length = int(digits) if digits.isdigit() and 4 <= int(digits) <= 128 else 24
            args = ["generate", "--force", "--print", path, str(length)]
            if symbols:
                args.insert(1, "--symbols")
            try:
                out = await asyncio.to_thread(gopass, *args)
            except CqPassError as exc:
                self._status(f"generate failed: {exc}", "err")
                return
            new_pw = out.strip().splitlines()[-1] if out.strip() else ""
            if len(new_pw) < 8:
                self._status(
                    f"generator returned an invalid password ({len(new_pw)} chars) — aborted", "err"
                )
                return
            try:
                current = await asyncio.to_thread(read_secret, path)
                rest = current.raw.split("\n", 1)
                new_raw = new_pw + ("\n" + rest[1] if len(rest) > 1 and rest[1].strip() else "\n")
                await asyncio.to_thread(write_secret, path, new_raw, self.settings.commit_message)
            except CqPassError as exc:
                self._status(f"save failed: {exc}", "err")
                return
            await self._copy(new_pw, "new password")
            self.notify(f"Regenerated password for {path}", timeout=5)
            await self.load_detail(path)

        await run()

    @work(thread=False, exclusive=True)
    async def action_rename_move(self) -> None:
        path = self._require_entry()
        if not path:
            return

        async def run() -> None:
            new = await self.push_screen_wait(
                PromptScreen("Move / rename", default=path, placeholder="new/vault/path")
            )
            if not new:
                return
            new = new.strip().strip("/")
            if new == path or not new:
                self._status("nothing to do", "muted")
                return
            try:
                await asyncio.to_thread(gopass, "move", "--force", path, new)
            except CqPassError as exc:
                self._status(f"move failed: {exc}", "err")
                return
            self.notify(f"Moved to {new}", timeout=5)
            self._status(f"moved → {new}", "ok")
            await self.rescan(select=new)

        await run()

    @work(thread=False, exclusive=True)
    async def action_delete_secret(self) -> None:
        path = self._require_entry()
        if not path:
            return

        async def run() -> None:
            ok = await self.push_screen_wait(
                ConfirmScreen("Delete secret", f"Permanently delete\n\n  {path}\n\nThis cannot be undone.")
            )
            if not ok:
                self._status("delete cancelled", "muted")
                return
            try:
                await asyncio.to_thread(gopass, "delete", "--force", path)
            except CqPassError as exc:
                self._status(f"delete failed: {exc}", "err")
                return
            self._current = None
            self.query_one("#detail", Static).update(Text("deleted", style="dim italic"))
            self.notify(f"Deleted {path}", severity="warning", timeout=5)
            await self.rescan()

        await run()

    # -- key handling for gg / Esc-in-filter ----------------------------

    async def on_key(self, event) -> None:
        # gg => top of the tree
        if event.key == "g":
            now = asyncio.get_event_loop().time()
            if now - self._pending_g < 0.8:
                tree = self.query_one("#tree", Tree)
                tree.move_cursor_to_line(0)
                self._pending_g = 0.0
                event.stop()
                event.prevent_default()
                return
            self._pending_g = now

        if event.key == "escape":
            filt = self.query_one("#filter", Input)
            if filt.has_focus and filt.value:
                filt.value = ""
                self._apply_filter()
                event.stop()
                event.prevent_default()
                return
            if filt.has_focus:
                self.query_one("#tree", Tree).focus()
                event.stop()
                event.prevent_default()
                return


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

cli = typer.Typer(
    help="Browse, create and edit gopass secrets in a modern TUI.",
    no_args_is_help=False,
    add_completion=False,
)


@cli.command()
def main(
    entry: Optional[str] = typer.Argument(None, help="Entry to open on start."),
    store: Optional[str] = typer.Option(None, "--store", "-s", help="Password store path."),
    reveal: bool = typer.Option(False, "--reveal", "-r", help="Show secrets unmasked."),
    templates_dir: Optional[str] = typer.Option(
        None, "--templates-dir", "-t", help="Override the template directory."
    ),
    no_editor: bool = typer.Option(
        False, "--builtin-editor", help="Ignore $EDITOR and use the built-in editor."
    ),
) -> None:
    """Launch the vault browser."""
    try:
        settings = Settings()
        if SETTINGS_FILE.exists():
            data = yaml.safe_load(SETTINGS_FILE.read_text()) or {}
            if isinstance(data, dict):
                settings = Settings.model_validate(data)
        if reveal:
            settings.reveal_by_default = True
        if no_editor:
            settings.editor = ""
        if templates_dir:
            global TEMPLATE_DIR
            TEMPLATE_DIR = Path(templates_dir).expanduser()

        resolved = resolve_store(store, settings)
        templates = load_templates()
    except CqPassError as exc:
        typer.secho(str(exc), fg=typer.colors.RED, err=True)
        raise typer.Exit(1)

    app = PassTUI(resolved, settings, templates, initial_entry=entry)
    app.run()


if __name__ == "__main__":
    cli()
