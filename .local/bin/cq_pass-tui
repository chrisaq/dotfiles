#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "typer==0.27.3",
#   "textual[syntax]==8.2.8",
#   "pydantic==2.14.1",
#   "pyyaml==6.0.3",
#   "rich==15.0.0",
# ]
# ///
#:usage: cq_pass-tui [ENTRY] [--store PATH] [--reveal]
#:no-args: true
#:desc: Browse, create, edit and manage gopass secrets in a modern TUI.

"""
cq_pass-tui — a modern TUI browser/manager for a gopass password store.

Design notes
------------
* All reads/writes shell out to `gopass` so encryption, git auto-commit, mounts
  and `fsck` behaviour stay consistent with the rest of the cq_pass toolset.
* Secret bodies in a real-world store are NOT valid YAML (a free-text title line
  followed by `key: value` pairs, unquoted colons, JSON fragments, ...). We never
  re-serialise. We render the raw text with a YAML lexer (pygments does not
  validate, so it still looks good) and parse *leniently* only to extract fields
  for copy/preview.
* The password (first line) and secret-looking fields are masked by default.
  Press `v` to reveal.
* Editing goes through $EDITOR when set, otherwise an in-memory built-in editor.
  Only external editing uses a private temporary file; saving uses gopass insert.
"""

from __future__ import annotations

import asyncio
import configparser
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import tempfile
import threading
import time
