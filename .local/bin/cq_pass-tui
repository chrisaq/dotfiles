    .hidden { display: none; }
    Tree { height: 1fr; }
    ModalScreen { background: $background 65%; }
    """

    BINDINGS = [Binding(key if key != "*" else "asterisk", name, title, show=False)
                for name, (title, key) in PASS_ACTIONS.items() if key] + [
        Binding("question_mark", "help", "Help", show=False),
        Binding("slash", "focus_filter", "Filter", show=False),
        Binding("ctrl+p", "command_palette", "Commands", priority=False, show=False),
        Binding("ctrl+q", "quit", "Quit", priority=False, show=False),
        Binding("j", "vi_down", show=False), Binding("k", "vi_up", show=False),
        Binding("h", "vi_left", show=False), Binding("l", "vi_right", show=False),
        Binding("left", "vi_left", show=False), Binding("right", "vi_right", show=False),
    ]

    def __init__(
        self,
        store: Path,
        settings: Settings,
        templates: list[Template],
        initial_entry: Optional[str] = None,
        backend: Optional[GopassClient] = None,
    ) -> None:
        super().__init__()
        self.store = store
        self.backend = backend or GopassClient(store)
        self.settings = settings
        self.templates = templates
        self.initial_entry = initial_entry
        self.reveal = settings.reveal_by_default
        self.entries: list[str] = []
        self.dirs: list[str] = []
        self._tree_nodes: dict[str, "TreeNode"] = {}
        self._preview_target: Optional[str] = None
        self._preview_timer = None
        self._pending_g: float = 0.0
        self._clip_task: Optional[asyncio.Task] = None
        self._current: Optional[Secret] = None
        self._expanded: set[str] = set()
        self._detail_seq: int = 0
        self._secret_cache: "OrderedDict[str, Secret]" = OrderedDict()
        self._filter_timer = None
        self._cache_times: dict[str, float] = {}
        self._current_loaded_at = 0.0
        self._mutation_busy = False
        self._preview_paused = False
        self._reveal_deadline = time.monotonic() + settings.reveal_timeout
        self._clip_fingerprint: Optional[bytes] = None
        self._clip_deadline = 0.0
        self._otp_deadline = 0.0
        self._view = "all"
        self._favorites: set[str] = set()
        self._recent: list[str] = []
        self._pane_mode = 0
        self._chrome_label: Optional[Label] = None
        self._status_label: Optional[Label] = None
        for name, palette in PALETTES.items():
            self.register_theme(Theme(name=name, primary=palette["blue"], secondary=palette["mauve"], accent=palette["mauve"],
                                      foreground=palette["text"], background=palette["base"], surface=palette["mantle"], panel=palette["surface"],
                                      success=palette["green"], warning=palette["yellow"], error=palette["red"], dark=name == "macchiato"))
        self.theme = settings.theme
        self.animation_level = "full" if settings.animation else "none"

    # -- layout ---------------------------------------------------------

    def compose(self) -> ComposeResult:
        with Horizontal(id="topbar"):
            yield Static("◈  PASSWORDS  /  workbench", id="brand")
            yield Button("☀ Latte" if self.theme == "macchiato" else "☾ Dark", id="theme-button")
        with Vertical(id="top"):
            yield Label("", id="top-label")
        with Horizontal(id="filter-bar"):
            yield Input(placeholder="/ Search names, folders or paths…", id="filter")
            yield Select([("All entries", "all"), ("Session favorites", "favorites"), ("Recent entries", "recent")],
                         value="all", allow_blank=False, id="view")
        with Horizontal(id="main"):
            with Vertical(id="left"):
                yield VaultTree("Vault", id="tree")
            with VerticalScroll(id="right", can_focus=True):
                yield Static("Choose an entry or browse a folder", id="detail-head", markup=False)
                yield Static("Select an entry on the left.\n\nPress F1 for the guide.", id="detail", markup=False)
        yield Static("", id="otp-state", markup=False)
        with Horizontal(id="quick-actions"):
            yield Button("y  Copy", id="quick-copy_password", variant="primary")
            yield Button("e  Edit", id="quick-edit_secret")
            yield Button("n  New", id="quick-new_secret")
            yield Button("Ctrl+L  Lock", id="quick-lock")
        with Vertical(id="status"):
            yield Label("Ready", id="status-label")
        yield Static("y password · Y user · F field · e/E edit · v reveal · Ctrl+P commands · F1 help", id="hints")

    async def on_mount(self) -> None:
        self._chrome_label = self.query_one("#top-label", Label)
        self._status_label = self.query_one("#status-label", Label)
        self._paint_chrome()
        tree = self.query_one("#tree", Tree)
        tree.show_root = False
        tree.guide_depth = 2
        self.query_one("#left").border_title = "Vault / entries"
        self.query_one("#right").border_title = "Secret preview"
        self.query_one("#right").border_subtitle = "v temporary reveal · F copy field · E built-in editor"
        self.set_interval(1, self.tick)
        await self.rescan(select=self.initial_entry)
        tree.focus()

    def check_action(self, action: str, parameters: tuple[object, ...]) -> bool | None:
        if action in PASS_ACTIONS or action in {"focus_filter", "vi_up", "vi_down", "vi_left", "vi_right"}:
            if isinstance(self.screen, ModalScreen):
                return False
            if isinstance(self.focused, (Input, TextArea, Select)) and action != "help":
                return False
        return True

    def dispatch(self, name: str) -> None:
        if name in PASS_ACTIONS:
            getattr(self, "action_" + name)()

    @on(Button.Pressed)
    def quick_action(self, event: Button.Pressed) -> None:
        if event.button.id == "theme-button":
            self.action_theme()
        elif event.button.id and event.button.id.startswith("quick-"):
            self.dispatch(event.button.id.removeprefix("quick-"))

    @on(Select.Changed, "#view")
    def view_changed(self, event: Select.Changed) -> None:
        if event.value is not Select.BLANK:
            self._view = str(event.value)
            self._apply_filter()

    def _paint_chrome(self) -> None:
        label = self._chrome_label
        if label is None or not label.is_mounted:
            return
        p = PALETTES[self.theme]
        state = f"REVEALED {max(0, int(self._reveal_deadline - time.monotonic()))}s" if self.reveal else "LOCKED" if self._preview_paused else "masked"
        text = Text(str(self.store), style=p["muted"])
        text.append(f"  ·  {len(self.entries)} entries  ·  ")
        text.append(state, style=p["yellow"] if self.reveal else p["green"])
        if self._clip_fingerprint and self._clip_deadline:
            text.append(f"  ·  clipboard {max(0, int(self._clip_deadline-time.monotonic()))}s", style=p["blue"])
        label.update(text)

    def _status(self, msg: str, cls: str = "muted") -> None:
        if self._status_label is not None and self._status_label.is_mounted:
            colour = PALETTES[self.theme][{"ok": "green", "warn": "yellow", "err": "red"}.get(cls, "muted")]
            self._status_label.update(Text(msg, style=colour))

    def tick(self) -> None:
        now = time.monotonic()
        if self.reveal and now >= self._reveal_deadline:
            self.reveal = False
            self._render_current()
        for path, loaded in list(self._cache_times.items()):
            if now-loaded >= self.settings.cache_ttl:
                self._secret_cache.pop(path, None)
                self._cache_times.pop(path, None)
        if self._current and self.settings.cache_ttl and now-self._current_loaded_at >= self.settings.cache_ttl:
            self.action_lock()
            self._status("Preview expired · Enter to load again")
        self._paint_chrome()
        if self._otp_deadline:
            remaining = max(0, int(self._otp_deadline-time.time()))
            self.query_one("#otp-state", Static).update(f"TOTP copied · {remaining}s until rotation" if remaining else "TOTP expired · t copies the current code")

    def _cached_secret(self, path: str) -> Optional[Secret]:
        if not self.settings.cache_ttl or time.monotonic()-self._cache_times.get(path, 0) >= self.settings.cache_ttl:
            self._secret_cache.pop(path, None)
            self._cache_times.pop(path, None)
            return None
        return self._secret_cache.get(path)

    def _remember_secret(self, secret: Secret) -> None:
        if not self.settings.cache_ttl:
            return
        self._secret_cache[secret.path] = secret
        self._cache_times[secret.path] = time.monotonic()
        self._secret_cache.move_to_end(secret.path)
        while len(self._secret_cache) > 16:
            key, _ = self._secret_cache.popitem(last=False)
            self._cache_times.pop(key, None)

    def _render_current(self) -> None:
        if self._current:
            self.query_one("#detail", Static).update(secret_renderable(self._current, self.reveal, self.theme))
            self.query_one("#detail-head", Static).update(self._current.path + (" · temporarily revealed" if self.reveal else " · masked"))

    def action_theme(self) -> None:
        self.theme = "latte" if self.theme == "macchiato" else "macchiato"
        self.query_one("#theme-button", Button).label = "☀ Latte" if self.theme == "macchiato" else "☾ Dark"
        self._paint_chrome()
        self._render_current()
        self._status(f"Catppuccin {self.theme.title()} · Save preferences to keep this theme", "ok")

    def action_panes(self) -> None:
        self._pane_mode = (self._pane_mode+1) % 3
        self.query_one("#left").set_class(self._pane_mode == 2, "hidden")
        self.query_one("#right").set_class(self._pane_mode == 1, "hidden")
        self.query_one("#left").styles.width = "1fr" if self._pane_mode == 1 else "36%"

    def action_favorite(self) -> None:
        path = self._target_path()
        if path:
            if path in self._favorites:
                self._favorites.remove(path)
            else:
                self._favorites.add(path)
            self._apply_filter()
            self._select_path(path)
            self._status("Session favorite updated", "ok")

    def action_lock(self) -> None:
        self.reveal = False
        self._preview_paused = True
        self._detail_seq += 1
        self._preview_target = None
        if self._preview_timer:
            self._preview_timer.stop()
        self._current = None
        self._secret_cache.clear()
        self._cache_times.clear()
        self.query_one("#detail", Static).update(Text("Locked · cached plaintext forgotten\n\nEnter explicitly opens the selected entry."))
        self.query_one("#detail-head", Static).update("Preview locked")
        self._paint_chrome()

    def on_app_blur(self) -> None:
        if self.settings.mask_on_blur and self._chrome_label is not None:
            self.action_lock()

    def _browse_entries(self) -> list[str]:
        if self._view == "favorites":
            return [path for path in self.entries if path in self._favorites]
        if self._view == "recent":
            return [path for path in reversed(self._recent) if path in self.entries]
        return self.entries

    # -- tree -----------------------------------------------------------

    def _build_tree(
        self,
        paths: Iterable[str],
        *,
        expand_matches: bool = False,
        folder_paths: Iterable[str] = (),
    ) -> None:
        tree = self.query_one("#tree", Tree)
        tree.clear()
        root = tree.root
        nodes: dict[str, "TreeNode"] = {}

        for path in sorted(paths):
            parts = path.split("/")
            parent = root
            acc = ""
            for part in parts[:-1]:
                acc = f"{acc}/{part}" if acc else part
                node = nodes.get(acc)
                if node is None:
                    node = parent.add(part, data=None)
                    nodes[acc] = node
                parent = node
            parent.add_leaf(Text(("★ " if path in self._favorites else "") + parts[-1]), data=path)

        self._tree_nodes = nodes

        # Folder hits are shown collapsed with their real contents loaded but
        # hidden, so the user browses into them deliberately.
        folder_only_keys = set(folder_paths)
        for fp in sorted(folder_only_keys):
            if fp in nodes:
                continue
            parent = root
            acc = ""
            parts = fp.split("/")
            for j, part in enumerate(parts):
                acc = f"{acc}/{part}" if acc else part
                node = nodes.get(acc)
                if node is None:
                    # Only the matched folder itself gets the trailing '/' marker.
                    label = f"{part}/" if j == len(parts) - 1 else part
                    node = parent.add(label, data=None)
                    nodes[acc] = node
                parent = node

        if expand_matches:
            # Open every ancestor of a match so matched entries are actually
            # visible — but leave folder-only hits (and their subtrees) collapsed
            # so the user browses into them deliberately.
            for key, node in nodes.items():
                if key in folder_only_keys or any(
                    key.startswith(f + "/") for f in folder_only_keys
                ):
                    node.collapse()
                else:
                    node.expand()
        else:
            # Unfiltered view: restore the folders the user had open (everything
            # starts collapsed on the first build).
            for key, node in nodes.items():
                if key in self._expanded:
                    node.expand()
                else:
                    node.collapse()

    def _match(self, q: str) -> tuple[list[str], list[str]]:
        """Return (leaf_paths, folder_paths) for a filter query.

        Leaf hits match on the entry's own name. Folder hits match an ancestor
        folder's name and are returned collapsed so a folder query does not drag
        every sibling entry into the results.
        """
        if not q:
            return list(self._browse_entries()), []

        leaf_hits: list[tuple[float, str]] = []
        path_hits: list[tuple[float, str]] = []
        folder_hits: list[str] = []

        for p in self._browse_entries():
            leaf = p.rsplit("/", 1)[-1] if "/" in p else p
            s_leaf = fuzzy_score(q, leaf)
            if s_leaf is not None:
                leaf_hits.append((s_leaf, p))
                continue
            if "/" in q:
                s_path = fuzzy_score(q, p)
                if s_path is not None:
                    path_hits.append((s_path - 0.1, p))
                    continue
            parts = p.split("/")[:-1]
            for i, part in enumerate(parts):
                if fuzzy_score(q, part) is not None:
                    folder_hits.append("/".join(parts[: i + 1]))
                    break

        # Empty folders (created via mkdir) have no leaf to match on.
        for d in self.dirs if self._view == "all" else []:
            if fuzzy_score(q, d.rsplit("/", 1)[-1]) is not None or fuzzy_score(q, d) is not None:
                folder_hits.append(d)

        merged = sorted(leaf_hits + path_hits, key=lambda x: -x[0])
        leaf_paths = [p for _, p in merged[:400]]

        # Skip folder hits whose contents are already shown via a leaf hit.
        folder_only = [
            f
            for f in sorted(set(folder_hits))
            if not any(lp.startswith(f + "/") for lp in leaf_paths)
        ]
        return leaf_paths, folder_only

    def filter_query(self) -> str:
        try:
            return self.query_one("#filter", Input).value.strip()
        except Exception:
            return ""

    async def rescan(self, select: Optional[str] = None) -> None:
        try:
            entries, dirs = await asyncio.gather(
                asyncio.to_thread(self.backend.entries),
                asyncio.to_thread(list_dirs, self.store),
            )
        except CqPassError as exc:
            self._status(f"rescan failed: {exc}", "err")
            return
        # Legacy `.folder` placeholder leaves (older versions had no mkdir):
        # hide the leaf but keep its directory visible as a folder.
        suffix = f"/{FOLDER_MARKER}"
        legacy_dirs = {e[: -len(suffix)] for e in entries if e.endswith(suffix)}
        self.entries = [e for e in entries if not e.endswith(suffix)]
        self.dirs = sorted(set(dirs) | legacy_dirs)
        # Remember which folders were open so rebuilds don't collapse the tree.
        if not self.filter_query():
            self._expanded = {p for p, n in self._tree_nodes.items() if n.is_expanded}
        self._apply_filter()
        self._status(f"{len(self.entries)} entries", "ok")
        self._paint_chrome()
        if select:
            self._select_path(select)

    def _apply_filter(self) -> None:
        q = self.filter_query()
        if not q:
            self._build_tree(self._browse_entries(), folder_paths=self.dirs if self._view == "all" else [])
            return

        leaf_paths, folder_paths = self._match(q)

        # A matched folder must still be browsable, so pull its real contents into
        # the tree too. They stay collapsed under the folder-only node until the
        # user expands it — otherwise searching "google" would hide the entry
        # named after the address behind it.
        contents = [
            e
            for e in self._browse_entries()
            if any(e.startswith(f + "/") for f in folder_paths)
            and not any(lp == e for lp in leaf_paths)
        ]
        paths = list(dict.fromkeys(leaf_paths + contents))

        self._build_tree(paths, expand_matches=True, folder_paths=folder_paths)

        if paths:
            extra = f" + {len(folder_paths)} folder(s)" if folder_paths else ""
            self._status(f"{len(leaf_paths)} match{extra}", "ok")
        else:
            self._status(f"no entries match {q!r}", "warn")

    def on_input_changed(self, event: Input.Changed) -> None:
        if event.input.id == "filter":
            # Debounced like the preview: rebuilding the whole tree per keystroke
            # is expensive on large stores.
            if self._filter_timer is not None:
                self._filter_timer.stop()
            self._filter_timer = self.set_timer(0.1, self._apply_filter)

    def on_input_submitted(self, event: Input.Submitted) -> None:
        if event.input.id == "filter":
            self.query_one("#tree", Tree).focus()

    # -- selection ------------------------------------------------------

    @on(Tree.NodeHighlighted, "#tree")
    def on_node_highlighted(self, event: Tree.NodeHighlighted) -> None:
        """Live-preview the entry under the cursor.

        Each preview is a full gopass decryption, so the delay is generous and
        the timer keeps resetting while j/k is held: entries that are only
        passed over are never decrypted.
        """
        path = event.node.data
        if self._current is not None and self._current.path != path:
            self.reveal = False
            self._current = None
        self._detail_seq += 1
        if self._preview_timer:
            self._preview_timer.stop()
        if not path:
            self._preview_target = None
            self._otp_deadline = 0
            folder = self._node_dir(event.node)
            children = [str(child.label) + ("/" if child.allow_expand else "") for child in event.node.children]
            self.query_one("#detail-head", Static).update((folder or "Vault") + " / folder")
            self.query_one("#detail", Static).update(Text("\n".join(children) or "Empty directory"))
            self._paint_chrome()
            return
        if self._preview_paused:
            return
        self._preview_target = path
        if self._preview_timer is not None:
            self._preview_timer.stop()
        self._preview_timer = self.set_timer(0.5, self._flush_preview)

    async def _flush_preview(self) -> None:
        self._preview_timer = None
        path = self._preview_target
        if self._preview_paused or not path or path != self._cursor_leaf() or (self._current and self._current.path == path):
            return
        await self.load_detail(path)

    @on(Tree.NodeSelected, "#tree")
    async def on_node_selected(self, event: Tree.NodeSelected) -> None:
        path = event.node.data
        if not path:
            return
        self._preview_paused = False
        await self.load_detail(path)

    def _select_path(self, path: str) -> None:
        """Select an entry by exact path; fall back to a confident fuzzy match
        (used by the CLI `entry` argument)."""
        tree = self.query_one("#tree", Tree)
        if self._select_in_tree(tree, path):
            return
        if self.filter_query():
            return
        scored = sorted(
            ((s, p) for p in self.entries if (s := fuzzy_score(path, p)) is not None),
            key=lambda x: -x[0],
        )
        if not scored:
            return
        best_score, best = scored[0]
        if best_score < max(8.0, len(path)):
            return
        if len(scored) > 1 and scored[1][0] > best_score * 0.8:
            return  # ambiguous — don't guess
        if self._select_in_tree(tree, best):
            self._status(f"matched {best!r} (fuzzy)", "ok")

    def _select_in_tree(self, tree: Tree, path: str) -> bool:
        parts = path.split("/")
        parent = tree.root
        for part in parts[:-1]:
            found = None
            for child in parent.children:
                if str(child.label).rstrip("/") == part:
                    found = child
                    break
            if found is None:
                return False
            found.expand()
            parent = found
        # Rebuild the line cache after the expansions: move_cursor reads
        # node._line, which is stale until the tree rebuilds its lines.
        _ = tree._tree_lines
        for leaf in parent.children:
            if leaf.data == path:
                tree.select_node(leaf)
                tree.focus()
                return True
        return False

    def _node_dir(self, node) -> str:
        """Full path of a folder node (labels may carry a trailing '/')."""
        parts: list[str] = []
        n = node
        tree = self.query_one("#tree", Tree)
        while n is not None and n is not tree.root:
            parts.append(str(n.label).rstrip("/"))
            n = n.parent
        return "/".join(reversed(parts))

    def _cursor_dir(self) -> str:
        """Directory the tree cursor is on.

        Folder node -> that folder; leaf entry -> its parent directory.
        Falls back to the last previewed entry when the cursor is on the root.
        """
        try:
            tree = self.query_one("#tree", Tree)
            node = tree.get_node_at_line(tree.cursor_line) if tree.cursor_line >= 0 else None
        except Exception:
            node = None
        if node is None or node is tree.root:
            cur = self._current.path if self._current else ""
            return cur.rsplit("/", 1)[0] if "/" in cur else ""
        if isinstance(node.data, str):  # leaf entry
            return node.data.rsplit("/", 1)[0] if "/" in node.data else ""
        return self._node_dir(node)

    def _reveal_dir(self, path: str) -> bool:
        """Expand every ancestor of a folder plus the folder itself, then put
        the cursor on it."""
        tree = self.query_one("#tree", Tree)
        parent = tree.root
        node = None
        for part in path.split("/"):
            found = None
            for child in parent.children:
                if str(child.label).rstrip("/") == part:
                    found = child
                    break
            if found is None:
                return False
            found.expand()
            self._expanded.add(self._node_dir(found))
            node = parent = found
        if node is not None:
            # move_cursor (not select_node) — select_node would post NodeSelected,
            # and the tree's auto_expand would *toggle* the node back closed.
            # Touch _tree_lines so the line cache (and node._line) is rebuilt
            # after the expansions above; then move the cursor onto the folder.
            try:
                lines = tree._tree_lines
                for i, tl in enumerate(lines):
                    if tl.node is node:
                        tree.move_cursor_to_line(i)
                        break
            except Exception:
                tree.move_cursor(node)
            tree.focus()
        return node is not None

    async def load_detail(self, path: str) -> None:
        # Request sequence guard: rapid j/k over a slow (gpg-decryption) store
        # can resolve out of order; a stale result must not clobber a newer one.
        seq = self._detail_seq
        self._detail_seq += 1
        if self._current is None or self._current.path != path:
            self.reveal = self.settings.reveal_by_default
            self._reveal_deadline = time.monotonic() + self.settings.reveal_timeout
        detail = self.query_one("#detail", Static)
        cached = self._cached_secret(path)
        if cached is not None:
            # Already decrypted this session: show it without another gopass call.
            self._current = cached
            self._current_loaded_at = self._cache_times[path]
            self._secret_cache.move_to_end(path)
            self._render_current()
            self._status(path, "ok")
            return
        detail.update(Text("loading…", style="dim"))
        try:
            secret = await asyncio.to_thread(self.backend.read, path)
        except CqPassError as exc:
            if self._detail_seq == seq + 1:  # still the newest request
                self._current = None
                detail.update(Text(f"Could not read {path}\n\n{exc}", style="red"))
                self._status("read failed", "err")
            return
        if self._detail_seq != seq + 1:
            return  # a newer request started while we were reading
        self._current = secret
        self._current_loaded_at = time.monotonic()
        self._remember_secret(secret)
        if path in self._recent:
            self._recent.remove(path)
        self._recent.append(path)
        self._recent = self._recent[-50:]
        self._render_current()
        if self.settings.animation:
            detail.styles.opacity = 0.6
            detail.styles.animate("opacity", 1.0, duration=0.15)
        self._paint_chrome()
        self._status(path, "ok")

    def _cursor_leaf(self) -> Optional[str]:
        """Path of the leaf under the tree cursor, if any."""
        try:
            tree = self.query_one("#tree", Tree)
            node = tree.get_node_at_line(tree.cursor_line) if tree.cursor_line >= 0 else None
        except Exception:
            node = None
        if node is not None and node is not tree.root and isinstance(node.data, str):
            return node.data
        return None

    def _target_path(self) -> Optional[str]:
        """Entry an action targets: the leaf under the cursor when there is one,
        else the last previewed/selected entry."""
        leaf = self._cursor_leaf()
        if leaf is not None:
            return leaf
        self._status("Select an entry, rather than a folder", "warn")
        return None

    async def _ensure_entry(self, path: str) -> Optional[Secret]:
        """Make sure `path` is the loaded entry (awaiting a slow read if needed).

        A concurrent preview (fast j/k) can start a newer load while ours is in
        flight, which the seq guard then discards. Retry a couple of times so
        an action never operates on a different entry than the one it targeted.
        """
        cached = self._cached_secret(path)
        if cached is not None:
            return cached
        try:
            secret = await asyncio.to_thread(self.backend.read, path)
            self._remember_secret(secret)
            return secret
        except CqPassError as error:
            self._status(str(error), "err")
            return None

    # -- clipboard ------------------------------------------------------

    async def _copy(self, text: str, label: str) -> None:
        if not text:
            self._status(f"no {label} on this entry", "warn")
            return
        try:
            await asyncio.to_thread(copy_text, text)
        except CqPassError as exc:
            self._status(str(exc), "err")
            return
        timeout = self.settings.clip_timeout
        self._clip_fingerprint = hashlib.sha256(text.encode()).digest()
        self._clip_deadline = time.monotonic() + timeout if timeout else 0
        if self._clip_task and not self._clip_task.done():
            self._clip_task.cancel()
        if timeout and timeout > 0:
            self._clip_task = asyncio.create_task(self._clear_clip(timeout, self._clip_fingerprint))
            self._status(f"copied {label} — clears in {timeout}s", "ok")
        else:
            self._status(f"copied {label}", "ok")

    async def _clear_clip(self, seconds: int, fingerprint: bytes) -> None:
        try:
            await asyncio.sleep(seconds)
            matches = await asyncio.to_thread(clipboard_matches, fingerprint)
            if self._clip_fingerprint == fingerprint:
                if matches:
                    await asyncio.to_thread(clear_clipboard)
                    self._status("clipboard cleared", "muted")
                self._clip_fingerprint = None
                self._clip_deadline = 0
        except asyncio.CancelledError:
            pass

    @work(group="copy-fields")
    async def action_copy_field(self) -> None:
        path = self._target_path()
        if path is None:
            return
        secret = await self._ensure_entry(path)
        if secret is None:
            return
        fields = [("Password", secret.password)]
        for doc in secret.docs:
            for field in doc.fields:
                fields.append((f"Document {doc.index + 1} / {field.key}", field.value))
        index = await self.push_screen_wait(FieldPickerScreen(fields))
        if index is not None:
            await self._copy(fields[index][1], "field")

    def action_edit_builtin(self) -> None:
        self.action_edit_secret(builtin=True)

    @work(group="preferences")
    async def action_save_preferences(self) -> None:
        if not await self.push_screen_wait(ConfirmScreen("Save preferences?", f"Save the current theme and settings to {SETTINGS_FILE}?\nThe previous file will be backed up.", danger=False)):
            return
        try:
            current = yaml.safe_load(SETTINGS_FILE.read_text()) if SETTINGS_FILE.exists() else {}
            if not isinstance(current, dict):
                raise CqPassError("Existing settings are not a mapping")
            self.settings.theme = self.theme
            data = {**current, **self.settings.model_dump(exclude_none=True)}
            SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)
            if SETTINGS_FILE.exists():
                backup = SETTINGS_FILE.with_name(SETTINGS_FILE.name + f".backup-{time.time_ns()}")
                shutil.copyfile(SETTINGS_FILE, backup)
                backup.chmod(0o600)
            fd, name = tempfile.mkstemp(prefix=".settings-", dir=SETTINGS_FILE.parent)
            try:
                with os.fdopen(fd, "w") as stream:
                    stream.write("# cq_pass-tui preferences\n" + yaml.safe_dump(data, sort_keys=False))
                os.replace(name, SETTINGS_FILE)
            finally:
                Path(name).unlink(missing_ok=True)
            self._status("Preferences saved", "ok")
        except (OSError, CqPassError, yaml.YAMLError):
            self._status("Could not save preferences", "err")

    @work(group="quit")
    async def action_quit(self) -> None:
        if self._mutation_busy:
            self._status("Finish or cancel the current change before quitting", "warn")
            return
        if self._clip_task:
            self._clip_task.cancel()
        if self._clip_fingerprint and await asyncio.to_thread(clipboard_matches, self._clip_fingerprint):
            await asyncio.to_thread(clear_clipboard)
        self._clip_fingerprint = None
        self.exit()

    async def on_unmount(self) -> None:
        self._detail_seq += 1
        self._current = None
        self._secret_cache.clear()
        self._cache_times.clear()
        if self._clip_task:
            self._clip_task.cancel()
        if self._clip_fingerprint and await asyncio.to_thread(clipboard_matches, self._clip_fingerprint):
            await asyncio.to_thread(clear_clipboard)
        self.backend.close()

    # -- actions --------------------------------------------------------

    def action_toggle_reveal(self) -> None:
        path = self._target_path()
        if path:
            self.reveal_entry(path)

    @work(group="reveal", exclusive=True)
    async def reveal_entry(self, path: str) -> None:
        if self._current is None or self._current.path != path:
            self._preview_paused = False
            await self.load_detail(path)
        if self._current is not None and self._current.path == path and self._cursor_leaf() == path:
            self.reveal = not self.reveal
            self._reveal_deadline = time.monotonic() + self.settings.reveal_timeout
            self._render_current()
            self._paint_chrome()

    def action_copy_password(self) -> None:
        path = self._target_path()
        if not path:
            return

        async def run() -> None:
            secret = await self._ensure_entry(path)
            if secret is None:
                return
            await self._copy(secret.password, "password")

        self.run_worker(run(), group="entry-actions")

    def action_copy_username(self) -> None:
        path = self._target_path()
        if not path:
            return

        async def run() -> None:
            secret = await self._ensure_entry(path)
            if secret is None:
                return
            await self._copy(secret.username or "", "username")

        self.run_worker(run(), group="entry-actions")

    def action_copy_url(self) -> None:
        path = self._target_path()
        if not path:
            return

        async def run() -> None:
            secret = await self._ensure_entry(path)
            if secret is None:
                return
            await self._copy(secret.url or "", "url")

        self.run_worker(run(), group="entry-actions")

    def action_open_url(self) -> None:
        path = self._target_path()
        if not path:
            return

        async def run() -> None:
            secret = await self._ensure_entry(path)
            if secret is None:
                return
            url = secret.url
            if not url:
                self._status("no URL on this entry", "warn")
                return
            if not url.startswith(("http://", "https://")):
                url = "https://" + url
            browser = self.settings.browser or os.environ.get("BROWSER")
            cmd = (
                shlex.split(browser) + [url]
                if browser
                else (["xdg-open", url] if shutil.which("xdg-open") else None)
            )
            if cmd is None:
                self._status("no browser found (xdg-open / $BROWSER)", "warn")
                return
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self._status(f"opened {url}", "ok")

        self.run_worker(run(), group="entry-actions")

    @work(thread=False, exclusive=True)
    async def action_totp(self) -> None:
        path = self._target_path()
        if not path:
            return

        async def run() -> None:
            try:
                out = await asyncio.to_thread(self.backend.run, "otp", "--password", path)
            except CqPassError as exc:
                self._status(f"TOTP failed: {exc}", "err")
                return
            code = ""
            for line in out.splitlines():
                s = line.strip()
                if re.fullmatch(r"[0-9]{6,8}", s):
                    code = s
                    break
            if not code:
                self._status("no TOTP secret on this entry", "warn")
                return
            await self._copy(code, "TOTP code")
            # The code is shown in the notification and copied — no need to
            # un-mask the whole vault for it.
            secret = await self._ensure_entry(path)
            period = 30
            raw = secret.raw if secret else ""
            if "otpauth://hotp/" not in raw:
                match = re.search(r"[?&]period=(\d+)", raw)
                if match:
                    period = max(1, int(match[1]))
                self._otp_deadline = (int(time.time()) // period + 1) * period
            self.notify("One-time code copied", title="OTP", timeout=3)

        await run()

    # -- vi navigation ------------------------------------------------

    def _tree(self) -> Tree:
        return self.query_one("#tree", Tree)

    def action_vi_down(self) -> None:
        t = self._tree()
        t.focus()
        t.action_cursor_down()

    def action_vi_up(self) -> None:
        t = self._tree()
        t.focus()
        t.action_cursor_up()

    def action_vi_left(self) -> None:
        t = self._tree()
        t.focus()
        node = t.cursor_node
        if node is None:
            return
        if node.is_expanded:
            node.collapse()
        else:
            if node.parent is not None and not node.parent.is_root:
                t.move_cursor(node.parent)

    def action_vi_right(self) -> None:
        t = self._tree()
        t.focus()
        node = t.cursor_node
        if node is not None and node.allow_expand:
            if not node.is_expanded:
                node.expand()
            elif node.children:
                t.move_cursor(node.children[0])

    def action_focus_filter(self) -> None:
        self.query_one("#filter", Input).focus()

    def action_help(self) -> None:
        self.push_screen(HelpScreen())

    def action_rescan(self) -> None:
        if self._mutation_busy:
            self._status("Finish the current change before rescanning", "warn")
            return
        path = self._cursor_leaf()
        self.action_lock()
        self._preview_paused = False
        self.run_worker(self.rescan(select=path), group="scan", exclusive=True)

    # -- modify flows ---------------------------------------------------

    def _editor_command(self) -> Optional[list[str]]:
        if self.settings.editor == "builtin":
            return None  # --builtin-editor explicitly requests the built-in editor
        editor = self.settings.editor or os.environ.get("EDITOR")
        if not editor:
            return None
        try:
            parts = shlex.split(editor)
        except ValueError:
            return None
        if not parts or not shutil.which(parts[0]):
            return None
        return parts

    async def _edit_content(self, path: str, initial: str, *, creating: bool, builtin: bool = False) -> Optional[str]:
        cmd = None if builtin else self._editor_command()
        if cmd is None:
            new = await self.push_screen_wait(EditorScreen(initial, title=path))
        else:
            runtime = os.environ.get("XDG_RUNTIME_DIR") or os.environ.get("TMPDIR")
            with tempfile.TemporaryDirectory(prefix="cq_pass_", dir=runtime) as dirname:
                tmp = Path(dirname) / "secret.yaml"
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, "w") as stream:
                    stream.write(initial)
                with self.suspend():
                    result = subprocess.run([*cmd, str(tmp)], check=False)
                if result.returncode:
                    self._status("External editor failed; changes were not saved", "err")
                    return None
                new = tmp.read_text()
        if new is None or new == initial and not creating:
            return None
        return new

    @staticmethod
    def _under(base: str, typed: str) -> str:
        """Resolve a user-typed name against the current directory.

        Names are relative to the directory shown in the prompt help, unless
        the user already typed the base prefix themselves.
        """
        typed = typed.strip().strip("/")
        if not base or typed.startswith(base) or typed == base.rstrip("/"):
            return typed
        return f"{base}{typed}"

    @work(group="mutations")
    @mutation_action
    async def action_new_folder(self) -> None:
        """Create a folder in the store with a plain mkdir.

        gopass itself has no mkdir and only lists entries, so empty folders are
        picked up by scanning the store directory (see list_dirs). Delete the
        last entry of a folder to make it go away again.
        """
        base_dir = self._cursor_dir()
        base = f"{base_dir}/" if base_dir else ""

        folder = await self.push_screen_wait(
            PromptScreen(
                "New folder",
                default="new-folder",
                placeholder="name  or  sub/name",
                help=f"under {base or '/'} · Enter to create · Esc to cancel",
            )
        )
        if folder is None:
            self._status("cancelled", "muted")
            return

        # The name is always relative to the directory shown in the help line.
        folder = self._under(base, folder)
        validate_entry_path(folder)
        destination = (self.store / folder).resolve()
        if self.store.resolve() not in destination.parents:
            self._status("Folder must remain inside this store", "err")
            return

        try:
            await asyncio.to_thread(lambda: (self.store / folder).mkdir(parents=True, exist_ok=False))
        except FileExistsError:
            self._status(f"{folder}/ already exists", "warn")
            return
        except OSError as exc:
            self._status(f"could not create folder: {exc}", "err")
            return

        await self.rescan()
        if folder not in self._tree_nodes:
            # An active filter can hide the freshly created folder — drop the
            # filter so the user actually sees what they just made.
            self.query_one("#filter", Input).value = ""
            await self.rescan()
        self._reveal_dir(folder)
        self._status(f"created {folder}/", "ok")

    @work(group="mutations")
    @mutation_action
    async def action_edit_secret(self, builtin: bool = False) -> None:
        path = self._target_path()
        if not path:
            return

        async def run() -> None:
            try:
                current = await asyncio.to_thread(self.backend.read, path)
            except CqPassError as exc:
                self._status(f"could not read: {exc}", "err")
                return
            new = await self._edit_content(path, current.raw, creating=False, builtin=builtin)
            if new is None:
                self._status("edit cancelled", "muted")
                return
            try:
                latest = await asyncio.to_thread(self.backend.read, path)
                if latest.raw != current.raw:
                    self._status("Entry changed while editing; save cancelled to preserve the newer version", "warn")
                    return
                await asyncio.to_thread(self.backend.write, path, new, self.settings.commit_message)
            except CqPassError as exc:
                self._status(f"save failed: {exc}", "err")
                return
            self._secret_cache.pop(path, None)  # stale plaintext
            self._status(f"saved {path}", "ok")
            self.notify(f"Saved {path}", timeout=5)
            await self.load_detail(path)

        await run()

    @work(group="mutations")
    @mutation_action
    async def action_new_secret(self) -> None:
        base_dir = self._cursor_dir()
        base = f"{base_dir}/" if base_dir else ""
        tpl = await self.push_screen_wait(TemplatePickerScreen(self.templates))
        if tpl is None:
            return
        if not tpl.valid:
            self._status("That template could not be parsed", "err")
            return
        result = await self.push_screen_wait(NewSecretScreen(tpl, base))
        if result is None:
            self._status("Creation cancelled")
            return
        values, path, choice = result
        password = await self._choose_password(choice)
        if password is None:
            return
        entries = await asyncio.to_thread(self.backend.entries)
        if path in entries and not await self.push_screen_wait(ConfirmScreen("Overwrite existing entry?", f"Replace the entire existing entry at {path}?")):
            return
        original = (await asyncio.to_thread(self.backend.read, path)).raw if path in entries else None
        content = render_template(tpl, values, password)
        final = await self._edit_content(path, content, creating=True)
        if final is None:
            self._status("Creation cancelled")
            return
        fresh_entries = await asyncio.to_thread(self.backend.entries)
        latest = (await asyncio.to_thread(self.backend.read, path)).raw if path in fresh_entries else None
        if latest != original:
            self._status("Destination changed during editing; creation cancelled to preserve it", "warn")
            return
        await asyncio.to_thread(self.backend.write, path, final, self.settings.commit_message)
        self._secret_cache.pop(path, None)
        await self.rescan(select=path)
        self._status(f"Created {path}", "ok")

    async def _choose_password(self, choice: str) -> Optional[str]:
        try:
            kind, value = self._parse_password_choice(choice)
            if kind == "literal":
                password = str(value)
                if not password or "\n" in password or "\r" in password:
                    raise CqPassError("Password must be one nonempty line")
                if len(password) < 8 and not await self.push_screen_wait(ConfirmScreen("Use a short password?", f"Store the literal password exactly as entered ({len(password)} characters)?")):
                    return None
                return password
            if kind == "gopass":
                return await asyncio.to_thread(self._gopass_password, int(value))
            return self._local_password(int(value), symbols=kind == "symbols")
        except CqPassError as error:
            self._status(str(error), "err")
            return None

    @staticmethod
    def _parse_password_choice(choice: str) -> tuple[str, object]:
        if choice == "":
            return "local", 24
        if choice.lower().startswith("literal:"):
            if not choice[8:]:
                raise CqPassError("Empty password refused")
            return "literal", choice[8:]
        match = re.fullmatch(r"(?i)(generate|symbols|gopass):\s*(\d+)", choice.strip())
        if match:
            kind = {"generate": "local", "symbols": "symbols", "gopass": "gopass"}[match[1].lower()]
            length = int(match[2])
            if not 8 <= length <= 4096:
                raise CqPassError("Generated passwords must be 8–4096 characters")
            return kind, length
        return "literal", choice

    @staticmethod
    def _local_password(length: int, symbols: bool = False) -> str:
        import secrets
        if not 8 <= length <= 4096:
            raise CqPassError("Generated passwords must be 8–4096 characters")
        groups = ["abcdefghijkmnopqrstuvwxyz", "ABCDEFGHJKMNPQRSTUVWXYZ", "23456789"]
        if symbols:
            groups.append("!@#$%^&*()-_=+[]{}:,.?")
        chars = [secrets.choice(group) for group in groups]
        alphabet = "".join(groups)
        chars.extend(secrets.choice(alphabet) for _ in range(length-len(chars)))
        secrets.SystemRandom().shuffle(chars)
        return "".join(chars)

    def _gopass_password(self, length: int) -> str:
        if not 8 <= length <= 4096:
            raise CqPassError("Generated passwords must be 8–4096 characters")
        output = self.backend.run("pwgen", "--one-per-line", str(length), "1")
        lines = output.splitlines()
        if len(lines) != 1 or len(lines[0]) < 8:
            raise CqPassError("Password generator did not return one valid password")
        return lines[0]

    @work(group="mutations")
    @mutation_action
    async def action_generate(self) -> None:
        path = self._target_path()
        if not path:
            return
        current = await asyncio.to_thread(self.backend.read, path)
        choice = await self.push_screen_wait(PromptScreen("Replace first-line password", default="generate:24", password=True,
            help="generate:32 · symbols:32 · literal text · body is preserved"))
        if choice is None:
            return
        if choice.isdecimal():
            choice = "generate:" + choice
        password = await self._choose_password(choice)
        if password is None:
            return
        if not await self.push_screen_wait(ConfirmScreen("Replace password?", f"Replace only the first line of {path}?\nAll body text and extra documents are preserved.")):
            return
        latest = await asyncio.to_thread(self.backend.read, path)
        if latest.raw != current.raw:
            self._status("Entry changed during review; reopen it and try again", "warn")
            return
        first, separator, body = current.raw.partition("\n")
        raw = password + ("\r" if first.endswith("\r") else "") + separator + body
        await asyncio.to_thread(self.backend.write, path, raw, self.settings.commit_message)
        self._secret_cache.pop(path, None)
        await self._copy(password, "new password")
        await self.load_detail(path)
        self._status(f"Password replaced for {path}", "ok")

    @work(group="mutations")
    @mutation_action
    async def action_rename_move(self) -> None:
        path = self._target_path()
        if not path:
            return

        async def run() -> None:
            new = await self.push_screen_wait(
                PromptScreen("Move / rename", default=path, placeholder="new/entry/path")
            )
            if not new:
                return
            new = new.strip().strip("/")
            validate_entry_path(new)
            if new == path or not new:
                self._status("nothing to do", "muted")
                return
            entries = await asyncio.to_thread(self.backend.entries)
            if new in entries and not await self.push_screen_wait(ConfirmScreen("Overwrite destination?", f"Replace the existing entry at {new}?")):
                return
            try:
                await asyncio.to_thread(self.backend.run, "move", "--force", path, new)
            except CqPassError as exc:
                self._status(f"move failed: {exc}", "err")
                return
            self._secret_cache.pop(path, None)  # stale plaintext
            self._secret_cache.pop(new, None)
            self.notify(f"Moved to {new}", timeout=5)
            self._status(f"moved → {new}", "ok")
            await self.rescan(select=new)

        await run()

    @work(group="mutations")
    @mutation_action
    async def action_delete_secret(self) -> None:
        path = self._target_path()
        if not path:
            return

        async def run() -> None:
            ok = await self.push_screen_wait(
                ConfirmScreen("Delete secret", f"Remove {path} from the current store?\nGit history may retain earlier versions.")
            )
            if not ok:
                self._status("delete cancelled", "muted")
                return
            try:
                await asyncio.to_thread(self.backend.run, "delete", "--force", path)
            except CqPassError as exc:
                self._status(f"delete failed: {exc}", "err")
                return
            self._secret_cache.pop(path, None)  # stale plaintext
            self._current = None
            self.query_one("#detail", Static).update(Text("deleted", style="dim italic"))
            self.notify(f"Deleted {path}", severity="warning", timeout=5)
            await self.rescan()

        await run()

    # -- key handling for gg / Esc-in-filter ----------------------------

    async def on_key(self, event) -> None:
        if isinstance(self.screen, ModalScreen):
            return
        if isinstance(self.focused, (Input, TextArea)) and event.key != "escape":
            return
        # gg => top of the tree
        if event.key == "g":
            now = time.monotonic()
            if now - self._pending_g < 0.8:
                tree = self.query_one("#tree", Tree)
                tree.move_cursor_to_line(0)
                self._pending_g = 0.0
                event.stop()
                event.prevent_default()
                return
            self._pending_g = now

        if event.key == "escape":
            filt = self.query_one("#filter", Input)
            if filt.has_focus and filt.value:
                filt.value = ""
                self._apply_filter()
                event.stop()
                event.prevent_default()
                return
            if filt.has_focus:
                self.query_one("#tree", Tree).focus()
                event.stop()
                event.prevent_default()
                return


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

cli = typer.Typer(
    help="Browse, create and edit gopass secrets in a modern TUI.",
    no_args_is_help=False,
    add_completion=False,
)


@cli.command()
def main(
    entry: Optional[str] = typer.Argument(None, help="Entry to open on start."),
    store: Optional[str] = typer.Option(None, "--store", "-s", help="Password store path."),
    reveal: bool = typer.Option(False, "--reveal", "-r", help="Show secrets unmasked."),
    templates_dir: Optional[str] = typer.Option(
        None, "--templates-dir", "-t", help="Override the template directory."
    ),
    no_editor: bool = typer.Option(
        False, "--builtin-editor", help="Ignore $EDITOR and use the built-in editor."
    ),
    theme: Optional[Literal["macchiato", "latte"]] = typer.Option(
        None, "--theme", help="Choose the dark or light Catppuccin theme."
    ),
) -> None:
    """Launch the vault browser."""
    try:
        settings = Settings()
        if SETTINGS_FILE.exists():
            data = yaml.safe_load(SETTINGS_FILE.read_text()) or {}
            if isinstance(data, dict):
                settings = Settings.model_validate(data)
            else:
                raise CqPassError("Settings must be a YAML mapping.")
        if theme:
            settings.theme = theme
        if reveal:
            settings.reveal_by_default = True
        if no_editor:
            settings.editor = "builtin"
        if templates_dir:
            global TEMPLATE_DIR
            TEMPLATE_DIR = Path(templates_dir).expanduser()

        resolved = resolve_store(store, settings)
        templates = load_templates()
    except CqPassError as exc:
        typer.secho(str(exc), fg=typer.colors.RED, err=True)
        raise typer.Exit(1)
    except (OSError, ValidationError, yaml.YAMLError):
        typer.secho("Could not load settings or templates: invalid or unreadable configuration.", fg=typer.colors.RED, err=True)
        raise typer.Exit(1)

    app = PassTUI(resolved, settings, templates, initial_entry=entry)
    app.run()


if __name__ == "__main__":
    cli()
