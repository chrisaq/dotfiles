#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "typer>=0.12.5",
#   "textual>=8.0",
#   "pydantic>=2.8",
#   "pyyaml>=6.0",
# ]
# ///
#:usage: cq_pass-tui [ENTRY] [--store PATH] [--reveal]
#:no-args: true
#:desc: Browse, create, edit and manage gopass secrets in a modern TUI.

"""
cq_pass-tui — a modern TUI browser/manager for a gopass password store.

Design notes
------------
* All reads/writes shell out to `gopass` so encryption, git auto-commit, mounts
  and `fsck` behaviour stay consistent with the rest of the cq_pass toolset.
* Secret bodies in a real-world store are NOT valid YAML (a free-text title line
  followed by `key: value` pairs, unquoted colons, JSON fragments, ...). We never
  re-serialise. We render the raw text with a YAML lexer (pygments does not
  validate, so it still looks good) and parse *leniently* only to extract fields
  for copy/preview.
* The password (first line) and secret-looking fields are masked by default.
  Press `v` to reveal.
* Editing goes through $EDITOR when set, otherwise a built-in editor. Both paths
  write to a temp file and commit with `gopass insert --force`.
"""

from __future__ import annotations

import asyncio
import os
import re
import shutil
import subprocess
import tempfile
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Iterable, Optional

import typer
import yaml
from pydantic import BaseModel, ConfigDict, Field, ValidationError
from rich.console import Group
from rich.rule import Rule
from rich.syntax import Syntax
from rich.table import Table
from rich.text import Text

from textual import on, work
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Horizontal, Vertical
from textual.screen import ModalScreen
from textual.widgets import Button, Footer, Header, Input, Label, ListItem, ListView, Static
from textual.widgets import TextArea, Tree
from textual.widgets._tree import TreeNode

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

APP_NAME = "cq_pass-tui"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "cq_pass"
TEMPLATE_DIR = CONFIG_DIR / "templates"
SETTINGS_FILE = CONFIG_DIR / "settings.yml"

MASK = "•"
MASK_MIN = 8

# Placeholder leaf used to materialise a folder (gopass has no mkdir).
FOLDER_MARKER = ".folder"

# Keys whose values are treated as secret when masking.
SECRET_KEY_RE = re.compile(
    r"(password|passwd|pass|secret|token|api[_-]?key|apikey|access[_-]?key|"
    r"private[_-]?key|pat|pin|otp|totp|code|credential|auth)",
    re.IGNORECASE,
)

# A `---` document separator on its own line.
DOC_SEP_RE = re.compile(r"^\s*---\s*$")

# A lenient `key: value` line (key is a sane identifier-ish thing).
KV_RE = re.compile(r"^([A-Za-z0-9][A-Za-z0-9 ._/-]{0,60}):\s?(.*)$")

# Keys that are safe to show while MASKED. This is an allowlist on purpose: the old
# denylist approach (mask only secret-looking keys) leaked recovery codes, tokens
# and any other content that was not a plain top-level `key: value` line.
# Everything not listed here is hidden until revealed.
SAFE_KEY_RE = re.compile(
    r"^(user|users|user_?name|login|log_?in|account|account_?name|email|e-?mail|"
    r"url|uri|link|website|href|host|host_?name|domain|port|path|site|site_?name|"
    r"name|title|display_?name|comment|created|updated|modified|created_?at|"
    r"updated_?at|expires|environment|env|region|location|type|category)$",
    re.IGNORECASE,
)


def mask_token(value: str) -> str:
    """Dot out a value, roughly preserving its visible length."""
    return MASK * max(MASK_MIN, min(len(value), 40))


def mask_doc(doc_text: str, fields: list[SecretField], *, mask_first_line: bool = False) -> str:
    """Return a display-safe version of a document.

    Only keys matching SAFE_KEY_RE are shown. Bare `label:` lines are shown as
    labels (they carry no value). Everything else — secret keys, indented list
    items, free text — is dotted out.
    """
    lines = doc_text.splitlines()
    out: list[str] = []
    for i, line in enumerate(lines):
        if i == 0 and mask_first_line and line.strip():
            out.append(mask_token(line.strip()))
            continue
        if not line.strip():
            out.append(line)
            continue

        indent = line[: len(line) - len(line.lstrip())]
        stripped = line.strip()
        m = KV_RE.match(stripped)
        if m:
            key = m.group(1).strip()
            val = m.group(2).strip()
            if not val:
                out.append(f"{indent}{key}:")
            elif SAFE_KEY_RE.match(key):
                out.append(line)
            else:
                out.append(f"{indent}{key}: {mask_token(val)}")
            continue
        # Unstructured content (list items, prose, codes) -> hidden.
        out.append(f"{indent}{mask_token(stripped)}")
    return "\n".join(out)

GENERATOR_CHARSETS = {
    "alphanumeric": "abcdefghijklmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789",
    "numeric": "0123456789",
}


# ---------------------------------------------------------------------------
# Errors
# ---------------------------------------------------------------------------


class CqPassError(Exception):
    """Base error; message is safe to show in the UI."""


class GopassError(CqPassError):
    pass


class TemplateError(CqPassError):
    pass


# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------


class TemplateField(BaseModel):
    """One prompt in the 'new secret' form."""

    model_config = ConfigDict(extra="forbid")

    name: str
    prompt: Optional[str] = None
    required: bool = True
    default: str = ""

    @property
    def label(self) -> str:
        return self.prompt or self.name.replace("_", " ").title()


class Template(BaseModel):
    """A secret template: suggested path + initial content.

    `content` is the full initial secret text. `{{ placeholder }}` tokens are
    filled from the form values plus `{{ password }}`.
    """

    model_config = ConfigDict(extra="forbid")

    name: str
    description: str = ""
    prefix: str = ""
    fields: list[TemplateField] = Field(default_factory=list)
    content: str = "{{ password }}"
    filename: str = ""

    @property
    def is_empty(self) -> bool:
        return self.content.strip() == "{{ password }}"


class Settings(BaseModel):
    model_config = ConfigDict(extra="ignore")

    store: Optional[str] = None
    clip_timeout: int = 15
    reveal_by_default: bool = False
    editor: Optional[str] = None
    browser: Optional[str] = None
    # gopass 1.16 always makes a local commit on write and exposes no per-command
    # way to skip it (there is no `git.auto_commit` key). We keep the commit — it is
    # the only undo for a botched secret edit — but let the message be labelled.
    commit_message: Optional[str] = None


class SecretField(BaseModel):
    """A field extracted from a secret body by the lenient parser."""

    model_config = ConfigDict(arbitrary_types_allowed=True)

    key: str
    value: str
    is_secret: bool = False


@dataclass
class SecretDoc:
    """One `---` separated document of a secret."""

    raw: str
    index: int
    fields: list[SecretField] = field(default_factory=list)
    is_plain: bool = False  # no key/value structure at all


@dataclass
class Secret:
    path: str
    name: str
    docs: list[SecretDoc] = field(default_factory=list)
    raw: str = ""

    @property
    def password(self) -> str:
        line = self.raw.splitlines()[0] if self.raw else ""
        return line.strip()

    def first_value(self, *keys: str) -> Optional[str]:
        wanted = {k.lower() for k in keys}
        for doc in self.docs:
            for f in doc.fields:
                if f.key.lower() in wanted:
                    return f.value
        return None

    @property
    def username(self) -> Optional[str]:
        return self.first_value("username", "user", "login", "account", "email", "mail")

    @property
    def url(self) -> Optional[str]:
        return self.first_value("url", "uri", "link", "website", "site", "host")


# ---------------------------------------------------------------------------
# Store / gopass layer
# ---------------------------------------------------------------------------


def resolve_store(explicit: Optional[str] = None, settings: Optional[Settings] = None) -> Path:
    for candidate in (
        explicit,
        (settings.store if settings else None),
        os.environ.get("PASSWORD_STORE_DIR"),
        str(Path.home() / ".password-store"),
    ):
        if not candidate:
            continue
        p = Path(candidate).expanduser()
        if p.is_dir():
            return p.resolve()
    raise CqPassError(
        "No password store found.\n"
        "Set $PASSWORD_STORE_DIR, pass --store, or configure settings.yml"
    )


def gopass(*args: str, stdin: Optional[str] = None, timeout: int = 120) -> str:
    """Run gopass, return stdout. Raise GopassError with a UI-safe message."""
    if shutil.which("gopass") is None:
        raise GopassError("gopass is not installed or not on $PATH")
    try:
        proc = subprocess.run(
            ["gopass", *args],
            input=stdin,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        raise GopassError(f"gopass {' '.join(args)} timed out") from exc

    if proc.returncode != 0:
        msg = (proc.stderr or proc.stdout or "").strip()
        # Never echo secret material that gopass may have printed.
        msg = "\n".join(msg.splitlines()[:4])
        raise GopassError(msg or f"gopass {' '.join(args[:1])} failed")
    return proc.stdout


def list_entries() -> list[str]:
    out = gopass("ls", "--flat")
    return sorted({line.strip() for line in out.splitlines() if line.strip()})


def read_secret(path: str) -> Secret:
    raw = gopass("show", "--noparsing", "--force", path)
    return build_secret(path, raw)


def write_secret(path: str, content: str, commit_message: Optional[str] = None) -> None:
    args = ["insert", "--force"]
    if commit_message:
        args += ["--commit-message", commit_message]
    args.append(path)
    gopass(*args, stdin=content)


# ---------------------------------------------------------------------------
# Lenient parsing + masking
# ---------------------------------------------------------------------------


def split_docs(raw: str) -> list[tuple[int, str]]:
    """Split raw secret text on standalone `---` lines, keeping order."""
    docs: list[tuple[int, str]] = []
    buf: list[str] = []
    idx = 0
    for line in raw.splitlines():
        if DOC_SEP_RE.match(line):
            docs.append((idx, "\n".join(buf)))
            buf = []
            idx += 1
        else:
            buf.append(line)
    docs.append((idx, "\n".join(buf)))
    return docs


def parse_fields(doc_text: str) -> list[SecretField]:
    """Extract key/value pairs without requiring valid YAML."""
    fields: list[SecretField] = []
    # Fast path: strict YAML when it happens to be valid.
    try:
        loaded = yaml.safe_load(doc_text)
        if isinstance(loaded, dict):
            for k, v in loaded.items():
                sval = v if isinstance(v, str) else yaml.safe_dump(v, default_flow_style=True).strip()
                fields.append(
                    SecretField(key=str(k), value=sval, is_secret=bool(SECRET_KEY_RE.search(str(k))))
                )
            return fields
    except Exception:
        pass

    # Lenient path: line scan.
    for line in doc_text.splitlines():
        if not line.strip() or line.startswith((" ", "\t", "#")):
            continue
        m = KV_RE.match(line)
        if m:
            key, value = m.group(1).strip(), m.group(2).strip()
            if key and len(key.split()) <= 4:
                fields.append(
                    SecretField(key=key, value=value, is_secret=bool(SECRET_KEY_RE.search(key)))
                )
    return fields


def build_secret(path: str, raw: str) -> Secret:
    name = path.rsplit("/", 1)[-1] if "/" in path else path
    docs: list[SecretDoc] = []
    for idx, text in split_docs(raw):
        fields = parse_fields(text)
        docs.append(
            SecretDoc(raw=text, index=idx, fields=fields, is_plain=not fields and bool(text.strip()))
        )
    return Secret(path=path, name=name, docs=docs, raw=raw)


# ---------------------------------------------------------------------------
# Fuzzy matching
# ---------------------------------------------------------------------------


def fuzzy_score(query: str, text: str) -> Optional[float]:
    """Cheap fzf-ish subsequence score. Higher is better; None means no match."""
    if not query:
        return 0.0
    q, t = query.lower(), text.lower()
    if q in t:
        return 1000.0 - t.index(q) - len(t) * 0.01
    score = 0.0
    pos = 0
    for ch in q:
        found = t.find(ch, pos)
        if found == -1:
            return None
        if found == 0 or t[found - 1] in "/._- @:":
            score += 8
        else:
            score += 1
        pos = found + 1
    return score - len(t) * 0.01


