    from textual.widgets._tree import TreeNode

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

APP_NAME = "cq_pass-tui"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "cq_pass"
TEMPLATE_DIR = CONFIG_DIR / "templates"
SETTINGS_FILE = CONFIG_DIR / "settings.yml"

MASK = "•"
MASK_MIN = 8

# Placeholder leaf used to materialise a folder (gopass has no mkdir).
FOLDER_MARKER = ".folder"


# A `---` document separator on its own line.
DOC_SEP_RE = re.compile(r"^\s*---\s*$")

# A lenient `key: value` line (key is a sane identifier-ish thing).
KV_RE = re.compile(r"^([A-Za-z0-9][A-Za-z0-9 ._/-]{0,60}):\s?(.*)$")

# Keys that are safe to show while MASKED. This is an allowlist on purpose: the old
# denylist approach (mask only secret-looking keys) leaked recovery codes, tokens
# and any other content that was not a plain top-level `key: value` line.
# Everything not listed here is hidden until revealed.
SAFE_KEY_RE = re.compile(
    r"^(user|users|user_?name|login|log_?in|account|account_?name|email|e-?mail|"
    r"url|uri|link|website|href|host|host_?name|domain|port|path|site|site_?name|"
    r"name|title|display_?name|comment|created|updated|modified|created_?at|"
    r"updated_?at|expires|environment|env|region|location|type|category)$",
    re.IGNORECASE,
)


def mask_token(value: str) -> str:
    """Dot out a value, roughly preserving its visible length."""
    return MASK * max(MASK_MIN, min(len(value), 40))


def mask_doc(doc_text: str, *, mask_first_line: bool = False) -> str:
    """Return a display-safe version of a document.

    Only keys matching SAFE_KEY_RE are shown. Bare `label:` lines are shown as
    labels (they carry no value). Everything else — secret keys, indented list
    items, free text — is dotted out.
    """
    lines = doc_text.splitlines()
    out: list[str] = []
    for i, line in enumerate(lines):
        if i == 0 and mask_first_line and line.strip():
            out.append(mask_token(line.strip()))
            continue
        if not line.strip():
            out.append(line)
            continue

        indent = line[: len(line) - len(line.lstrip())]
        stripped = line.strip()
        if indent:
            out.append(indent + mask_token(stripped))
            continue
        m = KV_RE.match(stripped)
        if m:
            key = m.group(1).strip()
            val = m.group(2).strip()
            if not val:
                out.append(f"{indent}{key}:")
            elif SAFE_KEY_RE.match(key):
                if key.lower() in {"url", "uri", "link", "website"} and "://" in val:
                    try:
                        url = urlsplit(val)
                        host = url.hostname or ""
                        if ":" in host:
                            host = "[" + host + "]"
                        if url.port:
                            host += ":" + str(url.port)
                        safe = urlunsplit((url.scheme, host, url.path, "[hidden]" if url.query else "", ""))
                        out.append(f"{key}: {safe}")
                    except ValueError:
                        out.append(f"{key}: {mask_token(val)}")
                else:
                    out.append(line)
            else:
                out.append(f"{indent}{key}: {mask_token(val)}")
            continue
        # Unstructured content (list items, prose, codes) -> hidden.
        out.append(f"{indent}{mask_token(stripped)}")
    return "\n".join(out)


# ---------------------------------------------------------------------------
# Errors
# ---------------------------------------------------------------------------


class CqPassError(Exception):
    """Base error; message is safe to show in the UI."""


class GopassError(CqPassError):
    pass


# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------


class TemplateField(BaseModel):
    """One prompt in the 'new secret' form."""

    model_config = ConfigDict(extra="forbid")

    name: str
    prompt: Optional[str] = None
    required: bool = True
    default: str = ""

    @property
    def label(self) -> str:
        return self.prompt or self.name.replace("_", " ").title()


class Template(BaseModel):
    """A secret template: suggested path + initial content.

    `content` is the full initial secret text. `{{ placeholder }}` tokens are
    filled from the form values plus `{{ password }}`.
    """

    model_config = ConfigDict(extra="forbid")

    name: str
    description: str = ""
    prefix: str = ""
    fields: list[TemplateField] = Field(default_factory=list)
    content: str = "{{ password }}"
    filename: str = ""
    valid: bool = True

    @property
    def is_empty(self) -> bool:
        return self.content.strip() == "{{ password }}"


class Settings(BaseModel):
    model_config = ConfigDict(extra="ignore")

    store: Optional[str] = None
    clip_timeout: int = Field(default=15, ge=0, le=3600)
    reveal_by_default: bool = False
    editor: Optional[str] = None
    browser: Optional[str] = None
    theme: Literal["macchiato", "latte"] = "macchiato"
    animation: bool = True
    reveal_timeout: int = Field(default=30, ge=1, le=3600)
    cache_ttl: int = Field(default=60, ge=0, le=3600)
    mask_on_blur: bool = True
    # gopass 1.16 always makes a local commit on write and exposes no per-command
    # way to skip it (there is no `git.auto_commit` key). We keep the commit — it is
    # the only undo for a botched secret edit — but let the message be labelled.
    commit_message: Optional[str] = None


class SecretField(BaseModel):
    """A field extracted from a secret body by the lenient parser."""

    key: str
    value: str


@dataclass
class SecretDoc:
    """One `---` separated document of a secret."""

    raw: str
    index: int
    fields: list[SecretField] = field(default_factory=list)
    is_plain: bool = False  # no key/value structure at all


@dataclass
class Secret:
    path: str
    name: str
    docs: list[SecretDoc] = field(default_factory=list)
    raw: str = ""

    @property
    def password(self) -> str:
        line = self.raw.splitlines()[0] if self.raw else ""
        return line

    def first_value(self, *keys: str) -> Optional[str]:
        wanted = {k.lower() for k in keys}
        for doc in self.docs:
            for f in doc.fields:
                if f.key.lower() in wanted:
                    return f.value
        return None

    @property
    def username(self) -> Optional[str]:
        return self.first_value("username", "user", "login", "account", "email", "mail")

    @property
    def url(self) -> Optional[str]:
        return self.first_value("url", "uri", "link", "website", "site", "host")


# ---------------------------------------------------------------------------
# Store / gopass layer
# ---------------------------------------------------------------------------


def native_config_path() -> Path:
    if os.environ.get("GOPASS_CONFIG"):
        return Path(os.environ["GOPASS_CONFIG"]).expanduser()
    home = Path(os.environ.get("GOPASS_HOMEDIR", Path.home()))
    return Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")) / "gopass/config"


def configured_store() -> Optional[Path]:
    """Read only the root path; do not run gopass configuration migration."""
    parser = configparser.RawConfigParser(strict=False)
    try:
        parser.read(native_config_path())
        value = parser.get("mounts", "path", fallback="").strip().strip('"')
        return Path(value).expanduser().resolve() if value else None
    except (OSError, configparser.Error):
        return None


def resolve_store(explicit: Optional[str] = None, settings: Optional[Settings] = None) -> Path:
    for candidate in (
        explicit,
        (settings.store if settings else None),
        os.environ.get("PASSWORD_STORE_DIR"),
        str(configured_store()) if configured_store() else None,
        str(Path.home() / ".password-store"),
    ):
        if not candidate:
            continue
        p = Path(candidate).expanduser()
        if p.is_dir():
            return p.resolve()
        raise CqPassError(f"Selected password store does not exist: {p}")
    raise CqPassError(
        "No password store found.\n"
        "Set $PASSWORD_STORE_DIR, pass --store, or configure settings.yml"
    )


def gopass(*args: str, stdin: Optional[str] = None, timeout: int = 120,
           env: Optional[dict[str, str]] = None, cwd: Optional[Path] = None) -> str:
    """Run gopass, return stdout. Raise GopassError with a UI-safe message."""
    if shutil.which("gopass") is None:
        raise GopassError("gopass is not installed or not on $PATH")
    try:
        proc = subprocess.run(
            ["gopass", *args],
            input=stdin,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            env=env,
            cwd=cwd,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise GopassError(f"gopass {args[0] if args else 'command'} could not complete") from exc

    if proc.returncode != 0:
        # Never echo secret material: with `--unsafe`, stdout can be the secret
        # itself, so only stderr is safe to surface.
        # Backend diagnostics and hooks may echo stdin too. Keep errors generic;
        # neither stream is a safe place to source a password-manager toast.
        raise GopassError(f"gopass {args[0] if args else 'command'} failed (exit {proc.returncode}). Check gopass in a terminal.")
    return proc.stdout


class GopassClient:
    """Store-bound backend. Explicit alternate roots never use the live root.

    Native configuration (including mounts) is preserved when it matches. An
    alternate root gets a private, temporary gopass configuration, not a global
    environment change. Only paths/configuration, never decrypted entries, are
    written there.
    """
    def __init__(self, store: Path):
        self.store = store.resolve()
        self._temporary: Optional[tempfile.TemporaryDirectory] = None
        self._lock = threading.RLock()
        self._native = configured_store() == self.store

    def environment(self) -> dict[str, str]:
        env = dict(os.environ)
        env.update(GOPASS_CONFIG_NO_MIGRATE="1", CHECKPOINT_DISABLE="1", GOPASS_NO_NOTIFY="1", NO_COLOR="1")
        env.pop("GOPASS_DEBUG_LOG_SECRETS", None)
        if not self._native:
            with self._lock:
                if self._temporary is None:
                    self._temporary = tempfile.TemporaryDirectory(prefix="cq-pass-backend-")
                    config = Path(self._temporary.name) / ".config/gopass/config"
                    config.parent.mkdir(parents=True, mode=0o700)
                    config.write_text("[mounts]\n path = " + json.dumps(str(self.store)) + "\n")
                    config.chmod(0o600)
            config = Path(self._temporary.name) / ".config/gopass/config"
            runtime = env.get("XDG_RUNTIME_DIR")
            env = {key: value for key, value in env.items() if not key.startswith(("GOPASS_CONFIG", "XDG_"))}
            if runtime:
                env["XDG_RUNTIME_DIR"] = runtime
            env.update(GOPASS_HOMEDIR=self._temporary.name, XDG_CONFIG_HOME=str(Path(self._temporary.name) / ".config"),
                       GOPASS_CONFIG=str(config), GOPASS_CONFIG_NOSYSTEM="1", GOPASS_CONFIG_NO_MIGRATE="1")
        return env

    def run(self, *args: str, stdin: Optional[str] = None, timeout: int = 120) -> str:
        return gopass(*args, stdin=stdin, timeout=timeout, env=self.environment(), cwd=self.store)

    def entries(self) -> list[str]:
        return sorted({line.strip() for line in self.run("ls", "--flat").splitlines() if line.strip()})

    def read(self, path: str) -> Secret:
        validate_entry_path(path)
        return build_secret(path, self.run("show", "--noparsing", "--unsafe", "--nofuzzysearch", path))

    def write(self, path: str, content: str, message: Optional[str] = None) -> None:
        validate_entry_path(path)
        args = ["insert", "--force"]
        if message:
            args += ["--commit-message", message]
        self.run(*args, path, stdin=content)

    def close(self) -> None:
        if self._temporary:
            self._temporary.cleanup()


def validate_entry_path(path: str) -> str:
    if not path or path.startswith(("-", "/")) or "\\" in path or any(ord(c) < 32 for c in path):
        raise CqPassError("Use a relative entry path without control characters")
    if any(part in {"", ".", "..", ".git", ".gopass"} for part in path.split("/")):
        raise CqPassError("Invalid entry path")
    return path




def list_dirs(store: Path) -> list[str]:
    """All directories inside the store (relative paths), including empty ones.

    gopass only lists entries, so empty folders created with a plain mkdir are
    invisible to it — we scan the filesystem for them.
    """
    dirs: list[str] = []
    try:
        for root, dirnames, _files in os.walk(store):
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            rel = os.path.relpath(root, store)
            if rel != ".":
                dirs.append(rel)
    except OSError:
        pass
    return sorted(dirs)






# ---------------------------------------------------------------------------
# Lenient parsing + masking
# ---------------------------------------------------------------------------


def split_docs(raw: str) -> list[tuple[int, str]]:
    """Split raw secret text on standalone `---` lines, keeping order."""
    docs: list[tuple[int, str]] = []
    buf: list[str] = []
    idx = 0
    for line in raw.splitlines():
        if DOC_SEP_RE.match(line):
            docs.append((idx, "\n".join(buf)))
            buf = []
            idx += 1
        else:
            buf.append(line)
    docs.append((idx, "\n".join(buf)))
    return docs


def parse_fields(doc_text: str) -> list[SecretField]:
    """Extract key/value pairs without requiring valid YAML."""
    fields: list[SecretField] = []
    # Fast path: strict YAML when it happens to be valid.
    try:
        loaded = yaml.safe_load(doc_text)
        if isinstance(loaded, dict):
            for k, v in loaded.items():
                sval = v if isinstance(v, str) else yaml.safe_dump(v, default_flow_style=True).strip()
                fields.append(SecretField(key=str(k), value=sval))
            return fields
    except Exception:
        pass

    # Lenient path: line scan.
    for line in doc_text.splitlines():
        if not line.strip() or line.startswith((" ", "\t", "#")):
            continue
        m = KV_RE.match(line)
        if m:
            key, value = m.group(1).strip(), m.group(2).strip()
            if key and len(key.split()) <= 4:
                fields.append(SecretField(key=key, value=value))
    return fields


def build_secret(path: str, raw: str) -> Secret:
    name = path.rsplit("/", 1)[-1] if "/" in path else path
    docs: list[SecretDoc] = []
    for idx, text in split_docs(raw):
        # The first line is always the password, even if it resembles a field.
        fields = parse_fields("\n".join(text.splitlines()[1:]) if idx == 0 else text)
        docs.append(
            SecretDoc(raw=text, index=idx, fields=fields, is_plain=not fields and bool(text.strip()))
        )
    return Secret(path=path, name=name, docs=docs, raw=raw)


# ---------------------------------------------------------------------------
# Fuzzy matching
# ---------------------------------------------------------------------------


def fuzzy_score(query: str, text: str) -> Optional[float]:
    """Cheap fzf-ish subsequence score. Higher is better; None means no match."""
    if not query:
        return 0.0
    q, t = query.lower(), text.lower()
    if q in t:
        return 1000.0 - t.index(q) - len(t) * 0.01
    score = 0.0
    pos = 0
    for ch in q:
        found = t.find(ch, pos)
        if found == -1:
            return None
        if found == 0 or t[found - 1] in "/._- @:":
            score += 8
        else:
            score += 1
        pos = found + 1
    return score - len(t) * 0.01


