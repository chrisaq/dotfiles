        "prefix": "SelfHosted",
        "fields": [
            {"name": "host", "prompt": "Host", "default": ""},
            {"name": "user", "prompt": "User", "default": "root"},
            {"name": "port", "prompt": "Port", "default": "22"},
        ],
        "content": (
