class PromptScreen(ModalScreen[Optional[str]]):
    """Generic single-line prompt."""

    CSS = """
    PromptScreen { align: center middle; }
    #prompt-box {
        width: 72; min-width: 52; max-width: 92; height: auto;
        border: round $accent; background: $surface; padding: 1 2;
    }
    #prompt-title { text-style: bold; margin-bottom: 1; }
    #prompt-help { color: $text-muted; margin-top: 1; }
    """

    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, title: str, *, default: str = "", placeholder: str = "", help: str = "", password: bool = False) -> None:
        super().__init__()
        self._title = title
        self._default = default
        self._placeholder = placeholder
        self._help = help
        self._password = password

    def compose(self) -> ComposeResult:
        with Vertical(id="prompt-box"):
            yield Label(self._title, id="prompt-title", markup=False)
            yield Input(value=self._default, placeholder=self._placeholder, id="prompt-input", password=self._password)
            if self._help:
                yield Label(self._help, id="prompt-help")

    def on_mount(self) -> None:
        self.query_one(Input).focus()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        value = event.value if self._password else event.value.strip()
        self.dismiss(value or None)

    def action_cancel(self) -> None:
        self.dismiss(None)


class ConfirmScreen(ModalScreen[bool]):
    CSS = """
    ConfirmScreen { align: center middle; }
    #confirm-box {
        width: 68; min-width: 48; height: auto;
        border: round $error; background: $surface; padding: 1 2;
    }
    #confirm-title { text-style: bold; }
    #confirm-body { margin: 1 0; }
    #confirm-buttons { height: auto; content-align: center middle; }
    #confirm-buttons Button { margin: 0 1; }
    """

    BINDINGS = [
        Binding("escape", "no", "No"),
        Binding("y", "yes", "Yes"),
        Binding("n", "no", "No"),
    ]

    def __init__(self, title: str, body: str, *, danger: bool = True) -> None:
        super().__init__()
        self._title = title
        self._body = body
        self._danger = danger

    def compose(self) -> ComposeResult:
        with Vertical(id="confirm-box"):
            yield Label(self._title, id="confirm-title", markup=False)
            yield Label(self._body, id="confirm-body", markup=False)
            with Horizontal(id="confirm-buttons"):
                yield Button("Yes", variant="error" if self._danger else "primary", id="yes")
                yield Button("No", variant="primary", id="no")

    def on_mount(self) -> None:
        self.query_one("#no", Button).focus()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        self.dismiss(event.button.id == "yes")

    def action_yes(self) -> None:
        self.dismiss(True)

    def action_no(self) -> None:
        self.dismiss(False)


class TemplatePickerScreen(ModalScreen[Optional[Template]]):
    """Pick a template; shows a live preview of the rendered content."""

    CSS = """
    TemplatePickerScreen { align: center middle; }
    #tpl-box {
        width: 90%; max-width: 110; height: 85%;
        border: round $accent; background: $surface; padding: 1 2;
    }
    #tpl-title { text-style: bold; margin-bottom: 1; }
    #tpl-list { height: 1fr; border: round $panel; }
    #tpl-preview { height: 8; margin-top: 1; border: round $panel; overflow-y: auto; padding: 0 1; }
    """

    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, templates: list[Template]) -> None:
        super().__init__()
        self._templates = templates

    def compose(self) -> ComposeResult:
        with Vertical(id="tpl-box"):
            yield Label("New secret — choose a template", id="tpl-title")
            yield ListView(
                *[
                    ListItem(
                        Label(
                            Text.assemble(
                                (f"{t.name}", "bold"),
                                (f"  —  {t.description}" if t.description else "", "dim"),
                            )
                        ),
                        name=t.name,
                    )
                    for t in self._templates
                ],
                id="tpl-list",
            )
            yield Static("", id="tpl-preview")

    def on_mount(self) -> None:
        lv = self.query_one("#tpl-list")
        if self._templates:
            lv.index = 0
            self._show(0)
        lv.focus()

    def _show(self, idx: int) -> None:
        tpl = self._templates[idx]
        preview = tpl.content
        if "{{" in preview:
            for f in tpl.fields:
                preview = preview.replace("{{ " + f.name + " }}", f"<{f.name}>")
            preview = preview.replace("{{ password }}", "<password>")
        self.query_one("#tpl-preview", Static).update(
            syntax(preview, "yaml", self.app.theme)
        )

    @on(ListView.Selected, "#tpl-list")
    def _selected(self, event) -> None:
        if event.index is not None and 0 <= event.index < len(self._templates):
            self.dismiss(self._templates[event.index])

    def on_list_view_highlighted(self, event) -> None:
        # ListView.Highlighted carries `.item`, not `.index`.
        idx = event.list_view.index
        if idx is not None:
            self._show(idx)

    def action_cancel(self) -> None:
        self.dismiss(None)


class ShellTextArea(TextArea):
    """Shell editing keys, including a local kill buffer (no clipboard required)."""
    BINDINGS = [
        Binding("ctrl+b", "cursor_left", show=False), Binding("ctrl+f", "cursor_right", show=False),
        Binding("ctrl+p", "cursor_up", show=False), Binding("ctrl+n", "cursor_down", show=False),
        Binding("ctrl+k", "kill('end')", show=False), Binding("ctrl+u", "kill('start')", show=False),
        Binding("ctrl+w", "kill('word')", show=False), Binding("ctrl+y", "yank", show=False),
        Binding("ctrl+shift+z", "redo", show=False),
    ]
    killed = ""

    def action_kill(self, kind: str) -> None:
        row, col = self.cursor_location
        lines = self.text.split("\n")
        start, end = (row, col), (row, col)
        if kind == "end":
            end = (row, len(lines[row])) if col < len(lines[row]) else (min(row + 1, len(lines) - 1), 0)
        elif kind == "start":
            start = (row, 0)
        else:
            match = re.search(r"\S+\s*$", lines[row][:col])
            start = (row, match.start() if match else 0)
        self.killed = self.document.get_text_range(start, end)
        self.delete(start, end)

    def action_yank(self) -> None:
        self.insert(self.killed)



GUIDE = r"""
# Your password workbench

Keep using gopass for encryption, recipients, mounts and Git history. The TUI
browses paths and decrypts only selected entries. Search never decrypts the vault.

## Browse and find

Up/Down or j/k navigate. Right/l expands a directory; again enters its first
child. Left/h collapses it or moves to its parent. Enter opens an entry. Space
expands a node. There is one expansion arrow per folder.

Use `/` to search entry names, folders or full paths. Enter returns to the tree;
Escape clears the query, then returns focus. The view selector shows all entries,
session favorites, or recently opened entries. `*` toggles a favorite. These lists
are kept in memory and are not written to disk.

Directory selection shows a directory summary. Copy, edit, generation, move and
delete always target the selected entry; they never fall back to a previous one.

## Copy and reveal

| Key | Action |
| --- | --- |
| y / Y | Copy password / username |
| u / o | Copy URL / open website |
| F | Choose any field to copy (sensitive values remain masked in the list) |
| t | Copy one-time code |
| v | Temporarily reveal the current entry |
| Ctrl+L | Mask and forget cached plaintext |

Reveal expires after 30 seconds by default and is reset when you select another
entry. Losing terminal focus masks the preview by default. Locking clears the
preview and cache and pauses automatic decryption until you explicitly open an
entry. It does not lock your GPG agent or revoke its authentication.

The clipboard countdown is visible. The app clears its copy after the timeout or
on exit only if the clipboard still contains that value. Copying something else
is preserved. Clipboard managers can retain history independently of this app.

TOTP uses gopass, not a second implementation of your OTP secrets. The countdown
uses the entry's period when available. One-time codes never reveal the rest of
the entry. Do not expect a TOTP expiry countdown for HOTP counter-based tokens.

## Create and change entries

| Key | Action |
| --- | --- |
| n / d | New secret / new local empty directory |
| e / E | Preferred editor / built-in editor |
| P | Replace first-line password, preserving the entire remaining body |
| r / D | Move or rename / delete with confirmation |

Creation uses one form for template fields, entry path and password. Literal
passwords are masked while typing. Empty passwords generate a local 24-character
password. `generate:32`, `symbols:32`, and `gopass:32` are also supported.
`gopass:` uses non-writing `pwgen`, not temporary encrypted entries. Short literal
passwords require confirmation; their actual text is never shown in that prompt.

Review the raw content in the editor before creating the entry. Existing entry
paths always require overwrite confirmation. Moving onto another entry also
requires confirmation. Generation is local first, then a single gopass write;
metadata and extra documents are retained byte-for-byte after the first newline.
Empty local directories are conveniences and are not versioned by Git.

## Editor

`e` uses settings.editor or $EDITOR; `E` always uses the built-in editor.
The built-in editor keeps its buffer in memory. External editing uses a private
0700 directory and 0600 file, removed afterwards. External editors can still keep
swap, undo or backup data outside that directory; configure your editor for
sensitive files. A failed external editor never causes an automatic save.

| Key | Action |
| --- | --- |
| Ctrl+A / E | Start / end of line |
| Ctrl+B / F | Backward / forward character |
| Ctrl+P / N | Previous / next line |
| Ctrl+K / U / W | Kill to end / start / previous word |
| Ctrl+Y | Yank last killed text |
| Ctrl+Z / Ctrl+Shift+Z | Undo / redo |
| Ctrl+R | Find text, Enter next match |
| Ctrl+G | Close find |
| Ctrl+S | Save and return |
| Ctrl+Q / Escape | Cancel (confirm unsaved edits) |
| F1 | This reference |

The first line is the password. `---` may separate additional documents. Secrets
are not required to be valid YAML. Saving preserves raw text; extracted fields
are conveniences for copying, not a replacement serialization format.

## Themes and commands

Ctrl+T switches Catppuccin Macchiato / Latte. Ctrl+P opens the command palette.
Ctrl+R rescans the store; b expands the tree or content pane. F1 / ? opens help.
q quits outside text fields. Button actions and keyboard shortcuts share handlers.

Settings live in `$XDG_CONFIG_HOME/cq_pass/settings.yml`. Existing settings remain
compatible. Use Save preferences in the command palette to persist the current
theme and settings, with a backup. Nothing writes preferences on theme switching.

```yaml
theme: macchiato
animation: true
clip_timeout: 15
reveal_timeout: 30
cache_ttl: 60
mask_on_blur: true
reveal_by_default: false
# editor: nvim
# editor: builtin
```

Cache entries expire after cache_ttl seconds (0 disables caching), with a maximum
of 16 entries. Plaintext Python strings cannot be guaranteed to be securely zeroed.
The app does not log secret values or put them in status/error notifications.

Store selection: --store, settings.store, PASSWORD_STORE_DIR, configured gopass
root, then ~/.password-store. Native configuration and mounts are preserved for
the configured root. An alternate root uses private session configuration so it
cannot accidentally address your normal store. No native gopass config is changed.
"""


class HelpScreen(ModalScreen[None]):
    CSS = """
    HelpScreen { align: center middle; }
    #help-box { width: 90%; height: 88%; border: round $primary; background: $background; padding: 1 2; }
    #help-title { height: 2; color: $primary; text-style: bold; }
    #help-guide { height: 1fr; }
    #help-close { margin-top: 1; }
    """
    BINDINGS = [Binding("escape", "close", "Close"), Binding("f1", "close", "Close")]

    def __init__(self, *, editor: bool = False):
        super().__init__()
        self.editor = editor

    def compose(self) -> ComposeResult:
        with Vertical(id="help-box"):
            yield Label("Password workbench / " + ("editor shortcuts" if self.editor else "guide"), id="help-title")
            text = GUIDE
            if self.editor:
                text = GUIDE[GUIDE.index("## Editor"):GUIDE.index("## Themes and commands")]
            yield MarkdownViewer(text, id="help-guide", show_table_of_contents=not self.editor)
            yield Button("Close · Esc", id="help-close")

    @on(Button.Pressed, "#help-close")
    def action_close(self) -> None:
        self.dismiss(None)


class EditorScreen(ModalScreen[Optional[str]]):
    CSS = """
    EditorScreen { align: center middle; }
    #ed-box { width: 100%; height: 100%; background: $background; padding: 0 1; }
    #ed-head { height: 2; color: $primary; text-style: bold; }
    #ed-area { height: 1fr; border: round $primary; }
    #ed-foot { height: 2; color: $text-muted; content-align: center middle; }
    #ed-find { height: 3; }
    """
    BINDINGS = [
        Binding("escape", "cancel", "Cancel", priority=True),
        Binding("ctrl+q", "cancel", "Cancel", priority=True),
        Binding("ctrl+s", "save", "Save", priority=True),
        Binding("ctrl+r", "find", "Find", priority=True),
        Binding("ctrl+g", "cancel_find", "Cancel find", priority=True),
        Binding("f1", "help", "Keys", priority=True),
    ]

    def __init__(self, text: str, *, title: str = "Edit secret") -> None:
        super().__init__()
        self._text, self._title = text, title

    def compose(self) -> ComposeResult:
        with Vertical(id="ed-box"):
            yield Label(self._title, id="ed-head", markup=False)
            yield Input(placeholder="Find in this buffer · Enter next · Ctrl+G close", id="ed-find", classes="hidden")
            yield ShellTextArea(self._text, language="yaml", id="ed-area", show_line_numbers=True, tab_behavior="indent", soft_wrap=False)
            yield Static("Ctrl+S save · Ctrl+Q / Esc cancel · Ctrl+R find · F1 all keys", id="ed-foot")

    def on_mount(self) -> None:
        area = self.query_one(ShellTextArea)
        theme_editor(area, self.app.theme)
        area.border_title = "Secret editor · plaintext"
        area.border_subtitle = "Ctrl+A/E line edges · Ctrl+K/U/W kill · Ctrl+Y yank"
        area.focus()

    @on(TextArea.Changed)
    def changed(self) -> None:
        area = self.query_one(ShellTextArea)
        area.border_title = "Secret editor · unsaved" if area.text != self._text else "Secret editor · plaintext"

    def action_save(self) -> None:
        self.dismiss(self.query_one(TextArea).text)

    @work(group="editor-close", exclusive=True)
    async def action_cancel(self) -> None:
        if self.query_one(TextArea).text != self._text:
            if not await self.app.push_screen_wait(ConfirmScreen("Discard edits?", "Discard the changes made in this editor?")):
                return
        self.dismiss(None)

    def action_help(self) -> None:
        self.app.push_screen(HelpScreen(editor=True))

    def action_find(self) -> None:
        field = self.query_one("#ed-find", Input)
        field.remove_class("hidden")
        field.focus()

    def action_cancel_find(self) -> None:
        self.query_one("#ed-find").add_class("hidden")
        self.query_one(TextArea).focus()

    @on(Input.Submitted, "#ed-find")
    def find_text(self, event: Input.Submitted) -> None:
        needle = event.value
        if not needle:
            return
        area = self.query_one(TextArea)
        row, col = area.cursor_location
        offset = sum(len(line) + 1 for line in area.text.split("\n")[:row]) + col
        index = area.text.find(needle, offset)
        if index < 0:
            index = area.text.find(needle)
        if index < 0:
            self.notify("No match", severity="warning")
            return
        from textual.widgets.text_area import Selection
        def location(position: int) -> tuple[int, int]:
            return area.text.count("\n", 0, position), position - area.text.rfind("\n", 0, position) - 1
        area.selection = Selection(location(index), location(index + len(needle)))
        area.scroll_cursor_visible()


class NewSecretScreen(ModalScreen[Optional[tuple[dict[str, str], str, str]]]):
    CSS = """
    NewSecretScreen { align: center middle; }
    #new-box { width: 86%; max-width: 110; height: 90%; border: round $primary; background: $background; padding: 1 2; }
    #new-title { height: 2; text-style: bold; color: $primary; }
    #new-fields { height: 1fr; }
    #new-fields Label { height: auto; margin-top: 1; }
    #new-generator { height: 3; }
    #new-length { width: 12; }
    #new-symbols { width: auto; }
    #new-random { margin-left: 1; }
    #new-buttons { height: 3; margin-top: 1; align-horizontal: right; }
    #new-buttons Button { margin-left: 1; }
    #new-help { height: auto; color: $text-muted; }
    """
    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, template: Template, base: str):
        super().__init__()
        self.template, self.base = template, base
        self._last_suggestion = PassTUI._under(base, suggest_path(template, {}) or "new-entry")
        self._path_modified = False

    def compose(self) -> ComposeResult:
        with Vertical(id="new-box"):
            yield Label("New secret / " + self.template.name, id="new-title", markup=False)
            with VerticalScroll(id="new-fields"):
                for index, field in enumerate(self.template.fields):
                    yield Label(field.label + (" *" if field.required else ""), markup=False)
                    yield Input(value=field.default, id=f"new-value-{index}", password=bool(re.search(r"password|token|secret|totp", field.name, re.I)))
                yield Label("Entry path *")
                yield Input(value=self._last_suggestion, id="new-path")
                yield Label("Password · leave empty to generate 24 characters")
                yield Input(password=True, id="new-password", placeholder="Literal password, generate:32, symbols:32 or gopass:32")
                yield Checkbox("Show password while typing", id="new-show")
                with Horizontal(id="new-generator"):
                    yield Input("24", type="integer", id="new-length")
                    yield Checkbox("Symbols", id="new-symbols")
                    yield Button("Generate", id="new-random")
                yield Static("Generated locally; nothing is saved until you finish the editor.", id="new-help")
            with Horizontal(id="new-buttons"):
                yield Button("Cancel", id="new-cancel")
                yield Button("Review in editor", variant="primary", id="new-accept")

    @on(Input.Changed)
    def update_path(self, event: Input.Changed) -> None:
        if event.input.id == "new-path":
            if event.value != self._last_suggestion:
                self._path_modified = True
        elif event.input.id and event.input.id.startswith("new-value-") and not self._path_modified:
            values = {field.name: self.query_one(f"#new-value-{index}", Input).value for index, field in enumerate(self.template.fields)}
            self._last_suggestion = PassTUI._under(self.base, suggest_path(self.template, values) or "new-entry")
            self.query_one("#new-path", Input).value = self._last_suggestion

    @on(Checkbox.Changed, "#new-show")
    def show_password(self, event: Checkbox.Changed) -> None:
        self.query_one("#new-password", Input).password = not event.value

    @on(Button.Pressed, "#new-random")
    def generate(self) -> None:
        try:
            length = int(self.query_one("#new-length", Input).value)
            value = PassTUI._local_password(length, symbols=self.query_one("#new-symbols", Checkbox).value)
            self.query_one("#new-password", Input).value = value
            self.query_one("#new-help", Static).update(f"Generated {length} characters locally · still unsaved")
        except (CqPassError, ValueError) as error:
            self.notify(str(error) if isinstance(error, CqPassError) else "Enter a valid length", severity="warning")

    @on(Button.Pressed, "#new-accept")
    def accept(self) -> None:
        values = {field.name: self.query_one(f"#new-value-{index}", Input).value for index, field in enumerate(self.template.fields)}
        if any(field.required and not values[field.name].strip() for field in self.template.fields):
            self.notify("Fill in the required fields", severity="warning")
            return
        try:
            path = validate_entry_path(self.query_one("#new-path", Input).value.strip())
        except CqPassError as error:
            self.notify(str(error), severity="warning")
            return
        self.dismiss((values, path, self.query_one("#new-password", Input).value))

    @on(Button.Pressed, "#new-cancel")
    def action_cancel(self) -> None:
        self.dismiss(None)


class FieldPickerScreen(ModalScreen[Optional[int]]):
    CSS = """
    FieldPickerScreen { align: center middle; }
    #field-box { width: 85%; max-width: 110; height: 75%; border: round $primary; background: $background; padding: 1 2; }
    #field-title { height: 2; color: $primary; text-style: bold; }
    #field-list { height: 1fr; }
    #field-hint { height: 2; color: $text-muted; }
    """
    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, fields: list[tuple[str, str]]):
        super().__init__()
        self.fields = fields

    def compose(self) -> ComposeResult:
        with Vertical(id="field-box"):
            yield Label("Copy field", id="field-title")
            yield ListView(*[ListItem(Label(label, markup=False)) for label, _ in self.fields], id="field-list")
            yield Static("Enter copies the chosen field · values stay masked · Esc cancels", id="field-hint")

    def on_mount(self) -> None:
        self.query_one(ListView).focus()

    @on(ListView.Selected, "#field-list")
    def selected(self, event: ListView.Selected) -> None:
        self.dismiss(event.index)

    def action_cancel(self) -> None:
        self.dismiss(None)


PASS_ACTIONS = {
    "copy_password": ("Copy password", "y"), "copy_username": ("Copy username", "Y"),
    "copy_url": ("Copy URL", "u"), "copy_field": ("Choose field to copy", "F"),
    "open_url": ("Open website", "o"), "totp": ("Copy one-time code", "t"),
    "toggle_reveal": ("Temporarily reveal entry", "v"), "lock": ("Mask and forget plaintext", "ctrl+l"),
    "new_secret": ("Create secret", "n"), "new_folder": ("Create local folder", "d"),
    "edit_secret": ("Edit with preferred editor", "e"), "edit_builtin": ("Edit with built-in editor", "E"),
    "generate": ("Replace password", "P"), "rename_move": ("Move or rename entry", "r"),
    "delete_secret": ("Delete entry", "D"), "favorite": ("Toggle session favorite", "*"),
    "rescan": ("Rescan store", "ctrl+r"), "theme": ("Toggle Latte / Macchiato", "ctrl+t"),
    "save_preferences": ("Save preferences", ""), "panes": ("Expand browser panes", "b"),
    "help": ("Read the guide", "f1"), "quit": ("Quit", "q"),
}


class PassCommands(Provider):
    async def discover(self) -> Hits:
        for name, (title, key) in PASS_ACTIONS.items():
            yield DiscoveryHit(title, lambda name=name: self.app.dispatch(name), help=key)

    async def search(self, query: str) -> Hits:
        matcher = self.matcher(query)
        for name, (title, key) in PASS_ACTIONS.items():
            if score := matcher.match(title):
                yield Hit(score, matcher.highlight(title), lambda name=name: self.app.dispatch(name), help=key)


def mutation_action(function):
    """One write workflow at a time; never cancel a running backend write."""
    @wraps(function)
    async def guarded(self, *args, **kwargs):
        if self._mutation_busy:
            self._status("Finish the current change first", "warn")
            return
        self._mutation_busy = True
        try:
            return await function(self, *args, **kwargs)
        except (CqPassError, OSError, ValueError):
            self._status("Could not complete this change; entry was not reported as saved", "err")
        finally:
            self._mutation_busy = False
    return guarded


