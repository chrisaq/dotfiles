# Main app
# ---------------------------------------------------------------------------


class VaultTree(Tree):
    # Override ScrollView's horizontal scrolling at the focused widget, before
    # it can consume these keys instead of the app's directory navigation.
    BINDINGS = [
        Binding("left", "app.vi_left", "Collapse", show=False),
        Binding("right", "app.vi_right", "Expand", show=False),
    ]


class PassTUI(App):
    TITLE = APP_NAME

    COMMANDS = {PassCommands}
    CSS = """
    Screen { background: $background; color: $text; }
    #topbar { height: 3; background: $surface; padding: 0 1; align-vertical: middle; }
    #brand { width: 1fr; height: 3; content-align: left middle; color: $primary; text-style: bold; }
    #theme-button { width: 14; min-width: 14; }
    #top { height: 1; background: $panel; padding: 0 2; }
    #top-label { height: 1; width: 1fr; }
    #filter-bar { height: 3; padding: 0 1; }
    #filter { width: 1fr; }
    #view { width: 23; margin-left: 1; }
    #main { height: 1fr; padding: 0 1; }
