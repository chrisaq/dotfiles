DEFAULT_TEMPLATES: list[dict[str, Any]] = [
    {
        "name": "Empty",
        "description": "Just a password. No body.",
        "prefix": "",
        "fields": [],
        "content": "{{ password }}\n",
    },
    {
        "name": "Website login",
        "description": "Username + password + URL, under Accounts/.",
        "prefix": "Accounts",
        "fields": [
            {"name": "domain", "prompt": "Domain", "default": ""},
            {"name": "username", "prompt": "Username", "default": ""},
        ],
        "content": (
            "{{ password }}\n"
            "---\n"
            "username: {{ username }}\n"
            "url: https://{{ domain }}\n"
        ),
    },
    {
        "name": "API token",
        "description": "Service + token (+ optional URL).",
        "prefix": "Accounts/api",
        "fields": [
            {"name": "service", "prompt": "Service", "default": ""},
            {"name": "url", "prompt": "API URL", "required": False, "default": ""},
        ],
        "content": (
            "{{ password }}\n"
            "---\n"
            "service: {{ service }}\n"
            "url: {{ url }}\n"
        ),
    },
