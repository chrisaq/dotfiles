        "fields": [
            {"name": "authority", "prompt": "Authority", "default": ""},
            {"name": "application", "prompt": "Application", "default": ""},
        ],
        "content": (
            "{{ password }}\n"
            "---\n"
            "authority: {{ authority }}\n"
            "application: {{ application }}\n"
        ),
    },
]


def ensure_config() -> None:
    """Create the config dir and default templates on first run."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    TEMPLATE_DIR.mkdir(parents=True, exist_ok=True)
    if not SETTINGS_FILE.exists():
        SETTINGS_FILE.write_text(
            yaml.safe_dump(
                {
                    "clip_timeout": 15,
                    "reveal_by_default": False,
                    "# editor": "defaults to $EDITOR, then nvim",
                },
                sort_keys=False,
            )
        )
    if not any(TEMPLATE_DIR.glob("*.yml")) and not any(TEMPLATE_DIR.glob("*.yaml")):
        for tpl in DEFAULT_TEMPLATES:
            slug = re.sub(r"[^a-z0-9]+", "-", tpl["name"].lower()).strip("-")
            path = TEMPLATE_DIR / f"{slug}.yml"
            payload = {k: v for k, v in tpl.items()}
            path.write_text(
                "# cq_pass-tui secret template\n" + yaml.safe_dump(payload, sort_keys=False),
            )


def load_templates() -> list[Template]:
    ensure_config()
    templates: list[Template] = []
    for path in sorted(list(TEMPLATE_DIR.glob("*.yml")) + list(TEMPLATE_DIR.glob("*.yaml"))):
        try:
            data = yaml.safe_load(path.read_text()) or {}
            if not isinstance(data, dict):
                continue
            data.setdefault("name", path.stem)
            data["filename"] = path.name
            templates.append(Template.model_validate(data))
        except (ValidationError, yaml.YAMLError) as exc:
            # A broken template must not take the whole app down.
            templates.append(
                Template(
                    name=f"{path.stem} (invalid: {str(exc).splitlines()[0][:60]})",
                    description="This template failed to parse and cannot be used.",
                    content="{{ password }}",
                    filename=path.name,
                )
            )
    if not templates:
        templates = [Template.model_validate({**t, "filename": "<builtin>"}) for t in DEFAULT_TEMPLATES]
    # Empty template first — it is the default.
    templates.sort(key=lambda t: (not t.is_empty, t.name.lower()))
    return templates


def render_template(tpl: Template, values: dict[str, str], password: str) -> str:
    ctx = {f.name: values.get(f.name, "") for f in tpl.fields}
    ctx["password"] = password

    def sub(match: re.Match[str]) -> str:
        key = match.group(1).strip()
        return str(ctx.get(key, match.group(0)))

    text = re.sub(r"\{\{\s*([\w_]+)\s*\}\}", sub, tpl.content)
    if not text.endswith("\n"):
        text += "\n"
    return text


def suggest_path(tpl: Template, values: dict[str, str]) -> str:
    parts: list[str] = []
    if tpl.prefix:
        parts.append(tpl.prefix.strip("/"))
    for key in ("domain", "service", "host", "authority", "application", "name"):
        v = values.get(key, "").strip()
        if v:
            parts.append(v.strip("/"))
            break
    user = values.get("username", "").strip()
    if user:
        parts.append(user.strip("/"))
    return "/".join(p for p in parts if p)


# ---------------------------------------------------------------------------
# Clipboard
# ---------------------------------------------------------------------------


def clip_tool() -> Optional[tuple[str, list[str]]]:
    """Return (tool, args) able to copy, or None."""
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy"):
        return ("wl-copy", ["wl-copy"])
    for name in ("wl-copy", "xclip", "xsel"):
        if shutil.which(name):
            if name == "xclip":
                return (name, [name, "-selection", "clipboard"])
            if name == "xsel":
                return (name, [name, "--clipboard", "--input"])
            return (name, [name])
    return None


def copy_text(text: str, *, primary: bool = False) -> None:
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy"):
        args = ["wl-copy", "--primary"] if primary else ["wl-copy"]
        subprocess.run(args, input=text, text=True, check=False)
        return
    for name in ("xclip", "xsel"):
        if shutil.which(name):
            args = (
                [name, "-selection", "primary"]
                if primary
                else ([name, "--primary", "--input"] if name == "xsel" else [name, "-selection", "clipboard"])
            )
            subprocess.run(args, input=text, text=True, check=False)
            return
    raise CqPassError("No clipboard tool found (need wl-copy, xclip or xsel)")


def clear_clipboard() -> None:
    try:
        if shutil.which("wl-copy"):
            subprocess.run(["wl-copy", "-c"], check=False)
        elif shutil.which("xclip"):
            subprocess.run(["xclip", "-selection", "clipboard", "-i", "/dev/null"], check=False)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# UI helpers
# ---------------------------------------------------------------------------


def doc_renderable(doc: SecretDoc, reveal: bool) -> Any:
    """Nice-looking rendering of one document."""
    text = doc.raw if (reveal or not doc.raw.strip()) else mask_doc(
        doc.raw, doc.fields, mask_first_line=(doc.index == 0)
    )
    if not text.strip():
        return Text("(empty)", style="dim italic")
    return Syntax(
        text,
        "yaml",
        theme="monokai" if not reveal else "dracula",
        word_wrap=True,
        background_color="default",
        line_numbers=False,
    )


def secret_renderable(secret: Secret, reveal: bool) -> Any:
    parts: list[Any] = []
    for i, doc in enumerate(secret.docs):
        if i:
            parts.append(Text(""))
            parts.append(Rule(style="grey37", characters="─"))
            parts.append(Text(f"  document {i + 1}", style="bold cyan"))
        parts.append(doc_renderable(doc, reveal))
    return Group(*parts)


# ---------------------------------------------------------------------------
# Modal screens
# ---------------------------------------------------------------------------


class PromptScreen(ModalScreen[Optional[str]]):
    """Generic single-line prompt."""

    CSS = """
    PromptScreen { align: center middle; }
    #prompt-box {
        width: 72; min-width: 52; max-width: 92; height: auto;
        border: round $accent; background: $surface; padding: 1 2;
    }
    #prompt-title { text-style: bold; margin-bottom: 1; }
    #prompt-help { color: $text-muted; margin-top: 1; }
    """

    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, title: str, *, default: str = "", placeholder: str = "", help: str = "") -> None:
        super().__init__()
        self._title = title
        self._default = default
        self._placeholder = placeholder
        self._help = help

    def compose(self) -> ComposeResult:
        with Vertical(id="prompt-box"):
            yield Label(self._title, id="prompt-title")
            yield Input(value=self._default, placeholder=self._placeholder, id="prompt-input")
            if self._help:
                yield Label(self._help, id="prompt-help")

    def on_mount(self) -> None:
        self.query_one(Input).focus()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        value = event.value.strip()
        self.dismiss(value or None)

    def action_cancel(self) -> None:
        self.dismiss(None)


class ConfirmScreen(ModalScreen[bool]):
    CSS = """
    ConfirmScreen { align: center middle; }
    #confirm-box {
        width: 68; min-width: 48; height: auto;
        border: round $error; background: $surface; padding: 1 2;
    }
    #confirm-title { text-style: bold; }
    #confirm-body { margin: 1 0; }
    #confirm-buttons { height: auto; content-align: center middle; }
    #confirm-buttons Button { margin: 0 1; }
    """

    BINDINGS = [
        Binding("escape", "no", "No"),
        Binding("y", "yes", "Yes"),
        Binding("n", "no", "No"),
    ]

    def __init__(self, title: str, body: str, *, danger: bool = True) -> None:
        super().__init__()
        self._title = title
        self._body = body

    def compose(self) -> ComposeResult:
        with Vertical(id="confirm-box"):
            yield Label(self._title, id="confirm-title")
            yield Label(self._body, id="confirm-body")
            with Horizontal(id="confirm-buttons"):
                yield Button("Yes", variant="error", id="yes")
                yield Button("No", variant="primary", id="no")

    def on_mount(self) -> None:
        self.query_one("#no", Button).focus()

    def on_button_pressed(self, event: Button.Pressed) -> None:
        self.dismiss(event.button.id == "yes")

    def action_yes(self) -> None:
        self.dismiss(True)

    def action_no(self) -> None:
        self.dismiss(False)


class TemplatePickerScreen(ModalScreen[Optional[Template]]):
    """Pick a template; shows a live preview of the rendered content."""

    CSS = """
    TemplatePickerScreen { align: center middle; }
    #tpl-box {
        width: 3fr; min-width: 78; max-width: 110; height: 30;
        border: round $accent; background: $surface; padding: 1 2;
    }
    #tpl-title { text-style: bold; margin-bottom: 1; }
    #tpl-list { height: 1fr; border: round $panel; }
    #tpl-preview { height: 8; margin-top: 1; border: round $panel; overflow-y: auto; padding: 0 1; }
    """

    BINDINGS = [Binding("escape", "cancel", "Cancel")]

    def __init__(self, templates: list[Template]) -> None:
        super().__init__()
        self._templates = templates

    def compose(self) -> ComposeResult:
        with Vertical(id="tpl-box"):
            yield Label("New secret — choose a template", id="tpl-title")
            yield ListView(
                *[
                    ListItem(
                        Label(
                            Text.assemble(
                                (f"{t.name}", "bold"),
                                (f"  —  {t.description}" if t.description else "", "dim"),
                            )
                        ),
                        name=t.name,
                    )
                    for t in self._templates
                ],
                id="tpl-list",
            )
            yield Static("", id="tpl-preview")

    def on_mount(self) -> None:
        lv = self.query_one("#tpl-list")
        if self._templates:
            lv.index = 0
            self._show(0)
        lv.focus()

    def _show(self, idx: int) -> None:
        tpl = self._templates[idx]
        preview = tpl.content
        if "{{" in preview:
            for f in tpl.fields:
                preview = preview.replace("{{ " + f.name + " }}", f"<{f.name}>")
            preview = preview.replace("{{ password }}", "<password>")
        self.query_one("#tpl-preview", Static).update(
            Syntax(preview, "yaml", theme="monokai", background_color="default")
        )

    @on(ListView.Selected, "#tpl-list")
    def _selected(self, event) -> None:
        if event.index is not None and 0 <= event.index < len(self._templates):
            self.dismiss(self._templates[event.index])

    def on_list_view_highlighted(self, event) -> None:
        # ListView.Highlighted carries `.item`, not `.index`.
        idx = event.list_view.index
        if idx is not None:
            self._show(idx)

    def action_cancel(self) -> None:
        self.dismiss(None)


class EditorScreen(ModalScreen[Optional[str]]):
    """Built-in editor used when $EDITOR is unset/unavailable."""

    CSS = """
    EditorScreen { align: center middle; }
    #ed-box {
        width: 90%; height: 88%;
        border: round $accent; background: $surface; padding: 1 1 0 1;
    }
    #ed-head { height: 1; }
    #ed-area { height: 1fr; border: round $panel; }
    """

    BINDINGS = [
        Binding("escape", "cancel", "Cancel", priority=True),
        Binding("ctrl+s", "save", "Save"),
    ]

    def __init__(self, text: str, *, title: str = "Edit secret") -> None:
        super().__init__()
        self._text = text
        self._title = title

    def compose(self) -> ComposeResult:
        with Vertical(id="ed-box"):
            yield Label(
                Text.assemble(
                    (self._title, "bold"),
                    ("   Ctrl+S save · Esc cancel", "dim"),
                ),
                id="ed-head",
            )
            yield TextArea(self._text, language="yaml", id="ed-area")

    def on_mount(self) -> None:
        self.query_one(TextArea).focus()

    def action_save(self) -> None:
        self.dismiss(self.query_one(TextArea).text)

    def action_cancel(self) -> None:
        self.dismiss(None)


class HelpScreen(ModalScreen[None]):
    """Key reference. Rendered as a table so columns always align."""

    CSS = """
    HelpScreen { align: center middle; }
    #help-box {
        width: 100; max-width: 118; height: auto;
        border: round $accent; background: $surface; padding: 1 3;
    }
    #help-title { content-align: center middle; margin-bottom: 1; }
    #help-foot { content-align: center middle; margin-top: 1; color: $text-muted; }
    """

    BINDINGS = [Binding("escape, q, question_mark", "close", "Close")]

    SECTIONS: list[tuple[str, list[tuple[str, str]]]] = [
        (
            "Navigate",
            [
                ("j / ↓", "down"),
                ("k / ↑", "up"),
                ("h / ←", "collapse · parent"),
                ("l / →", "expand folder"),
                ("enter", "open · copy password"),
                ("space", "toggle node"),
                ("shift+space", "toggle all"),
                ("tab", "switch pane"),
            ],
        ),
        (
            "Search",
            [
                ("/", "filter vault"),
                ("esc", "clear filter"),
            ],
        ),
        (
            "Copy & open",
            [
                ("y", "copy password"),
                ("Y", "copy username"),
                ("u", "copy URL"),
                ("o", "open URL in browser"),
                ("t", "TOTP code"),
                ("v", "toggle reveal"),
            ],
        ),
        (
            "Vault",
            [
                ("n", "new secret"),
                ("d", "new folder"),
                ("e", "edit ($EDITOR / built-in)"),
                ("P", "generate password"),
                ("r", "rename / move"),
                ("D", "delete"),
            ],
        ),
        (
            "App",
            [
                ("ctrl+r", "rescan store"),
                ("?", "this help"),
                ("q", "quit"),
            ],
        ),
    ]

    def _build(self) -> Table:
        table = Table(
            box=None,
            show_header=False,
            pad_edge=False,
            padding=(0, 2),
            collapse_padding=True,
            expand=True,
        )
        table.add_column(justify="right", style="bold bright_cyan", no_wrap=True, width=12)
        table.add_column(style="grey78", no_wrap=True, ratio=1)
        table.add_column(justify="right", style="bold bright_cyan", no_wrap=True, width=12)
        table.add_column(style="grey78", no_wrap=True, ratio=1)

        for title, pairs in self.SECTIONS:
            table.add_row(Text(title, style="bold cyan", justify="left"), "", "", "")
            half = (len(pairs) + 1) // 2
            left, right = pairs[:half], pairs[half:]
            for i in range(half):
                lk, ld = left[i]
                rk, rd = right[i] if i < len(right) else ("", "")
                table.add_row(lk, ld, rk, rd)
            table.add_section()

        return table

    def compose(self) -> ComposeResult:
        with Vertical(id="help-box"):
            yield Label(Text("cq_pass-tui  ·  keyboard", style="bold cyan"), id="help-title")
            yield Static(self._build(), id="help-body")
            yield Label(Text("esc / q to close", style="dim"), id="help-foot")

    def action_close(self) -> None:
        self.dismiss(None)


