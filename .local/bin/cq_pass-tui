def ensure_config() -> None:
    """Create the config dir and default templates on first run."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    TEMPLATE_DIR.mkdir(parents=True, exist_ok=True)
    if not SETTINGS_FILE.exists():
        SETTINGS_FILE.write_text(
            "# cq_pass-tui settings\n"
            "# editor: command used for 'e'; falls back to $EDITOR, then the built-in editor.\n"
            + yaml.safe_dump(
                {
                    "clip_timeout": 15,
                    "reveal_by_default": False,
                },
                sort_keys=False,
            )
        )
    if not any(TEMPLATE_DIR.glob("*.yml")) and not any(TEMPLATE_DIR.glob("*.yaml")):
        for tpl in DEFAULT_TEMPLATES:
            slug = re.sub(r"[^a-z0-9]+", "-", tpl["name"].lower()).strip("-")
            path = TEMPLATE_DIR / f"{slug}.yml"
            payload = {k: v for k, v in tpl.items()}
            path.write_text(
                "# cq_pass-tui secret template\n" + yaml.safe_dump(payload, sort_keys=False),
            )


def load_templates() -> list[Template]:
    ensure_config()
    templates: list[Template] = []
    for path in sorted(list(TEMPLATE_DIR.glob("*.yml")) + list(TEMPLATE_DIR.glob("*.yaml"))):
        try:
            data = yaml.safe_load(path.read_text()) or {}
            if not isinstance(data, dict):
                continue
            data.setdefault("name", path.stem)
            data["filename"] = path.name
            templates.append(Template.model_validate(data))
        except (ValidationError, yaml.YAMLError) as exc:
            # A broken template must not take the whole app down.
            templates.append(
                Template(
                    name=f"{path.stem} (invalid: {str(exc).splitlines()[0][:60]})",
                    description="This template failed to parse and cannot be used.",
                    content="{{ password }}",
                    filename=path.name,
                    valid=False,
                )
            )
    if not templates:
        templates = [Template.model_validate({**t, "filename": "<builtin>"}) for t in DEFAULT_TEMPLATES]
    # Empty template first — it is the default.
    templates.sort(key=lambda t: (not t.is_empty, t.name.lower()))
    return templates


def render_template(tpl: Template, values: dict[str, str], password: str) -> str:
    ctx = {f.name: values.get(f.name, "") for f in tpl.fields}
    ctx["password"] = password

    def sub(match: re.Match[str]) -> str:
        key = match.group(1).strip()
        return str(ctx.get(key, match.group(0)))

    text = re.sub(r"\{\{\s*([\w_]+)\s*\}\}", sub, tpl.content)
    if not text.endswith("\n"):
        text += "\n"
    return text


def suggest_path(tpl: Template, values: dict[str, str]) -> str:
    parts: list[str] = []
    if tpl.prefix:
        parts.append(tpl.prefix.strip("/"))
    for key in ("domain", "service", "host", "authority", "application", "name"):
        v = values.get(key, "").strip()
        if v:
            parts.append(v.strip("/"))
            break
    user = values.get("username", "").strip()
    if user:
        parts.append(user.strip("/"))
    return "/".join(p for p in parts if p)


# ---------------------------------------------------------------------------
# Clipboard
# ---------------------------------------------------------------------------


def clipboard_command(operation: str, primary: bool = False) -> list[str]:
    selection = "primary" if primary else "clipboard"
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy") and shutil.which("wl-paste"):
        args = {"copy": ["wl-copy"], "read": ["wl-paste", "--no-newline"], "clear": ["wl-copy", "--clear"]}[operation]
        return args + (["--primary"] if primary else [])
    if shutil.which("xclip"):
        return ["xclip", "-selection", selection] + {"copy": ["-in"], "read": ["-out"], "clear": ["-in", "/dev/null"]}[operation]
    if shutil.which("xsel"):
        return ["xsel", "--" + selection] + {"copy": ["--input"], "read": ["--output"], "clear": ["--clear"]}[operation]
    raise CqPassError("No clipboard backend available (wl-copy + wl-paste, xclip, or xsel)")


def copy_text(text: str, *, primary: bool = False) -> None:
    try:
        result = subprocess.run(clipboard_command("copy", primary), input=text, text=True,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise CqPassError("Clipboard copy could not complete") from exc
    if result.returncode:
        raise CqPassError("Clipboard copy failed")


def clipboard_matches(fingerprint: bytes) -> bool:
    try:
        result = subprocess.run(clipboard_command("read"), capture_output=True, timeout=2)
        return result.returncode == 0 and hashlib.sha256(result.stdout).digest() == fingerprint
    except (OSError, CqPassError, subprocess.TimeoutExpired):
        return False


def clear_clipboard() -> None:
    try:
        subprocess.run(clipboard_command("clear"), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except (OSError, CqPassError, subprocess.TimeoutExpired):
        pass


# ---------------------------------------------------------------------------
# UI helpers
# ---------------------------------------------------------------------------

PALETTES = {
    "macchiato": {"base": "#24273a", "mantle": "#1e2030", "surface": "#363a4f",
                  "text": "#cad3f5", "muted": "#a5adcb", "blue": "#8aadf4",
                  "mauve": "#c6a0f6", "green": "#a6da95", "yellow": "#eed49f", "red": "#ed8796"},
    "latte": {"base": "#eff1f5", "mantle": "#e6e9ef", "surface": "#ccd0da",
              "text": "#4c4f69", "muted": "#6c6f85", "blue": "#1e66f5",
              "mauve": "#8839ef", "green": "#40a02b", "yellow": "#df8e1d", "red": "#d20f39"},
}


def syntax(text: str, lexer: str, theme: str, **kwargs: Any) -> Syntax:
    """Use Catppuccin for source and diff tokens, including inserted/deleted lines."""
    from pygments.style import Style as PygmentsStyle
    from pygments.token import Comment, Error, Generic, Keyword, Literal, Name, Operator, Token
    from rich.syntax import PygmentsSyntaxTheme
    p = PALETTES.get(theme, PALETTES["macchiato"])
    style = type("CatppuccinSyntax", (PygmentsStyle,), {
        "background_color": p["base"], "styles": {
            Token: p["text"], Comment: f"italic {p['muted']}", Keyword: p["mauve"],
            Name.Function: p["blue"], Name.Builtin: p["blue"], Name.Tag: p["blue"],
            Name.Attribute: p["yellow"], Literal.String: p["green"], Literal.Number: p["yellow"],
            Operator: p["blue"], Error: p["red"], Generic.Deleted: p["red"],
            Generic.Inserted: p["green"], Generic.Heading: f"bold {p['blue']}",
            Generic.Subheading: f"bold {p['mauve']}", Generic.Emph: "italic", Generic.Strong: "bold",
        }})
    return Syntax(text, lexer, theme=PygmentsSyntaxTheme(style), background_color=p["base"], **kwargs)


def theme_editor(area: TextArea, theme: str) -> None:
    from rich.style import Style
    from textual.widgets.text_area import TextAreaTheme
    p = PALETTES.get(theme, PALETTES["macchiato"])
    colours = {"comment": "muted", "keyword": "mauve", "string": "green", "number": "yellow",
               "float": "yellow", "boolean": "yellow", "function": "blue", "function.call": "blue",
               "type": "yellow", "operator": "blue", "variable": "text", "constant": "yellow",
               "punctuation.bracket": "muted", "punctuation.delimiter": "muted", "property": "blue",
               "tag": "blue", "attribute": "yellow", "heading": "blue"}
    area.register_theme(TextAreaTheme(
        name="catppuccin-" + theme, base_style=Style(color=p["text"], bgcolor=p["base"]),
        gutter_style=Style(color=p["muted"], bgcolor=p["mantle"]),
        cursor_style=Style(color=p["base"], bgcolor=p["text"]),
        cursor_line_style=Style(bgcolor=p["mantle"]),
        selection_style=Style(bgcolor=p["surface"]),
        syntax_styles={token: Style(color=p[colour], italic=token == "comment") for token, colour in colours.items()},
    ))
    area.theme = "catppuccin-" + theme



def doc_renderable(doc: SecretDoc, reveal: bool, theme: str = "macchiato") -> Any:
    """Nice-looking rendering of one document."""
    text = doc.raw if (reveal or not doc.raw.strip()) else mask_doc(
        doc.raw, mask_first_line=(doc.index == 0)
    )
    if not text.strip():
        return Text("(empty)", style="dim italic")
    return syntax(text, "yaml", theme, word_wrap=True, line_numbers=False)


def secret_renderable(secret: Secret, reveal: bool, theme: str = "macchiato") -> Any:
    parts: list[Any] = []
    for i, doc in enumerate(secret.docs):
        if i:
            parts.append(Text(""))
            parts.append(Rule(style="grey37", characters="─"))
            parts.append(Text(f"  document {i + 1}", style="bold cyan"))
        parts.append(doc_renderable(doc, reveal, theme))
    return Group(*parts)


