    .form-dialog .form-fields { height: auto; max-height: 25; }
    #commit-message { height: 6; border: round $primary-muted; margin-top: 1; }
    #editor-frame { width: 100%; height: 100%; padding: 0 1; background: $background; }
    #editor-title { height: 2; color: $primary; text-style: bold; padding: 0 1; content-align: left middle; }
    #editor-area { height: 1fr; border: round $primary; }
    #editor-hints { height: 2; color: $text-muted; content-align: center middle; }
    #editor-find { height: 3; }
    """

    def __init__(self, settings: Settings, filename: Path, initial_repo: str | None = None):
        super().__init__()
        self.settings, self.filename = settings, filename
        self.repositories = {name: Repository(name, settings) for name in settings.repositories}
        self.repo_name = initial_repo or next(iter(self.repositories))
        if self.repo_name not in self.repositories:
            raise DotError(f"Unknown repository {self.repo_name!r}")
        self.marked: set[Path] = set()
        self.nodes: dict[Path, Any] = {}
        self.loaded: set[Path] = set()
        self.preview_mode = "auto"
        self.pane_mode = 0
        self.filter_text = ""
        self.scope_filter = "all"
        self.show_hidden = True
        self.busy = False
        self.refreshing = False
        self.activity_text = "Ready · choose a file to inspect"
        self.frame = 0
        self.findings: list[Finding] = []
        self._last_changes: Any = None
        self._last_preview: Any = None
        self._activity_widget: Static | None = None
        self._first_refresh = True
        self._explicit_repo = initial_repo is not None
        for name, p in PALETTES.items():
            self.register_theme(Theme(name=name, primary=p["blue"], secondary=p["mauve"], accent=p["mauve"],
                                      foreground=p["text"], background=p["base"], surface=p["mantle"], panel=p["surface"],
                                      success=p["green"], warning=p["yellow"], error=p["red"], dark=name == "macchiato"))
        self.theme = settings.theme
        self.animation_level = "full" if settings.animation else "none"

    @property
    def repo(self) -> Repository:
        return self.repositories[self.repo_name]

    @property
    def palette(self) -> dict[str, str]:
        return PALETTES[self.theme if self.theme in PALETTES else "macchiato"]

    def compose(self) -> ComposeResult:
        with Horizontal(id="topbar"):
            yield Static("◈  DOTFILES  /  workbench" if self.settings.glyphs else "DOTFILES / workbench", id="brand")
            yield Select([(name, name) for name in self.repositories], value=self.repo_name, allow_blank=False, id="repo-select")
            yield Button("☀ Latte" if self.theme == "macchiato" else "☾ Dark", id="theme-button")
        yield Static("Reading local repository state…", id="statusbar", markup=False)
        with TabbedContent(initial="browser", id="workspace"):
            with TabPane("Browser", id="browser"):
                with Horizontal(id="browser-tools"):
                    yield Input(placeholder="/ Filter paths…", id="path-filter")
                    yield Select([("All files", "all"), ("Tracked", "tracked"), ("Changed", "changed")], value="all", allow_blank=False, id="scope-filter")
                    yield Checkbox("Hidden", value=True, id="show-hidden")
                with Horizontal(id="browser-panes"):
                    with Vertical(id="tree-box"):
                        yield FileTree("~", data=self.settings.home, id="files")
                    with Vertical(id="preview-box"):
                        yield Static("Automatic preview", id="preview-meta", markup=False)
                        with VerticalScroll(id="preview-scroll", can_focus=True):
                            yield Static("Select a file or directory", id="preview-content", markup=False)
                with Horizontal(id="actionbar"):
                    yield Button("a  Stage", id="do-stage")
                    yield Button("e  Edit", id="do-edit")
                    yield Button("c  Commit", id="do-commit", variant="primary")
                    yield Button("p  Push", id="do-push")
            with TabPane("Changes", id="changes"):
                yield Static("Repository changes", classes="page-title", id="changes-title")
                yield Static("Select a row to inspect it in Browser. Stage and commit actions use the active repository.", classes="page-copy")
                yield DataTable(id="changes-table", cursor_type="row", zebra_stripes=True)
                with Horizontal(classes="page-buttons"):
                    yield Button("Stage selected", id="changes-stage")
                    yield Button("Unstage selected", id="changes-unstage")
                    yield Button("Commit…", id="changes-commit", variant="primary")
                    yield Button("Commit & push…", id="changes-commit_push")
            with TabPane("Setup", id="setup"):
                with VerticalScroll():
                    yield Static("Build your dotfiles system", classes="page-title")
                    yield Static("Keep files in place. Give shared and machine-specific configuration separate Git histories.\nCreate, attach, or clone; review changes before applying them.", classes="page-copy")
                    for name, repo in self.repositories.items():
                        with Vertical(classes="setup-card"):
                            yield Label(name, classes="dialog-title", markup=False)
                            yield Static(display_path(repo.git_dir), markup=False, id=f"setup-path-{list(self.repositories).index(name)}")
                            yield Static("Shared configuration" if name == "dotfiles" else "Machine-specific configuration" if name == "dotlocal" else "Additional repository", classes="hint")
                            yield Button(f"Set up {name}…", name=name, classes="setup-open", variant="primary")
                    yield Static("Shell integration is optional. Health offers reviewed fixes for aliases and completion.\nAttaching preserves existing repository settings and does not check out files.", classes="page-copy")
            with TabPane("Health", id="health"):
                yield Static("System health", classes="page-title")
                yield Static("Local checks only. Shell startup files are inspected, never executed.", classes="page-copy")
                with Horizontal(classes="page-buttons"):
                    yield Button("Run checks", id="health-run", variant="primary")
                    yield Button("Review shell repair…", id="health-shell")
                    yield Button("Review fetch repairs…", id="health-fetch")
                with VerticalScroll(id="health-results"):
                    yield Static("Choose Run checks to inspect your setup.", id="health-output", markup=False)
            with TabPane("Help", id="help"):
                yield Input(placeholder="Search help… · Enter to filter · empty search restores the guide", id="help-search")
                yield MarkdownViewer(HELP, id="help-viewer", show_table_of_contents=True)
        yield Static(self.activity_text, id="activity", markup=False)
        yield Static("a stage · u unstage · x stop tracking · e/E edit · c commit · p push · ? help · Ctrl+P commands", id="hints")

    async def on_mount(self) -> None:
        for key, action in self.settings.keybindings.items():
            if action not in ACTION_MAP:
                self.notify(f"Unknown keybinding action: {action}", severity="warning")
            else:
                self.bind(key, f"dispatch('{action}')")
        tree = self.query_one("#files", Tree)
        tree.show_root = False
        tree.auto_expand = False
        tree.root.expand()
        self.nodes[self.settings.home] = tree.root
        self.loaded.add(self.settings.home)
        self.query_one("#tree-box").border_title = "Home / file tree"
        self.query_one("#preview-box").border_title = "Preview"
        self.query_one("#preview-box").border_subtitle = "d content / diffs · e edit · E built-in"
        self.query_one("#changes-table", DataTable).add_columns("Index", "Disk", "Path", "Owners")
        self._activity_widget = self.query_one("#activity", Static)
        self.set_interval(self.settings.refresh_seconds, self.refresh_status)
        self.set_interval(0.12, self.tick)
        self.refresh_status()
        tree.focus()

    def command_entries(self) -> list[tuple[str, str, str]]:
        entries = [(a.name, a.title, a.description) for a in ACTIONS]
        custom = (self.settings.commands.keys() | self.repo.profile.commands.keys()) - DEFAULT_COMMANDS.keys()
        entries += [("custom:" + name, "Git: " + name, "Configured command · review before running") for name in sorted(custom)]
        entries += [("recipe:" + name, "Recipe: " + name, "Configured sequence · stops on failure") for name in sorted(self.settings.recipes)]
        return entries

    def check_action(self, action: str, parameters: tuple[object, ...]) -> bool | None:
        if action == "dispatch":
            if isinstance(self.screen, ModalScreen):
                return False
            if isinstance(self.focused, (Input, TextArea, Select)) and parameters != ("shortcuts",):
                # Browser keys must never eat text input or operate through a selector.
                return False
        return True

    def action_dispatch(self, name: str) -> None:
        self.dispatch(name)

    def dispatch(self, name: str) -> None:
        if name.startswith(("custom:", "recipe:")):
            self.run_custom(name)
            return
        method = getattr(self, "action_" + name, None)
        if method:
            method()

    @on(Button.Pressed)
    def button_pressed(self, event: Button.Pressed) -> None:
        button = event.button
        if button.has_class("setup-open"):
            self.open_setup(button.name or self.repo_name)
        elif button.id == "theme-button":
            self.action_theme()
        elif button.id and button.id.startswith(("do-", "changes-")):
            self.dispatch(button.id.partition("-")[2])
        elif button.id == "health-run":
            self.action_health()
        elif button.id == "health-shell":
            self.action_repair_shell()
        elif button.id == "health-fetch":
            self.repair_fetch()

    @on(Select.Changed, "#repo-select")
    def repository_changed(self, event: Select.Changed) -> None:
        if event.value is Select.BLANK or str(event.value) == self.repo_name:
            return
        if self.busy:
            self.query_one("#repo-select", Select).value = self.repo_name
            self.notify("Finish the current operation before switching repository", severity="warning")
            return
        self.repo_name = str(event.value)
        self._last_changes = self._last_preview = None
        self.marked.clear()
        self.refresh_status()

    @on(Select.Changed, "#scope-filter")
    def scope_changed(self, event: Select.Changed) -> None:
        if event.value is not Select.BLANK:
            self.scope_filter = str(event.value)
            self.sync_tree()

    @on(Checkbox.Changed, "#show-hidden")
    def hidden_changed(self, event: Checkbox.Changed) -> None:
        self.show_hidden = event.value
        self.sync_tree()

    @on(Input.Changed, "#path-filter")
    def filter_changed(self, event: Input.Changed) -> None:
        self.filter_text = event.value.casefold()
        self.sync_tree()

    @on(Input.Submitted, "#path-filter")
    def filter_submitted(self) -> None:
        self.query_one("#files", Tree).focus()

    @on(Input.Submitted, "#help-search")
    async def help_search(self, event: Input.Submitted) -> None:
        needle = event.value.casefold().strip()
        sections = re.split(r"(?=^## )", HELP, flags=re.M)
        text = "\n\n".join(section for section in sections if needle in section.casefold()) if needle else HELP
        await self.query_one("#help-viewer", MarkdownViewer).document.update(text or "# No matches\nTry a different help search.")

    @on(TabbedContent.TabActivated, "#workspace")
    def tab_activated(self, event: TabbedContent.TabActivated) -> None:
        if event.pane.id == "health" and not self.findings:
            self.action_health()

    def tick(self) -> None:
        self.frame += 1
        if self.busy:
            frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏" if self.settings.glyphs and self.settings.animation else "·"
            text = f"{frames[self.frame % len(frames)]} {self.activity_text}"
        else:
            text = self.activity_text
        if self._activity_widget is not None and self._activity_widget.is_mounted:
            self._activity_widget.update(text)

    @work(group="refresh")
    async def refresh_status(self) -> None:
        if self.refreshing or self.busy:
            return
        self.refreshing = True
        try:
            for repo in list(self.repositories.values()):
                try:
                    await asyncio.to_thread(repo.refresh)
                except (OSError, DotError) as error:
                    repo.snapshot = Snapshot(error=str(error))
            if self._first_refresh:
                self._first_refresh = False
                available = [name for name, repo in self.repositories.items() if not repo.snapshot.error]
                if not available:
                    self.set_focus(None)
                    self.query_one("#workspace", TabbedContent).active = "setup"
                    self.call_after_refresh(self.focus_setup)
                elif not self._explicit_repo and self.repo.snapshot.error:
                    self.repo_name = available[0]
                    self.query_one("#repo-select", Select).value = self.repo_name
            snapshot = self.repo.snapshot
            status = f"{self.repo_name}  /  {snapshot.branch}  ·  {len(snapshot.tracked)} tracked  ·  {len(snapshot.statuses)} changed"
            status += f"  ·  {snapshot.upstream} {snapshot.ahead}" if snapshot.upstream else "  ·  local / no upstream"
            if snapshot.error:
                status = snapshot.error
            self.query_one("#statusbar", Static).update(status)
            self.query_one("#changes-title", Static).update(f"{self.repo_name} · {len(snapshot.statuses)} changed paths")
            self.update_changes()
            self.sync_tree()
            self.preview_selected(debounce=True)
        finally:
            self.refreshing = False

    def focus_setup(self) -> None:
        self.query_one("#workspace", TabbedContent).active = "setup"
        self.query_one(".setup-open", Button).focus()

    def action_refresh(self) -> None:
        self._last_preview = None
        self.refresh_status()

    def owners(self, relative: str, directory: bool = False) -> list[str]:
        return [name for name, repo in self.repositories.items()
                if relative in repo.snapshot.tracked or relative in repo.snapshot.statuses
                or directory and any(p.startswith(relative + "/") for p in repo.snapshot.tracked | repo.snapshot.statuses.keys())]

    def label_for(self, path: Path) -> Text:
        relative = str(path.relative_to(self.settings.home))
        directory = path.is_dir() and not path.is_symlink() or any(
            p.startswith(relative + "/") for repo in self.repositories.values() for p in repo.snapshot.tracked | repo.snapshot.statuses.keys())
        owners = self.owners(relative, directory)
        statuses = [s for p, s in self.repo.snapshot.statuses.items() if p == relative or directory and p.startswith(relative + "/")]
        tracked = self.repo_name in owners
        conflict = any("U" in s or s in {"AA", "DD"} for s in statuses)
        changed = bool(statuses)
        colour = self.palette["red" if conflict else "yellow" if changed else "green"] if tracked or changed else self.palette["text"]
        symbol = "!" if conflict else "~" if changed else "+" if tracked else " "
        # Tree already renders the expand/collapse arrow for directories.
        icon = "" if directory else "↗" if path.is_symlink() else "·"
        if not self.settings.glyphs:
            icon = "" if directory else "@" if path.is_symlink() else " "
        marked = "* " if path in self.marked else ""
        prefix = f"{icon} " if icon else ""
        text = Text(f"{marked}{prefix}{display_path(path.name)} ", style=colour)
        if not os.path.lexists(path):
            text.append(" -", style=self.palette["red"])
        else:
            text.append(f" {symbol}", style=colour)
        if owners:
            badges = "/".join({"dotfiles": "S", "dotlocal": "L"}.get(n, n) for n in owners)
            text.append(f" [{badges}]", style=self.palette["muted"])
        return text

    def list_children(self, path: Path) -> list[tuple[Path, bool]]:
        items: dict[Path, bool] = {}
        if path.is_symlink():
            return []
        try:
            with os.scandir(path) as entries:
                for entry in entries:
                    child = Path(entry.path)
                    if self.repo.protected(child):
                        continue
                    items[child] = entry.is_dir(follow_symlinks=False)
                    if len(items) >= 10_000:
                        break
        except (OSError, PermissionError):
            pass
        prefix = "" if path == self.settings.home else str(path.relative_to(self.settings.home)) + "/"
        known = set().union(*(r.snapshot.tracked | r.snapshot.statuses.keys() for r in self.repositories.values()))
        for name in known:
            if name.startswith(prefix):
                tail = name[len(prefix):]
                first = tail.split("/", 1)[0]
                if first:
                    child = path / first
                    items.setdefault(child, "/" in tail)
        visible = []
        searchable = known | {str(p.relative_to(self.settings.home)) for p in list(self.nodes)}
        for child, directory in items.items():
            relative = str(child.relative_to(self.settings.home))
            if not self.show_hidden and child.name.startswith("."):
                continue
            if self.filter_text and self.filter_text not in relative.casefold() and not any(p.startswith(relative + "/") and self.filter_text in p.casefold() for p in searchable):
                continue
            if self.scope_filter != "all":
                candidates = self.repo.snapshot.tracked | self.repo.snapshot.statuses.keys() if self.scope_filter == "tracked" else self.repo.snapshot.statuses.keys()
                if not any(p == relative or directory and p.startswith(relative + "/") for p in candidates):
                    continue
            visible.append((child, directory))
        return sorted(visible, key=lambda item: (not item[1], item[0].name.casefold()))

    @work(exclusive=True, group="tree")
    async def sync_tree(self) -> None:
        for path in sorted(list(self.loaded), key=lambda p: len(p.parts)):
            node = self.nodes.get(path)
            if node is None:
                continue
            children = await asyncio.to_thread(self.list_children, path)
            present = {p for p, _ in children}
            for child in list(node.children):
                if child.data not in present:
                    removed = child.data
                    child.remove()
                    for cached in list(self.nodes):
                        if cached == removed or removed in cached.parents:
                            self.nodes.pop(cached, None)
                            self.loaded.discard(cached)
            existing = {child.data: child for child in node.children}
            for index, (childpath, directory) in enumerate(children):
                if childpath in existing:
                    existing[childpath].set_label(self.label_for(childpath))
                    existing[childpath].allow_expand = directory
                else:
                    child = node.add(self.label_for(childpath), data=childpath, allow_expand=directory, before=index)
                    self.nodes[childpath] = child

    @on(Tree.NodeExpanded, "#files")
    def node_expanded(self, event: Tree.NodeExpanded) -> None:
        if event.node.data:
            self.loaded.add(event.node.data)
            self.sync_tree()

    @on(Tree.NodeHighlighted, "#files")
    def node_highlighted(self) -> None:
        self.preview_selected(debounce=True)

    @on(Tree.NodeSelected, "#files")
    def node_selected(self, event: Tree.NodeSelected) -> None:
        if event.node.allow_expand:
            event.node.toggle()
        self.preview_selected()

    def selected_paths(self, use_marked: bool = True) -> list[Path]:
        if use_marked and self.marked:
            return sorted(self.marked)
        workspace = self.query_one("#workspace", TabbedContent)
        if workspace.active == "changes":
            table = self.query_one("#changes-table", DataTable)
            if table.row_count:
                key = table.coordinate_to_cell_key(table.cursor_coordinate).row_key.value
                return [self.settings.home / str(key)]
        node = self.query_one("#files", Tree).cursor_node
        return [node.data] if node and node.data and node.data != self.settings.home else []

    def update_changes(self) -> None:
        signature = (self.repo_name, tuple(sorted(self.repo.snapshot.statuses.items())), frozenset(self.marked))
        if signature == self._last_changes:
            return
        self._last_changes = signature
        table = self.query_one("#changes-table", DataTable)
        table.clear()
        for path, code in sorted(self.repo.snapshot.statuses.items()):
            table.add_row(code[0], code[1], Text(("* " if self.settings.home / path in self.marked else "") + display_path(path)), ", ".join(self.owners(path)), key=path)

    @on(DataTable.RowSelected, "#changes-table")
    def change_selected(self, event: DataTable.RowSelected) -> None:
        self.reveal_path(self.settings.home / str(event.row_key.value))

    @work(group="reveal", exclusive=True)
    async def reveal_path(self, path: Path) -> None:
        self.query_one("#workspace", TabbedContent).active = "browser"
        for parent in reversed(path.parents):
            if parent == self.settings.home or self.settings.home in parent.parents:
                self.loaded.add(parent)
        # Populate ancestors in dependency order.
        for parent in [p for p in reversed(path.parents) if p == self.settings.home or self.settings.home in p.parents]:
            node = self.nodes.get(parent)
            if node:
                node.expand()
                children = await asyncio.to_thread(self.list_children, parent)
                for childpath, directory in children:
                    if childpath not in self.nodes:
                        self.nodes[childpath] = node.add(self.label_for(childpath), data=childpath, allow_expand=directory)
        if path in self.nodes:
            tree = self.query_one("#files", Tree)
            self.call_after_refresh(tree.select_node, self.nodes[path])
            tree.focus()

    @work(exclusive=True, group="preview")
    async def preview_selected(self, *, debounce: bool = False) -> None:
        # Exclusive workers cancel the previous wait/read when the cursor moves.
        # Delay before filesystem reads, Git diffs or lexer detection begin.
        if debounce:
            await asyncio.sleep(self.settings.preview_delay)
        # A confirmation/editor can open during the delay or background read.
        # Keep targeting the browser screen beneath it, not the current modal.
        screen = self.screen_stack[0]
        tree = screen.query_one("#files", Tree)
        node = tree.cursor_node
        path = node.data if node and node.data else self.settings.home
        try:
            signature = (self.repo_name, path, self.preview_mode, self.theme, tuple(sorted(self.repo.snapshot.statuses.items())),
                         tuple((name, frozenset(repo.snapshot.tracked), tuple(repo.snapshot.statuses.items())) for name, repo in self.repositories.items()),
                         path.lstat().st_mtime_ns if os.path.lexists(path) else 0)
            if signature == self._last_preview:
                return
            content, metadata = await asyncio.to_thread(self.make_preview, path)
            self._last_preview = signature
            screen.query_one("#preview-content", Static).update(content)
            screen.query_one("#preview-meta", Static).update(metadata)
            box = screen.query_one("#preview-box")
            box.border_title = display_path(path.name) if path != self.settings.home else "Home"
            screen.query_one("#preview-scroll", VerticalScroll).scroll_home(animate=False)
            if self.settings.animation:
                screen.query_one("#preview-content").styles.opacity = 0.6
                screen.query_one("#preview-content").styles.animate("opacity", 1.0, duration=0.15)
        except (OSError, DotError) as error:
            screen.query_one("#preview-content", Static).update(Text(str(error), style=self.palette["red"]))

    def make_preview(self, path: Path) -> tuple[Any, str]:
        relative = str(path.relative_to(self.settings.home)) if path != self.settings.home else ""
        owners = ", ".join(self.owners(relative, path.is_dir())) or "untracked"
        metadata = f"{display_path(relative) or '~'} · {owners} · {self.preview_mode}"
        if path.is_symlink():
            return Text(f"Symbolic link\n\n{display_path(path.name)} → {display_path(os.readlink(path))}\n\nLinks are tracked as links. Directory links are not traversed."), metadata
        if path.is_dir():
            table = Table(expand=True, box=None, padding=(0, 1))
            table.add_column("Name", ratio=1)
            table.add_column("Size", justify="right")
            table.add_column("Owners")
            for child, directory in self.list_children(path):
                try:
                    size = "dir" if directory else f"{child.lstat().st_size:,}"
                except OSError:
                    size = "missing"
                table.add_row(self.label_for(child), size, ", ".join(self.owners(str(child.relative_to(self.settings.home)), directory)))
            return table if table.row_count else Text("Empty directory or no matching files"), metadata
        changed = relative in self.repo.snapshot.statuses
        if self.preview_mode in {"combined", "staged", "unstaged"} or self.preview_mode == "auto" and changed:
            text = self.repo.diff(relative, self.preview_mode)
            if text.strip():
                if len(text.encode()) > self.settings.preview_bytes:
                    text = text[:self.settings.preview_bytes] + "\n… diff truncated; use Git for the full patch"
                return syntax(text, "diff", self.theme, word_wrap=True), metadata
            if self.preview_mode != "auto":
                return Text("No difference in this view. Try d to switch preview mode."), metadata
        if not os.path.lexists(path):
            return Text("Tracked path is absent from disk. Stage its deletion, unstage, or inspect another diff mode."), metadata
        info = path.stat()
        if not stat.S_ISREG(info.st_mode):
            return Text(f"Special file\nMode: {stat.filemode(info.st_mode)}\nSize: {info.st_size:,} bytes\nContent is not read."), metadata
        with path.open("rb") as stream:
            raw = stream.read(self.settings.preview_bytes + 1)
        try:
            if b"\0" in raw:
                raise UnicodeError()
            decoder = codecs.getincrementaldecoder("utf-8-sig")("strict")
            text = decoder.decode(raw[:self.settings.preview_bytes], final=len(raw) <= self.settings.preview_bytes)
        except UnicodeError:
            details = (f"Binary / non-UTF-8 file\n\nSize: {info.st_size:,} bytes\nMode: {stat.filemode(info.st_mode)}\n"
                       f"Owner UID/GID: {info.st_uid}/{info.st_gid}\nModified: {datetime.fromtimestamp(info.st_mtime).isoformat(timespec='seconds')}\n"
                       f"First bytes: {raw[:32].hex(' ')}")
            return Text(details), metadata
        if len(raw) > self.settings.preview_bytes:
            text += "\n… preview truncated"
        lexer = preview_lexer(path, text)
        return syntax(text, lexer, self.theme, line_numbers=True, word_wrap=False, indent_guides=True), metadata + f" · {lexer} · {info.st_size:,} bytes"

    @contextlib.asynccontextmanager
    async def operation(self, title: str):
        if self.busy:
            self.notify("Another operation is already running", severity="warning")
            yield False
            return
        self.busy, self.activity_text = True, title
        try:
            yield True
        except (DotError, OSError, ValueError, subprocess.SubprocessError) as error:
            self.activity_text = f"Failed: {error}"
            self.notify(str(error), severity="error", timeout=12)
        finally:
            self.busy = False
            self._last_preview = None
            self.refresh_status()

    async def confirm(self, title: str, body: Any, accept: str = "Apply", dangerous: bool = False) -> bool:
        return bool(await self.push_screen_wait(ReviewDialog(title, body, accept, dangerous=dangerous)))

    def require_repo(self) -> Repository:
        if self.repo.snapshot.error:
            raise DotError("Configure this repository in Setup first")
        return self.repo

    @work(group="operations")
    async def file_action(self, action: str) -> None:
        async with self.operation(action.capitalize() + " selected files") as ready:
            if not ready:
                return
            repo = self.require_repo()
            await asyncio.to_thread(repo.refresh)
            paths = await asyncio.to_thread(repo.expand_selection, self.selected_paths(), tracked_only=action != "stage")
            if not paths:
                raise DotError("Select matching files first")
            descriptions = {"stage": "Add current content to the index (force-add ignored files).",
                            "unstage": "Restore index entries from HEAD; leave files on disk unchanged.",
                            "untrack": "Stop tracking in this repository; keep files on disk. Commit the removal afterwards."}
            body = descriptions[action] + f"\n\nRepository: {repo.name}\n{len(paths)} path(s):\n\n" + "\n".join(display_path(p) for p in paths)
            if await self.confirm(action.capitalize(), body, action.capitalize(), action == "untrack"):
                result = await asyncio.to_thread(repo.apply, action, paths)
                self.marked.clear()
                self.activity_text = f"{action.capitalize()}: {len(paths)} path(s) · {result.text or 'done'}"
                self.notify(f"{action.capitalize()}: {len(paths)} path(s)")
            else:
                self.activity_text = "Cancelled · no changes applied"

    def action_stage(self) -> None:
        self.file_action("stage")

    def action_unstage(self) -> None:
        self.file_action("unstage")

    def action_untrack(self) -> None:
        self.file_action("untrack")

    @work(group="operations")
    async def action_trash(self) -> None:
        async with self.operation("Move files to trash") as ready:
            if not ready:
                return
            selected = self.selected_paths()
            if not selected:
                raise DotError("Select files first")
            # Collapse child selections when a parent directory is also marked.
            selected = [p for p in selected if not any(parent in selected for parent in p.parents)]
            body = "Move these disk paths to system trash. Tracked deletions are not staged automatically.\n"
            for path in selected:
                relative = self.repo.relative(path)
                if self.repo.protected(path) or path == self.settings.home:
                    raise DotError("Repository metadata and the home root are protected")
                if path.is_dir() and any(Path(profile.git_dir) == path or path in Path(profile.git_dir).parents for profile in self.settings.repositories.values()):
                    raise DotError("This directory contains repository metadata")
                if not os.path.lexists(path):
                    raise DotError("A selected path is already absent from disk")
                body += f"\n{display_path(relative)}  ·  owners: {', '.join(self.owners(relative, path.is_dir())) or 'none'}"
            if await self.confirm("Trash files", body, "Move to trash", True):
                for path in selected:
                    await asyncio.to_thread(send2trash, str(path))
                self.marked.clear()
                self.activity_text = f"Moved {len(selected)} item(s) to trash"
            else:
                self.activity_text = "Trash cancelled"

    @work(group="operations")
    async def action_move(self) -> None:
        async with self.operation("Move repository tracking") as ready:
            if not ready:
                return
            repo = self.require_repo()
            others = [name for name in self.repositories if name != repo.name]
            if not others:
                raise DotError("Configure a second repository first")
            targetname = others[0]
            if len(others) > 1:
                answer = await self.push_screen_wait(FormDialog("Destination repository", [("target", "Profile name: " + ", ".join(others), targetname)]))
                if answer is None:
                    return
                targetname = answer["target"]
                if targetname not in others:
                    raise DotError("Choose a different configured repository")
            paths = await asyncio.to_thread(repo.expand_selection, self.selected_paths(), tracked_only=True)
            body = f"Stage current disk content in {targetname}, then remove tracking in {repo.name}.\nFiles stay in place. Commit each repository separately.\n\n" + "\n".join(display_path(p) for p in paths)
            if await self.confirm("Move tracking", body, "Move tracking"):
                await asyncio.to_thread(transfer_tracking, repo, self.repositories[targetname], paths)
                self.marked.clear()
                self.activity_text = f"Tracking staged: {repo.name} → {targetname}; commit both repositories separately"

    def foreground(self, repo: Repository, action: str, values: dict[str, Any]) -> None:
        argv = repo.argv(action, **values)
        if self.is_headless:
            repo.run(action, timeout=300, **values)
            return
        with self.suspend():
            console = Console()
            console.print(f"\n[bold cyan]{repo.name} · {action}[/bold cyan]")
            console.print(Text(shlex.join(argv), style="dim"))
            with repo.lock:
                result = subprocess.run(argv, env=repo.environment(), cwd=repo.home)
            try:
                input("\nPress Enter to return to the workbench… ")
            except (EOFError, KeyboardInterrupt):
                pass
        if result.returncode:
            raise DotError(f"Git {action} failed (exit {result.returncode}); see terminal output. Signing was not changed.")

    async def push_values(self, repo: Repository) -> tuple[str, dict[str, str]] | None:
        upstream = await asyncio.to_thread(repo.run, "upstream", check=False)
        if upstream.returncode == 0:
            return "push", {}
        remotes = (await asyncio.to_thread(repo.run, "remotes")).text.splitlines()
        if not remotes:
            raise DotError("No remote configured; add one through Setup (Create) or a configured Git action")
        branch = (await asyncio.to_thread(repo.run, "branch", check=False)).text
        if not branch:
            raise DotError("Cannot establish upstream from detached HEAD")
        configured_remote = await asyncio.to_thread(repo.config, f"branch.{branch}.remote")
        configured_merge = await asyncio.to_thread(repo.config, f"branch.{branch}.merge")
        if configured_remote in remotes and configured_merge:
            # A bare repo can have a valid push upstream before a fetch ref exists.
            return "push", {}
        result = await self.push_screen_wait(FormDialog("First push · establish upstream", [
            ("remote", "Remote: " + ", ".join(remotes), "origin" if "origin" in remotes else remotes[0]),
            ("branch", "Local branch to publish", branch)], "Push sets upstream tracking for the selected local branch."))
        if result is None:
            return None
        if result["remote"] not in remotes or not result["branch"] or result["branch"].startswith("-"):
            raise DotError("Choose an existing remote and a valid branch name")
        return "push_upstream", result

    def action_commit(self) -> None:
        self.commit_workflow(False)

    def action_commit_push(self) -> None:
        self.commit_workflow(True)

    @work(group="operations")
    async def commit_workflow(self, push: bool) -> None:
        async with self.operation("Review commit" + (" and push" if push else "")) as ready:
            if not ready:
                return
            repo = self.require_repo()
            await asyncio.to_thread(repo.refresh)
            scope = (await asyncio.to_thread(repo.run, "commit_preview", check=False)).text
            if not repo.snapshot.statuses:
                raise DotError("No changes to commit. Use Push to publish existing commits.")
            action = "diff_combined" if await asyncio.to_thread(repo.has_head) else "diff_staged"
            patch = (await asyncio.to_thread(repo.run, action, paths=[])).text[:self.settings.preview_bytes]
            signature = await asyncio.to_thread(repo.review_token)
            answer = await self.push_screen_wait(CommitDialog(repo, scope, patch, push))
            if answer is None:
                self.activity_text = "Commit cancelled"
                return
            message, staged, push = answer
            await asyncio.to_thread(repo.refresh)
            if await asyncio.to_thread(repo.review_token) != signature:
                current_scope = (await asyncio.to_thread(repo.run, "commit_preview", check=False)).text
                current_patch = (await asyncio.to_thread(repo.run, "diff_staged" if staged or not repo.has_head() else "diff_combined", paths=[])).text[:self.settings.preview_bytes]
                if not await self.confirm("Changes updated during review", Group(Text("Files or staged content changed while composing. Review the updated commit.\n\n" + current_scope), syntax(current_patch, "diff", self.theme, word_wrap=True)), "Commit updated changes"):
                    return
            self.activity_text = "Committing…"
            self.foreground(repo, "commit_staged" if staged else "commit", {"message": message})
            self.activity_text = "Commit recorded locally"
            if push:
                self.notify("Commit recorded locally; preparing push")
                values = await self.push_values(repo)
                if values:
                    try:
                        self.foreground(repo, values[0], values[1])
                        self.activity_text = "Committed and pushed"
                    except DotError as error:
                        raise DotError(f"Commit saved locally; push failed. {error}") from error

    @work(group="operations")
    async def action_push(self) -> None:
        async with self.operation("Push commits") as ready:
            if not ready:
                return
            repo = self.require_repo()
            values = await self.push_values(repo)
            if values and await self.confirm("Push commits", f"Publish commits from {repo.name}.\n\n" + shlex.join(repo.argv(values[0], **values[1])), "Push"):
                self.foreground(repo, values[0], values[1])
                self.activity_text = "Push completed"

    @work(group="operations")
    async def remote_workflow(self, action: str) -> None:
        async with self.operation(action.capitalize() + " remote changes") as ready:
            if not ready:
                return
            repo = self.require_repo()
            values = {}
            if action == "fetch":
                remotes = (await asyncio.to_thread(repo.run, "remotes")).text.splitlines()
                if not remotes:
                    raise DotError("No remote configured")
                answer = await self.push_screen_wait(FormDialog("Fetch remote", [("remote", "Remote: " + ", ".join(remotes), "origin" if "origin" in remotes else remotes[0])]))
                if answer is None:
                    return
                if answer["remote"] not in remotes:
                    raise DotError("Choose an existing remote")
                values = answer
            else:
                if not await self.confirm("Pull · fast-forward only", "Update tracked files from the upstream branch. Git will refuse divergence and unsafe overwrites.\n\n" + shlex.join(repo.argv("pull")), "Pull"):
                    return
            self.foreground(repo, action, values)
            self.activity_text = f"{action.capitalize()} completed"

    def action_fetch(self) -> None:
        self.remote_workflow("fetch")

    def action_pull(self) -> None:
        self.remote_workflow("pull")

    def action_edit(self) -> None:
        self.edit_workflow(False)

    def action_builtin_edit(self) -> None:
        self.edit_workflow(True)

    @work(group="operations")
    async def edit_workflow(self, builtin: bool) -> None:
        async with self.operation("Edit file") as ready:
            if not ready:
                return
            paths = self.selected_paths()
            if len(paths) != 1:
                raise DotError("Select one text file to edit")
            path = paths[0]
            self.repo.relative(path)
            if path.is_symlink() or not path.is_file() or self.repo.protected(path):
                raise DotError("Select a regular file inside home")
            editor = self.settings.editor or shlex.split(os.environ.get("EDITOR", ""))
            if editor and not builtin:
                if self.is_headless:
                    raise DotError("External editors require an interactive terminal")
                with self.suspend():
                    result = subprocess.run(editor + [str(path)], cwd=self.settings.home)
                if result.returncode:
                    raise DotError(f"Editor exited with status {result.returncode}")
            else:
                document = await asyncio.to_thread(FileDocument.read, path, self.settings.preview_bytes)
                await self.push_screen_wait(EditorScreen(document))
            self.activity_text = f"Editor closed · {display_path(path.name)}"

    def action_setup(self) -> None:
        self.open_setup(self.repo_name)

    @work(group="operations")
    async def open_setup(self, name: str) -> None:
        async with self.operation("Set up " + name) as ready:
            if not ready:
                return
            request = await self.push_screen_wait(SetupDialog(self.settings, name))
            if request is None:
                return
            prepared = None
            try:
                self.activity_text = "Preparing repository and checkout review…"
                if request.mode == "clone":
                    prepared = prepare_setup(self.settings, request, self.foreground)
                else:
                    prepared = await asyncio.to_thread(prepare_setup, self.settings, request)
                body = (f"Workflow: {request.mode}\nProfile: {name}\nRepository: {request.git_dir}\nWork tree: {self.settings.home}\n"
                        f"Configuration: {self.filename}\n\n")
                if request.mode == "attach":
                    body += "Attach only: no checkout and no repository configuration changes.\n"
                else:
                    body += "Install repository-local ignore-all rules. No automatic commit or push.\n"
                if prepared.paths:
                    body += f"\nCheckout: {len(prepared.paths)} paths\n" + "\n".join(display_path(p) for p in prepared.paths)
                    body += f"\n\nBack up and replace {len(prepared.collisions)} collision(s):\n" + "\n".join(display_path(p) for p in prepared.collisions)
                    overlaps = [(p, self.owners(p)) for p in prepared.paths if self.owners(p)]
                    if overlaps:
                        body += "\n\nAlready tracked by existing repositories:\n" + "\n".join(f"{display_path(p)} · {', '.join(owners)}" for p, owners in overlaps)
                if await self.confirm("Review setup", body, "Apply setup", bool(prepared.collisions)):
                    repo, backup = await asyncio.to_thread(apply_setup, self.settings, self.filename, prepared)
                    self.repositories[name] = repo
                    self.query_one(f"#setup-path-{list(self.repositories).index(name)}", Static).update(display_path(repo.git_dir))
                    self.activity_text = f"{name} ready" + (f" · backups: {backup}" if backup else "")
                    self.notify(self.activity_text, timeout=12)
                else:
                    self.activity_text = "Setup cancelled · home files unchanged"
            finally:
                if prepared:
                    prepared.cleanup()

    def action_health(self) -> None:
        self.query_one("#workspace", TabbedContent).active = "health"
        self.run_health()

    @work(group="health", exclusive=True)
    async def run_health(self) -> None:
        try:
            self.findings = await asyncio.to_thread(diagnose, self.settings)
            table = Table(expand=True, box=None)
            table.add_column("State", width=9)
            table.add_column("Area", width=19)
            table.add_column("Finding", ratio=1)
            for finding in self.findings:
                colour = self.palette[{"ok": "green", "info": "blue", "warning": "yellow", "error": "red"}[finding.level]]
                table.add_row(Text(finding.level.upper(), style=colour), Text(finding.subject), Text(finding.detail))
            self.query_one("#health-output", Static).update(table)
        except (OSError, DotError) as error:
            self.query_one("#health-output", Static).update(str(error))

    @work(group="operations")
    async def action_repair_shell(self) -> None:
        async with self.operation("Review zsh integration") as ready:
            if not ready:
                return
            proposal = await asyncio.to_thread(shell_repair, self.settings)
            target, before, after = proposal
            patch = "".join(difflib.unified_diff(before.splitlines(True), after.splitlines(True), fromfile=str(target), tofile=str(target)))
            if not patch:
                self.notify("Managed shell integration is already up to date")
                return
            body = Group(Text(f"Back up and update {target}. Startup files will not be executed.\nOpen a new shell after applying.\n"),
                         syntax(patch, "diff", self.theme, word_wrap=True))
            if await self.confirm("Review shell repair", body, "Back up & apply"):
                backup = await asyncio.to_thread(apply_shell_repair, self.settings, proposal)
                self.activity_text = "Shell integration updated" + (f" · backup: {backup}" if backup else "")
                self.run_health()

    @work(group="operations")
    async def repair_fetch(self) -> None:
        async with self.operation("Review fetch configuration") as ready:
            if not ready:
                return
            findings = await asyncio.to_thread(diagnose, self.settings)
            repairs = [f.repair.split(":", 2)[1:] for f in findings if f.repair.startswith("fetch:")]
            if not repairs:
                self.notify("No missing fetch refspecs found")
                return
            body = "Add these repository-local fetch refspecs (no network access):\n\n" + "\n".join(f"{name}: remote.{remote}.fetch = +refs/heads/*:refs/remotes/{remote}/*" for name, remote in repairs)
            if await self.confirm("Repair fetch configuration", body, "Apply"):
                for name, remote in repairs:
                    backup = xdg_dir("state", self.settings.home) / APP_NAME / "backups" / stamp() / f"{name}-git-config"
                    await asyncio.to_thread(atomic_write, backup, (self.repositories[name].git_dir / "config").read_bytes())
                    await asyncio.to_thread(self.repositories[name].run, "set_config", key=f"remote.{remote}.fetch", value=f"+refs/heads/*:refs/remotes/{remote}/*")
                self.activity_text = "Fetch configuration repaired"
                self.run_health()

    @work(group="operations")
    async def action_save(self) -> None:
        async with self.operation("Save preferences") as ready:
            if not ready:
                return
            self.settings.theme = "latte" if self.theme == "latte" else "macchiato"
            content = settings_toml(self.settings)
            if await self.confirm("Save preferences", Group(Text(f"Write {self.filename}\nExisting configuration will be backed up.\n"), syntax(content, "toml", self.theme, word_wrap=True)), "Save"):
                if self.filename.exists():
                    backup = xdg_dir("state", self.settings.home) / APP_NAME / "backups" / stamp() / "config.toml"
                    await asyncio.to_thread(atomic_write, backup, self.filename.read_bytes())
                await asyncio.to_thread(atomic_write, self.filename, content.encode())
                self.activity_text = "Preferences saved"

    @work(group="operations")
    async def run_custom(self, entry: str) -> None:
        async with self.operation("Configured Git operation") as ready:
            if not ready:
                return
            repo = self.require_repo()
            kind, name = entry.split(":", 1)
            steps = self.settings.recipes[name] if kind == "recipe" else [name]
            values: dict[str, Any] = {"paths": [repo.relative(p) for p in self.selected_paths()]}
            needed = set()
            for step in steps:
                needed.update(re.findall(r"(?<!@)\{([a-z_]+)\}", " ".join(repo.recipe(step))))
            needed -= {"paths", "git_dir", "home", "repo", "branch", "remote"}
            if needed:
                answer = await self.push_screen_wait(FormDialog(name, [(key, key.replace("_", " ").title(), "") for key in sorted(needed)]))
                if answer is None:
                    return
                values.update(answer)
            commands = "\n\n".join(shlex.join(repo.argv(step, **values)) for step in steps)
            if await self.confirm("Run configured Git operation", commands, "Run"):
                completed = []
                try:
                    for step in steps:
                        self.foreground(repo, step, values)
                        completed.append(step)
                except DotError as error:
                    raise DotError(f"Completed: {', '.join(completed) or 'none'}. {error}") from error
                self.activity_text = f"Completed: {', '.join(completed)}"

    def action_theme(self) -> None:
        self.theme = "latte" if self.theme == "macchiato" else "macchiato"
        self.query_one("#theme-button", Button).label = "☀ Latte" if self.theme == "macchiato" else "☾ Dark"
        self._last_preview = None
        self.sync_tree()
        self.preview_selected()
        if self.findings:
            self.run_health()

    def action_panes(self) -> None:
        self.pane_mode = (self.pane_mode + 1) % 3
        tree, preview = self.query_one("#tree-box"), self.query_one("#preview-box")
        tree.set_class(self.pane_mode == 2, "hidden")
        preview.set_class(self.pane_mode == 1, "hidden")
        tree.styles.width = "1fr" if self.pane_mode == 1 else "36%"

    def action_mark(self) -> None:
        selected = self.selected_paths(use_marked=False)
        if selected:
            path = selected[0]
            if path in self.marked:
                self.marked.remove(path)
            else:
                self.marked.add(path)
            if path in self.nodes:
                self.nodes[path].set_label(self.label_for(path))
            self.update_changes()
            self.activity_text = f"{len(self.marked)} item(s) marked" if self.marked else "Selection cleared"

    def action_preview(self) -> None:
        modes = ["auto", "content", "combined", "staged", "unstaged"]
        self.preview_mode = modes[(modes.index(self.preview_mode) + 1) % len(modes)]
        self.preview_selected()

    def action_filter(self) -> None:
        self.query_one("#workspace", TabbedContent).active = "browser"
        self.query_one("#path-filter", Input).focus()

    def action_help(self) -> None:
        self.query_one("#workspace", TabbedContent).active = "help"

    def action_shortcuts(self) -> None:
        overrides = {action: key for key, action in self.settings.keybindings.items()}
        text = "# Workbench shortcuts\n\n| Key | Action |\n| --- | --- |\n" + "\n".join(f"| {overrides.get(a.name, a.key) or 'Command palette'} | {a.title} |" for a in ACTIONS)
        self.push_screen(TextDialog("Shortcut reference", text))

    @work(group="readme", exclusive=True)
    async def action_local_readme(self) -> None:
        try:
            path = self.settings.home / "README.md"
            if path.stat().st_size > self.settings.preview_bytes:
                raise DotError("README exceeds preview limit")
            text = await asyncio.to_thread(path.read_text)
            self.push_screen(TextDialog("Local dotfiles README", text))
        except (OSError, DotError, UnicodeError) as error:
            self.notify(str(error), severity="error")

    def action_quit(self) -> None:
        if self.busy:
            self.notify("Finish or cancel the current operation before quitting", severity="warning")
        else:
            self.exit()


cli = typer.Typer(invoke_without_command=True, no_args_is_help=False, help="A Catppuccin workbench for home-directory Git dotfiles.")
config_cli = typer.Typer(help="Inspect and validate application configuration.")
cli.add_typer(config_cli, name="config")


@cli.callback()
def main(ctx: typer.Context,
         config: Path | None = typer.Option(None, "--config", "-c", help="TOML configuration file"),
         repo: str | None = typer.Option(None, "--repo", "-r", help="Initial repository profile"),
         home: Path | None = typer.Option(None, "--home", help="Isolated home work tree (for testing / portable homes)"),
         version: bool = typer.Option(False, "--version", help="Show version")) -> None:
    if version:
        typer.echo(VERSION)
        raise typer.Exit()
    filename = config or config_path(home)
    try:
        settings = load_settings(filename, home)
        ctx.obj = (settings, filename)
        if ctx.invoked_subcommand is None:
            DotfilesApp(settings, filename, repo).run()
    except DotError as error:
        typer.echo(str(error), err=True)
        raise typer.Exit(2) from error


@cli.command()
def doctor(ctx: typer.Context, json_output: bool = typer.Option(False, "--json", help="Machine-readable findings")) -> None:
    """Check local repositories and shell integration without changing anything."""
    settings, _ = ctx.obj
    try:
        findings = diagnose(settings)
        if json_output:
            from dataclasses import asdict
            typer.echo(json.dumps([asdict(f) for f in findings], indent=2))
        else:
            table = Table(title="Dotfiles health", show_lines=True)
            for col in ("State", "Area", "Finding"):
                table.add_column(col)
            for finding in findings:
                table.add_row(finding.level, finding.subject, Text(finding.detail))
            Console().print(table)
        if any(f.level == "error" for f in findings):
            raise typer.Exit(1)
    except (DotError, OSError) as error:
        typer.echo(str(error), err=True)
        raise typer.Exit(2) from error


@config_cli.command("show")
def show_config(ctx: typer.Context, commands: bool = typer.Option(False, "--commands", help="Include all default Git command recipes")) -> None:
    """Print effective configuration without writing it."""
    settings, _ = ctx.obj
    effective = settings.model_copy(deep=True)
    if commands:
        effective.commands = DEFAULT_COMMANDS | effective.commands
    typer.echo(settings_toml(effective))


@config_cli.command("example")
def config_example() -> None:
    """Print an annotated starter configuration."""
    typer.echo(example_settings())


@config_cli.command("validate")
def validate_config(ctx: typer.Context) -> None:
    """Validate TOML, settings and machine-readable command contracts."""
    settings, filename = ctx.obj
    invalid = set(settings.keybindings.values()) - ACTION_MAP.keys()
    if invalid:
        typer.echo("Unknown keybinding actions: " + ", ".join(sorted(invalid)), err=True)
        raise typer.Exit(2)
    typer.echo(f"Valid: {filename}" + (" (defaults / discovery; file does not exist)" if not filename.exists() else ""))


if __name__ == "__main__":
    cli()
