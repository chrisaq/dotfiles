#!/usr/bin/env bash
#:desc: WireGuard + systemd-networkd + routing diagnosis and reachability checks
#:usage: cq_wg_check [iface...] [--verbose]
#:no-args: false
set -euo pipefail

cq_config_file() {  # prints config file path; empty = use defaults
  local app="wg-check" ext="sh" base f
  if [[ -n "${CQ_WG_CHECK_CONFIG:-}" ]]; then
    f="$CQ_WG_CHECK_CONFIG"
    [[ -d "$f" || ( ! "$f" == *.* && ! -f "$f" ) ]] && f="$f/config.$ext"
    [[ -f "$f" ]] || { echo "cq_wg_check: config not found: $f" >&2; return 1; }
    printf '%s\n' "$f"; return 0
  fi
  base="${CQ_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cq}"
  for f in "$base/$app/config.$ext" "$base/$app.$ext"; do
    [[ -f "$f" ]] && { printf '%s\n' "$f"; return 0; }
  done
  return 0  # empty: defaults
}
if ! cq_cfg=$(cq_config_file); then exit 1; fi
if [[ -n "$cq_cfg" ]]; then
  # shellcheck source=/dev/null
  source "$cq_cfg"
fi

args=(check --ping-count "${PING_COUNT:-1}" --ping-timeout "${PING_TIMEOUT:-1}")
read -r -a targets <<< "${TARGETS:-${TARGETS_DEFAULT:-}}"
for target in "${targets[@]}"; do
    args+=(--target "$target")
done
if (( EUID == 0 )); then
    exec /usr/local/libexec/cq-wg "${args[@]}" "$@"
fi
exec sudo /usr/local/libexec/cq-wg "${args[@]}" "$@"
