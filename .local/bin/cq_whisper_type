#!/usr/bin/env bash
#:usage: cq_whisper_type toggle|start|stop
#:no-args: false
#:desc: Record speech and type a Whisper transcription into the focused application.

set -euo pipefail

endpoint='https://whisper.k8s.int.kotelett.no/inference'
runtime_dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
state_dir="$runtime_dir/cq-whisper-type"
mkdir -p "$state_dir"
chmod 700 "$state_dir"
pid_file="$state_dir/recorder.pid"
audio_file="$state_dir/recording.wav"
language_file="$state_dir/language"

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send -a 'Whisper input' "$1" "$2"
}

case "${1:-}" in
    toggle)
        if [[ -s "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
            exec "$0" stop
        fi
        exec "$0" start
        ;;
    start)
        if [[ -s "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
            exit 0
        fi
        language=auto
        source=$(pactl get-default-source)
        if [[ -z "$source" ]]; then
            notify 'No PipeWire default input' 'Set a default input source in PipeWire, then try again.'
            exit 1
        fi
        if [[ $(pactl get-source-mute "$source") == *yes* ]]; then
            notify 'PipeWire default input is muted' 'Unmute it in pavucontrol, then tap Super+V to record.'
            exit 1
        fi
        source_label=$(pactl -f json list sources | jq -r --arg name "$source" '.[] | select(.name == $name) | .description' | head -n 1)
        source_label=${source_label:-Microphone}
        printf '%s\n' "$language" > "$language_file"
        rm -f "$audio_file"
        nohup pw-record --target "$source" --rate 16000 --channels 1 --format s16 "$audio_file" \
            >/dev/null 2>&1 </dev/null &
        printf '%s\n' "$!" > "$pid_file"
        notify 'Listening' "$source_label · language $language; tap Super+V again to transcribe"
        ;;
    stop)
        [[ -s "$pid_file" ]] || exit 0
        pid=$(<"$pid_file")
        rm -f "$pid_file"
        trap 'rm -f "$audio_file" "$language_file"' EXIT
        if ! kill -0 "$pid" 2>/dev/null; then
            notify 'Recording failed' 'The audio recorder stopped unexpectedly.'
            exit 1
        fi
        kill -INT "$pid"
        for _ in {1..40}; do
            state=$(ps -o stat= -p "$pid" 2>/dev/null || true)
            [[ -z "$state" || "$state" == Z* ]] && break
            sleep 0.05
        done
        state=$(ps -o stat= -p "$pid" 2>/dev/null || true)
        if [[ -n "$state" && "$state" != Z* ]]; then
            kill "$pid" 2>/dev/null || true
            notify 'Recording failed' 'The audio recorder did not stop cleanly.'
            exit 1
        fi
        [[ -s "$audio_file" ]] || { notify 'No audio' 'No recording was captured.'; exit 1; }
        language=$(<"$language_file")
        audio_level=$(python3 -c 'import array, math, sys, wave; w=wave.open(sys.argv[1], "rb"); samples=array.array("h"); samples.frombytes(w.readframes(w.getnframes())); peak=max((abs(x) for x in samples), default=0); rms=math.sqrt(sum(x*x for x in samples)/max(len(samples), 1)); db=lambda x: "-inf" if x == 0 else f"{20*math.log10(x/32768):.1f} dBFS"; print(f"RMS {db(rms)}, peak {db(peak)}")' "$audio_file")
        if ! response=$(curl --fail --silent --show-error --max-time 90 "$endpoint" \
            -F "file=@$audio_file" -F "language=$language" -F 'response_format=json' 2>&1); then
            notify 'Whisper request failed' "$response"
            exit 1
        fi
        transcript=$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("text", "").strip())' <<<"$response") || {
            notify 'Whisper response error' 'The server returned invalid JSON.'
            exit 1
        }
        if [[ -n "$transcript" ]]; then
            wtype -- "$transcript"
            notify 'Transcribed' "$transcript"
        else
            notify 'No speech detected' "Whisper returned an empty transcript ($language; $audio_level)."
        fi
        ;;
    *)
        echo "Usage: $0 toggle|start|stop" >&2
        exit 2
        ;;
esac
