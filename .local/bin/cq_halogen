#!/usr/bin/env bash
#:desc: manage the Halogen Flash Server Podman container
#:usage: cq_halogen {start|stop|restart|update|upgrade VERSION|logs|status}
#:no-args: false
set -euo pipefail

IMAGE_REPO="ghcr.io/peonist-ai/halogen-flash-server"
IMAGE_VERSION="0.18.4"
IMAGE="$IMAGE_REPO:$IMAGE_VERSION"
NAME="halogen"
MODELS="/srv/halogen/models"
PORT="8731"

# --- NPU -------------------------------------------------------------------
# Comma list of small models to serve on the Ryzen AI NPU, beside the Flash
# model. Set to "" to disable the NPU entirely; the container is then built
# exactly as before this feature.
#
# Available: decider-0.8b, qwen3-embedding-0.6b, qwen3-reranker-0.6b,
#            qwen3guard-gen-0.6b, qwen3.5-2b
# Opt-in larger sizes: decider-4b, qwen3-embedding-4b, qwen3-reranker-4b
# Images on the NPU:   flux2-klein-4b (adds about 8 GiB resident)
# Multimodal embeddings (text+picture+audio, 768-dim): embeddinggemma-2
#   needs image 0.18.3 or newer, adds about 1.1 GiB resident.
NPU_MODELS="decider-0.8b,qwen3-embedding-0.6b,qwen3-reranker-0.6b,embeddinggemma-2"

# Rootless NPU serving also needs an unlimited host memlock hard limit.
# See /srv/halogen/halogen-memlock.conf and NPU-STARTUP-FIX.md.

# Where the distro installed XRT.
#   Arch / CachyOS:  /usr/lib
#   Ubuntu:          /usr/lib/x86_64-linux-gnu
XRT_LIBDIR="/usr/lib"

# 1 = accept images. Costs about 2 GiB of RAM, and roughly 5.5 / 11.8 / 25.3
# seconds per 1280x800 / 1920x1080 / 2560x1440 image; a 1080p frame also
# occupies about 2040 tokens of the context.
VISION=1

# Set DRYRUN=1 to print the podman command instead of running it.
DRYRUN="${DRYRUN:-}"
# ---------------------------------------------------------------------------

show_help() {
  cat <<EOF
Usage: cq_halogen COMMAND

Manage the Halogen Flash Server Podman container.

Configured image:
  $IMAGE

Configured model directory:
  $MODELS

Commands:
  start
      Start Halogen using the newest version of the image present on this
      machine; if none is present, the configured version is pulled.

  stop
      Stop the running Halogen container.

  restart
      Stop and start Halogen using the currently configured IMAGE.

  update
      Pull the configured IMAGE and recreate the Halogen container.

      The model files in $MODELS are preserved because they are stored
      outside the container and mounted at /models.

  upgrade VERSION
      Pull VERSION of the image (e.g. 'cq_halogen upgrade 0.19.0') and
      recreate the container with it. Because 'start' always uses the newest
      version present on this machine, the new version is then used by
      'start' and 'restart' too. The model files in $MODELS are preserved as
      with 'update'.

  logs
      Follow the Halogen container logs.

  status
      Show the Halogen container status.

  health
      Query the Halogen health endpoint at:
        http://127.0.0.1:$PORT/health

  help
      Show this help.

NPU:
  The small NPU models are listed in NPU_MODELS above. Set it to "" to
  start without the NPU. The host needs XRT with its NPU plugin
  (pacman -S xrt xrt-plugin-amdxdna) and the GPU fabric clock held at its
  top speed, which rootless podman cannot do itself:

    sudo systemctl enable --now halogen-fabric-clock.service
    /usr/local/sbin/halogen-fabric-clock status

  The first start with the NPU enabled fetches the named models into
  $MODELS/npu, so that mount is read-write; once they are there you can
  drop HALOGEN_DOWNLOAD and mount it read-only again.

Images:
  Set VISION=1 to load the vision sidecar (HALOGEN_VISION_TOWER=1).

Testing:
  DRYRUN=1 cq_halogen start
      Print the podman command without running it.
EOF
}

# The container needs three XRT libraries from the host. A distribution's XRT
# keeps them in the system library directory and they look for each other
# there, so each one is mounted twice: into the image's XRT path, and at its
# own path. Appends into the global array XRT_ARGS.
XRT_ARGS=()
xrt_mounts() {
  local f real
  for f in libxrt_coreutil.so.2 libxrt_core.so.2 libxrt_driver_xdna.so.2; do
    real=$(readlink -f "$XRT_LIBDIR/$f" 2>/dev/null || true)
    if [[ -z "$real" || ! -f "$real" ]]; then
      echo "XRT: $f not found under $XRT_LIBDIR" >&2
      echo "     install it: sudo pacman -S xrt xrt-plugin-amdxdna" >&2
      return 1
    fi
    # The ${f} braces matter: under zsh an unbraced "$f:ro" is parsed as the
    # :r history modifier and silently mangles the path.
    XRT_ARGS+=(
      --volume "$real:/opt/xilinx/xrt/lib/${f}:ro"
      --volume "$real:${XRT_LIBDIR}/${f}:ro"
    )
  done
}

# Check before stopping a working server for restart/update. Podman's
# --ulimit cannot raise the hard limit inherited from the host login.
check_npu_memlock() {
  [[ -z "$NPU_MODELS" || -n "$DRYRUN" ]] && return 0
  local hard
  hard=$(ulimit -H -l)
  if [[ "$hard" != unlimited ]]; then
    echo "NPU: host memlock hard limit is $hard KiB; unlimited is required by this launcher." >&2
    echo "Install /srv/halogen/halogen-memlock.conf under /etc/security/limits.d/, then log out and back in." >&2
    echo "See /srv/halogen/NPU-STARTUP-FIX.md. No container was stopped." >&2
    return 1
  fi
}
# Newest numeric tag of IMAGE_REPO present in the local image store, empty
# if none. 'latest' and dangling tags are ignored; sort -V orders versions.
newest_local_version() {
  podman images --format '{{.Repository}} {{.Tag}}' 2>/dev/null \
    | awk -v r="$IMAGE_REPO" '$1 == r && $2 ~ /^[0-9]/ { print $2 }' \
    | sort -V | tail -n1
}

do_start() {
  check_npu_memlock || return 1

  if podman container exists "$NAME"; then
    echo "Container '$NAME' already exists." >&2
    echo "Use: cq_halogen restart" >&2
    return 1
  fi

  local -a args=(
    run -d --rm
    --name "$NAME"
    --publish "$PORT:$PORT"
    --device /dev/kfd
    --device /dev/dri
    --group-add keep-groups
    --ipc=host
    --ulimit memlock=-1:-1
  )

  if [[ -n "$NPU_MODELS" ]]; then
    xrt_mounts || return 1
    args+=( "${XRT_ARGS[@]}" )
    args+=( --device /dev/accel/accel0 )
    args+=( --env "HALOGEN_NPU_MODELS=$NPU_MODELS" )
    # Fetches the NPU models named above into /models/npu and checks each
    # one's size and checksum. Needs a writable /models.
    args+=( --env "HALOGEN_DOWNLOAD=peonist-ai/halogen-qwen3.8-flash-next" )
    args+=( --volume "$MODELS:/models" )
  else
    # No download needed, so keep the volume read-only.
    args+=( --volume "$MODELS:/models:ro" )
  fi

  if [[ "$VISION" = "1" ]]; then
    args+=( --env "HALOGEN_VISION_TOWER=1" )
  fi

  local image
  if [[ -n "${HALOGEN_IMAGE_VERSION:-}" ]]; then
    image="$IMAGE_REPO:$HALOGEN_IMAGE_VERSION"
  else
    image=$(newest_local_version)
    image="${image:+$IMAGE_REPO:$image}"
    image="${image:-$IMAGE}"
  fi
  echo "Starting $image"
  args+=( "$image" )

  if [[ -n "$DRYRUN" ]]; then
    printf 'podman'
    printf ' %q' "${args[@]}"
    printf '\n'
    return 0
  fi

  podman "${args[@]}"
}

case "${1:-}" in
  start)
    do_start
    ;;

  stop)
    if podman container exists "$NAME"; then
      podman stop "$NAME"
    else
      echo "Container '$NAME' is not running."
    fi
    ;;

  restart)
    check_npu_memlock || exit 1
    if podman container exists "$NAME"; then
      podman stop "$NAME"
    fi

    "$0" start
    ;;

  update)
    check_npu_memlock || exit 1
    cat <<EOF
Updating Halogen using:

  $IMAGE

This command only pulls the version configured in cq_halogen.

To upgrade to a newer release without editing this script:

  cq_halogen upgrade VERSION

EOF

    podman pull "$IMAGE"

    if podman container exists "$NAME"; then
      podman stop "$NAME"
    fi

    "$0" start
    ;;

  upgrade)
    version="${2:-}"
    if [[ -z "$version" ]]; then
      echo "Usage: cq_halogen upgrade VERSION   (e.g. cq_halogen upgrade 0.19.0)" >&2
      exit 1
    fi
    if [[ ! "$version" =~ ^[0-9][0-9a-zA-Z.]*$ ]]; then
      echo "Invalid version: $version" >&2
      exit 1
    fi

    # Warn on downgrade against the newest version on this machine (falling
    # back to the configured version if nothing is pulled yet).
    current=$(newest_local_version)
    current="${current:-$IMAGE_VERSION}"
    if [[ "$version" != "$current" ]] &&
       [[ "$(printf '%s\n%s\n' "$version" "$current" | sort -V | head -n1)" = "$version" ]]; then
      echo "WARNING: $version is older than the newest local version $current." >&2
      read -r -p "Downgrade anyway? [y/N] " reply
      [[ "$reply" = "y" || "$reply" = "Y" ]] || exit 1
    fi

    check_npu_memlock || exit 1

    new_image="$IMAGE_REPO:$version"
    echo "Upgrading Halogen to: $new_image"
    podman pull "$new_image"

    if podman container exists "$NAME"; then
      podman stop "$NAME"
    fi

    HALOGEN_IMAGE_VERSION="$version" "$0" start
    ;;

  logs)
    podman logs -f "$NAME"
    ;;

  status)
    podman ps -a --filter "name=$NAME"
    ;;

  health)
    health_rc=0
    health_body=$(curl --noproxy '*' --connect-timeout 3 --max-time 15 \
      --fail-with-body -sS "http://127.0.0.1:$PORT/health") || health_rc=$?
    if [[ -n "$health_body" ]]; then
      format_rc=0
      printf '%s' "$health_body" | python3 -c '
import json, sys
try:
    body = json.load(sys.stdin)
except ValueError as exc:
    print(f"health: invalid JSON response: {exc}", file=sys.stderr)
    sys.exit(65)
print(json.dumps(body, indent=2, ensure_ascii=False))
if not isinstance(body, dict) or body.get("status") != "ok":
    print("health: server did not report status ok", file=sys.stderr)
    sys.exit(1)
' || format_rc=$?
      if [[ "$health_rc" = 0 ]]; then health_rc=$format_rc; fi
    elif [[ "$health_rc" = 0 ]]; then
      echo "health: empty response" >&2
      health_rc=65
    fi
    exit "$health_rc"
    ;;

  help|-h|--help)
    show_help
    ;;

  "")
    show_help
    ;;

  *)
    echo "Unknown command: $1" >&2
    echo >&2
    show_help >&2
    exit 1
    ;;
esac
