#!/bin/bash
#:usage: cq_pass-add
#:no-args: true
#:desc: Create a new gopass entry via rofi prompts.

shopt -s nullglob globstar

cq_config_file() {  # prints config file path; empty = use defaults
  local app="pass-add" ext="sh" base f
  if [[ -n "${CQ_PASS_ADD_CONFIG:-}" ]]; then
    f="$CQ_PASS_ADD_CONFIG"
    [[ -d "$f" || ( ! "$f" == *.* && ! -f "$f" ) ]] && f="$f/config.$ext"
    [[ -f "$f" ]] || { echo "cq_pass-add: config not found: $f" >&2; return 1; }
    printf '%s\n' "$f"; return 0
  fi
  base="${CQ_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/cq}"
  for f in "$base/$app/config.$ext" "$base/$app.$ext"; do
    [[ -f "$f" ]] && { printf '%s\n' "$f"; return 0; }
  done
  return 0  # empty: defaults
}
if ! cq_cfg=$(cq_config_file); then exit 1; fi
if [[ -n "$cq_cfg" ]]; then
  # shellcheck source=/dev/null
  source "$cq_cfg"
fi

pexit() {
    echo "$1"
    exit 1
}

run_gopass_insert() {
    local entry=$1

    if [[ ${TERM_PROGRAM:-} == ghostty ]]; then
        gopass insert "$entry"
    else
        ghostty -e gopass insert "$entry"
    fi
}

STORE=${PASSWORD_STORE_DIR:-$HOME/Sync/Password-Store}

FOLDER=$(
    find "$STORE" -type d -not -path '*/\.*' -printf "%d %P\n" |
        sort -n |
        cut -d ' ' -f2- |
        rofi -dmenu -i -p Folder
)
[[ -n $FOLDER ]] || pexit "no folder"

DOMAIN=$(rofi -dmenu -p Domain)
[[ -n $DOMAIN ]] || pexit "no domain"

USER=$(rofi -dmenu -p User/email)
[[ -n $USER ]] || pexit "no user"

PPASS="${FOLDER}/${DOMAIN}/${USER}"

OK=$(printf 'yes\nno\n' | rofi -dmenu -p "Create ${PPASS} ?")

if [[ $OK == yes ]]; then
    echo "insert $PPASS"
    run_gopass_insert "$PPASS"
else
    echo "no insert"
fi
