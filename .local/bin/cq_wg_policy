#!/usr/bin/env bash
#:desc: inspect WireGuard policy or restore automatic tunnel selection
#:usage: cq_wg_policy {status|auto|up|down}
#:no-args: true
set -euo pipefail

case "${1:-status}" in
    status) exec /usr/local/libexec/cq-wg status ;;
    auto|up) exec sudo /usr/local/libexec/cq-wg auto ;;
    down) exec sudo /usr/local/libexec/cq-wg off ;;
    *) echo "Usage: cq_wg_policy {status|auto|up|down}" >&2; exit 2 ;;
esac
